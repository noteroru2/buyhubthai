---
interface Props {
  heading?: string;
  intro?: string;
  links: { href: string; label: string }[];
}

const {
  heading = 'หมวดรับซื้อที่เกี่ยวข้อง',
  intro = 'ถ้าคุณพร้อมประเมินราคา สามารถไปต่อที่หน้าบริการหลักที่ตรงกับสินค้าได้เลย',
  links
} = Astro.props;
---

{
  links.length ? (
    <section class="mt-10 rounded-2xl border border-slate-200 bg-slate-50/80 px-5 py-6 sm:px-6">
      <h2 class="text-lg font-bold tracking-tight text-slate-950">{heading}</h2>
      <p class="mt-2 text-sm leading-7 text-slate-600">{intro}</p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex text-sm font-medium text-emerald-800 underline decoration-emerald-300/80 underline-offset-2 transition hover:text-emerald-950"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
