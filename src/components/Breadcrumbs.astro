---
import type { BreadcrumbItem } from '../lib/types';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-slate-200/80 bg-white">
  <div class="mx-auto min-w-0 max-w-7xl px-4 py-3.5 sm:px-6 lg:px-8">
    <ol class="flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1 break-words text-sm text-slate-600">
      {
        items.map((item, i) => (
          <li class="flex items-center gap-1">
            {i > 0 ? <span class="text-slate-400" aria-hidden="true">/</span> : null}
            {i === items.length - 1 ? (
              <span class="font-medium text-slate-950" aria-current="page">
                {item.name}
              </span>
            ) : (
              <a href={item.href} class="transition hover:text-emerald-700">
                {item.name}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>
