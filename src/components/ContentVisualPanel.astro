---
interface GalleryItem {
  src: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  imageSrc?: string;
  imageAlt?: string;
  gallery?: GalleryItem[];
  points?: string[];
  reverse?: boolean;
}

const {
  eyebrow = 'Guide',
  title,
  body,
  imageSrc = '',
  imageAlt = '',
  gallery = [],
  points = [],
  reverse = false
} = Astro.props;
---

<section class="mt-12 overflow-hidden rounded-3xl border border-slate-200 bg-slate-50/80">
  <div class="grid min-w-0 lg:grid-cols-[1.05fr_.95fr]">
    <div class:list={['min-w-0 p-6 sm:p-8', reverse && 'lg:order-2']}>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">{eyebrow}</p>
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">{title}</h2>
      <p class="mt-4 text-base leading-8 text-slate-700">{body}</p>
      {
        points.length ? (
          <ul class="mt-6 grid gap-2 text-sm leading-7 text-slate-700 sm:grid-cols-2">
            {points.map((point) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>

    <div
      class:list={[
        'min-w-0 border-t border-slate-200 bg-white/80 p-4 sm:p-6 lg:border-l lg:border-t-0',
        reverse && 'lg:order-1 lg:border-l-0 lg:border-r'
      ]}
    >
      {
        gallery.length ? (
          <div class="grid gap-3 sm:grid-cols-2">
            {gallery.map((item) => (
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class="block aspect-[4/3] w-full rounded-2xl border border-slate-200 bg-white object-cover"
              />
            ))}
          </div>
        ) : (
          <img
            src={imageSrc}
            alt={imageAlt}
            loading="lazy"
            decoding="async"
            class="block w-full rounded-2xl border border-slate-200 bg-white"
          />
        )
      }
    </div>
  </div>
</section>
