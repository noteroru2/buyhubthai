---
import { getRecoveryAuthorityLinks } from '../lib/recovery-policy.mjs';

const links = getRecoveryAuthorityLinks(Astro.url.pathname);
---

{links.length > 0 && (
  <section
    data-buyhub-recovery="v1"
    class="border-y border-slate-200 bg-slate-50/80 py-10"
    aria-labelledby="buyhub-recovery-links"
  >
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700">BuyHub · Related buyback services</p>
        <h2 id="buyhub-recovery-links" class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
          หน้ารับซื้อและพื้นที่ที่เกี่ยวข้อง
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          เลือกหน้าที่ตรงกับสินค้าและพื้นที่จริง เพื่อดูข้อมูลที่ใช้ประเมินก่อนส่งรูปเช็กราคา
        </p>
      </div>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="flex h-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-900 shadow-sm transition hover:border-emerald-300 hover:text-emerald-800"
            >
              <span>{link.label}</span>
              <span aria-hidden="true" class="ml-3 text-emerald-700">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
