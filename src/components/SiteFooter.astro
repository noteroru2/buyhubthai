---
import { NAV, LINE_URL, LINE_AT, PHONE_E164, PHONE_DISPLAY, FACEBOOK_URL, BUSINESS_HOURS_SHORT, PARENT_ORG_NAME } from '../lib/constants';
import { featuredServices } from '../data/serviceCatalog';
---
<footer class="bh-footer"><div class="bh-wrap">
  <div class="bh-footer-grid"><div><a class="bh-footer-logo" href="/">buy<span>hub</span></a><p>ขายไอทีง่าย รู้ราคาก่อนตัดสินใจ</p><p>ช่องทางรับซื้อสินค้าไอทีในเครืออำพล เทรดดิ้ง สำหรับผู้ขายเครื่องส่วนตัว ร้านค้า และบริษัท</p><p>ดำเนินการโดย {PARENT_ORG_NAME}</p></div>
  <div><h2>สำรวจ BuyHub</h2><ul>{NAV.map(item => <li><a href={item.href}>{item.label}</a></li>)}<li><a href="/เกี่ยวกับเรา">เกี่ยวกับเรา</a></li><li><a href="/พื้นที่ให้บริการ">พื้นที่ให้บริการ</a></li></ul></div>
  <div><h2>สินค้าที่รับซื้อ</h2><ul>{featuredServices.map(item => <li><a href={item.href}>รับซื้อ{item.name}</a></li>)}<li><a href="/รับซื้อ">ดูบริการทั้งหมด →</a></li></ul></div>
  <div><h2>ติดต่อทีมงาน</h2><ul><li><a href={LINE_URL} target="_blank" rel="noopener noreferrer">LINE {LINE_AT} ↗</a></li><li><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></li><li><a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">Facebook BuyHub ↗</a></li><li><a href="/ติดต่อเรา">ที่อยู่และการเดินทาง</a></li></ul><p>เวลาติดต่อออนไลน์<br/>{BUSINESS_HOURS_SHORT}</p><p>โปรดนัดหมายก่อนเข้าร้านหรือจัดส่งสินค้า</p></div></div>
  <div class="bh-footer-bottom"><p>© {new Date().getFullYear()} BuyHub</p><div><a href="/นโยบายความเป็นส่วนตัว">ความเป็นส่วนตัว</a><a href="/เงื่อนไขการใช้บริการ">เงื่อนไขบริการ</a></div></div>
</div></footer>
