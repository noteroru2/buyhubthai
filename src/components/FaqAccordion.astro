---
import { LINE_URL } from '../lib/constants';

interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: readonly Item[] | Item[];
  id?: string;
  heading?: string;
  intro?: string;
}

const {
  items,
  id = 'faq-section',
  heading = 'คำถามที่พบบ่อย',
  intro = 'คำตอบโดยสรุปจากแนวทางรับซื้อของ BuyHub หากต้องการประเมินเคสจริง'
} = Astro.props;
---

<section class="border-t border-slate-200 bg-white py-14 sm:py-20" aria-labelledby={id}>
  <div
    class="pointer-events-none h-px w-full bg-gradient-to-r from-transparent via-emerald-500/35 to-transparent"
    aria-hidden="true"
  />
  <div class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-14">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-600">FAQ</p>
      <h2 id={id} class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:mt-3 sm:text-3xl md:text-4xl">
        {heading}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:mt-4 sm:text-base">
        {intro}{' '}
        <a
          href={LINE_URL}
          class="font-semibold text-emerald-700 underline decoration-emerald-500/40 underline-offset-2 hover:text-emerald-600"
          target="_blank"
          rel="noopener noreferrer"
        >
          แอด LINE @buyhub
        </a>
      </p>
    </div>
    <div class="mx-auto mt-8 max-w-3xl space-y-2 sm:mt-12 sm:space-y-3">
      {
        items.map((item) => (
          <details class="group rounded-xl border border-slate-200 bg-white shadow-sm transition-all duration-200 open:border-emerald-500/30 open:shadow-md hover:border-slate-300 sm:rounded-2xl sm:open:shadow-lg sm:hover:shadow-md">
            <summary class="flex cursor-pointer list-none items-start gap-2.5 px-4 py-3.5 marker:content-none sm:gap-3 sm:px-6 sm:py-5 [&::-webkit-details-marker]:hidden">
              <span
                class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-buyhub-surface text-[0.65rem] font-bold text-amber-300/95 ring-1 ring-amber-400/20 sm:h-8 sm:w-8 sm:rounded-xl sm:text-xs sm:ring-amber-400/25"
                aria-hidden="true"
              >
                ?
              </span>
              <span class="flex-1 text-left text-sm font-semibold leading-snug text-slate-950 sm:text-base">
                {item.question}
              </span>
              <span
                class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-slate-600 sm:mt-1 sm:h-8 sm:w-8 sm:rounded-lg"
                aria-hidden="true"
              >
                <span class="text-base font-light leading-none group-open:hidden sm:text-lg">+</span>
                <span class="hidden text-base font-light leading-none group-open:inline sm:text-lg">-</span>
              </span>
            </summary>
            <div class="border-t border-slate-100 px-4 pb-4 pt-3 sm:px-6 sm:pb-5 sm:pt-4">
              <p class="text-sm leading-relaxed text-slate-600">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
