          ประเมินราคาเบื้องต้นได้เร็วขึ้น
        </p>
      </header>

      <div class="mt-8 space-y-4 text-base leading-8 text-slate-700">
        {intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <!-- ตารางประเมินราคาตามเกณฑ์สภาพสินค้า (GEO & AEO Schema Integration) -->
      <section class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/50 p-5 sm:p-6" aria-labelledby="grade-table-heading">
