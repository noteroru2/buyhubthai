    };
  }

  if (name.includes('กล้อง')) {
    return {
      itemLabel: 'ตัวกล้อง',
      evaluationFields: 'ยี่ห้อ รุ่น จำนวนชัตเตอร์ สภาพเลนส์ เซนเซอร์ แบตเตอรี่ และอุปกรณ์ที่มี',
      issueExamples: 'โฟกัสช้า เซนเซอร์มีฝุ่น จอพับหลวม หรือปุ่มบางตัวมีปัญหา',
      bundleExamples: 'เลนส์ แบตสำรอง ที่ชาร์จ สายคล้อง หรือกล่อง'
    };
  }

  if (name.includes('การ์ดจอ')) {
    return {
      itemLabel: 'ตัวการ์ด',
