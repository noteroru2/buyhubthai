---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyhubCta from './BuyhubCta.astro';
import SellingSteps from './SellingSteps.astro';
import FaqAccordion from './FaqAccordion.astro';
import { breadcrumbJsonLd, faqPageJsonLd, serviceJsonLd } from '../lib/schema';
import { LINE_URL } from '../lib/constants';
import { serviceGroups } from '../data/serviceCatalog';
import { isRecoverySuppressedPath } from '../lib/recovery-policy.mjs';
import type { BreadcrumbItem } from '../lib/types';
interface Props {
  path: string; title: string; description: string; h1: string; serviceName: string;
  breadcrumbs: BreadcrumbItem[]; provinceName: string; productName: string;
  intro: readonly string[]; areas: readonly string[]; whatWeBuy: readonly string[];
  pricingFactors: readonly string[]; howToSend: readonly string[];
  internalLinks: readonly { href: string; label: string }[];
  faqs: readonly { question: string; answer: string }[];
  longContentSections?: readonly unknown[];
  customVisual?: { imageSrc: string; imageAlt: string; ogImage: string; };
  robots?: string; canonical?: string;
}
const { path, title, description, h1, serviceName, breadcrumbs, provinceName, productName, intro, areas, whatWeBuy, pricingFactors, howToSend, internalLinks, faqs, customVisual, robots, canonical } = Astro.props;
const itemName = productName.replace(/^รับซื้อ\s*/, '');
const catalog = serviceGroups.flatMap(group => [...group.items]);
const category = catalog.find(item => item.href === path);
const image = customVisual?.imageSrc ?? (category && 'image' in category ? `/images/buyback/${category.image}` : undefined);
const links = internalLinks.filter((item, i, all) => item.href !== path && !isRecoverySuppressedPath(item.href) && all.findIndex(other => other.href === item.href) === i).slice(0, 8);
// The source pages own their product details. Do not append keyword matrices or generated longform.
const jsonLd = [breadcrumbJsonLd(breadcrumbs), serviceJsonLd({ name: serviceName, description, url: path, areas: [...areas] }), faqPageJsonLd([...faqs])];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} canonical={canonical} robots={robots} ogImage={customVisual?.ogImage ?? image} jsonLd={jsonLd}>
  <section class="bh-page-head"><div class:list={['bh-wrap', image && 'bh-service-hero']}><div><p class="bh-eyebrow">BUYHUB · บริการรับซื้อ</p><h1>{h1}</h1><p>{description}</p><div class="bh-actions"><a class="bh-button" href={LINE_URL} target="_blank" rel="noopener noreferrer">ส่งรูปเช็กราคา ↗</a><a class="bh-text-link" href="#send-details">ต้องส่งข้อมูลอะไรบ้าง ↓</a></div></div>{image && <img src={image} alt={customVisual?.imageAlt ?? `ภาพ${productName}ประกอบข้อมูลรับซื้อ`} width="800" height="600" fetchpriority="high"/>}</div></section>
  <div class="bh-content bh-wrap bh-reading-grid"><article>
    <section><h2>ขาย{itemName}กับ BuyHub</h2>{intro.slice(0, 2).map(text => <p>{text}</p>)}</section>
    <section id="accepted-items"><h2>สินค้าที่ส่งให้พิจารณาได้</h2><ul class="bh-check-list">{whatWeBuy.map(text => <li>{text}</li>)}</ul></section>
    <section id="pricing"><h2>ปัจจัยที่ใช้ประเมินราคา</h2><ul class="bh-check-list">{pricingFactors.map(text => <li>{text}</li>)}</ul><p>ราคาจากรูปเป็นเบื้องต้น ทีมงานจะยืนยันราคาสุดท้ายหลังตรวจสินค้าจริง หากพบรายละเอียดต่างจากที่แจ้ง จะแจ้งให้คุณพิจารณาก่อนตกลงขาย</p></section>
    <section id="send-details"><h2>ข้อมูลที่ควรส่งเพื่อเช็กราคา</h2><ul class="bh-check-list">{howToSend.map(text => <li>{text}</li>)}</ul><div class="bh-actions"><a class="bh-button" href={LINE_URL} target="_blank" rel="noopener noreferrer">ส่งข้อมูลผ่าน LINE @buyhub ↗</a></div></section>
    <section><h2>พื้นที่และการส่งมอบ</h2><p>{provinceName && !['ภาคอีสาน', 'ทั่วประเทศ'].includes(provinceName) ? `สำหรับผู้ขายใน${provinceName} กรุณาแจ้งอำเภอและจุดที่สะดวกส่งมอบพร้อมข้อมูลสินค้า ` : 'กรุณาแจ้งจังหวัดและอำเภอพร้อมข้อมูลสินค้า '}ทีมงานจะตรวจสอบวิธีเข้าร้าน นัดรับ หรือจัดส่งที่รองรับตามพื้นที่ คิวงาน จำนวน และมูลค่าสินค้า ก่อนตกลงทำรายการ</p><p>หน้าร้านหลักของผู้ดำเนินการอยู่ที่อุบลราชธานี โปรดรอยืนยันนัดหมายหรือที่อยู่จัดส่งจากทีมงานก่อนส่งสินค้า</p><a class="bh-text-link" href="/พื้นที่ให้บริการ">ดูข้อมูลพื้นที่และวิธีส่งมอบ ↗</a></section>
    <section><h2>เตรียมเครื่องก่อนขาย</h2><p>สำรองไฟล์ที่ต้องการเก็บ ออกจากบัญชีส่วนตัวและบัญชีองค์กรที่ผูกกับอุปกรณ์ ถอดอุปกรณ์เก็บข้อมูลที่ไม่ได้ขาย และตรวจว่าคุณมีสิทธิ์ส่งมอบสินค้า หากเครื่องมีอาการเสียหรือมีข้อมูลสำคัญ ให้แจ้งทีมงานก่อนทำรายการ</p><a class="bh-text-link" href="/คู่มือเตรียมสินค้าก่อนขาย">อ่านคู่มือเตรียมสินค้าก่อนขาย ↗</a></section>
    {links.length > 0 && <section><h2>บริการและคู่มือที่เกี่ยวข้อง</h2><div class="bh-link-list">{links.map(item => <a href={item.href}>{item.label} ↗</a>)}</div></section>}
  </article><aside class="bh-sidebar"><h2>เริ่มประเมินฟรี</h2><p>เตรียมรูป รุ่น สภาพ อุปกรณ์ และพื้นที่ คุณยังไม่ต้องส่งสินค้ามาก่อนรู้แนวราคา</p><a href="#accepted-items">สินค้าที่รับพิจารณา</a><a href="#pricing">ปัจจัยประเมินราคา</a><a href="#send-details">ข้อมูลที่ต้องส่ง</a><a href="/ขั้นตอนการขาย">ขั้นตอนขายกับ BuyHub</a><a class="bh-button" href={LINE_URL} target="_blank" rel="noopener noreferrer">คุยผ่าน LINE ↗</a></aside></div>
  <section class="bh-section bh-tint"><div class="bh-wrap"><div class="bh-section-heading"><div><p class="bh-eyebrow">ขั้นตอนการขาย</p><h2>คุยรายละเอียดให้ครบ ก่อนส่งมอบ</h2></div></div><SellingSteps/></div></section>
  <FaqAccordion items={faqs}/><BuyhubCta/>
</BaseLayout>
