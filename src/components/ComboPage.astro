      bundleExamples: 'กล่อง สายชาร์จ Apple Pencil หรือคีย์บอร์ด'
    };
  }

  if (name.includes('MacBook')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'รุ่น ปี ชิป RAM SSD สภาพแบต จอ คีย์บอร์ด และสถานะ Apple ID',
      issueExamples: 'แบตเสื่อม จอมีเงา คีย์บอร์ดมีปัญหา หรือพอร์ตใช้งานไม่ครบ',
      bundleExamples: 'ที่ชาร์จ กล่อง เคส หรือใบเสร็จ'
    };
  }

  if (name.includes('แท็บเล็ต')) {
    return {
      itemLabel: 'ตัวเครื่อง',
