const profileLongContentSections = buildComboEditorialSections(productName, provinceName);
const sellEditorialSections = getSellEditorialSections(sellEditorialSlug);
const allLongContentSections = [
  ...longContentSections,
  ...sellEditorialSections,
  ...profileLongContentSections,
  ...autoLongContentSections
].map((section) => ({
  ...section,
  links: section.links ? dedupeLinks(section.links) : undefined
}));

const tocItems = (() => {
  const seen = new Set<string>();

  return allLongContentSections.reduce<{ id: string; label: string }[]>((items, section) => {
    const id = makeId(section.heading);
    if (!id || seen.has(id)) {
      return items;
    }

    seen.add(id);
    items.push({ id, label: section.heading });
    return items;
  }, []);
})();

const dedupedInternalLinks = dedupeLinks(internalLinks);

const midArticleIndex =
  allLongContentSections.length > 2 ? Math.floor((allLongContentSections.length - 1) / 2) : -1;
