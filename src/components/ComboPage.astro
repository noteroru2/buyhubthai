      issueExamples: 'พัดลมดัง พอร์ตเสีย ฮีตซิงก์มีสนิม หรือเคยขุดมาก่อน',
      bundleExamples: 'กล่อง ใบเสร็จ ซองกันกระแทก หรือประกันคงเหลือ'
    };
  }

  if (name.includes('คอมเกมมิ่ง') || name.includes('คอมพิวเตอร์') || name.includes('PC')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'CPU RAM SSD การ์ดจอ สภาพตัวเครื่อง อุปกรณ์ที่มี และอาการใช้งานจริง',
      issueExamples: 'เปิดไม่ติด เข้าวินโดวส์ไม่ได้ ร้อนผิดปกติ หรือพัดลมมีเสียงดัง',
      bundleExamples: 'จอ เมาส์ คีย์บอร์ด สายไฟ หรือกล่องอะไหล่'
    };
  }

  if (name.includes('เครื่องปริ้น')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'ยี่ห้อ รุ่น ประเภทเครื่อง สภาพหัวพิมพ์ ระบบสแกน และอุปกรณ์ที่มี',
      issueExamples: 'พิมพ์ไม่ออก กระดาษติด หัวพิมพ์ตัน หรือเชื่อมต่อ Wi-Fi ไม่ได้',
      bundleExamples: 'สายไฟ หมึก ดรัม ถาดกระดาษ หรือคู่มือ'
    };
  }

  if (name.includes('เครื่องเกม')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'รุ่น ความจุ สภาพจอย อุปกรณ์ในชุด และอาการใช้งานจริง',
