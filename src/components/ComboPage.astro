<BaseLayout title={title} description={description} ogImage={productVisual.ogImage} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <article class="bg-white">
    <div class="mx-auto min-w-0 max-w-3xl px-4 py-14 sm:px-6 sm:py-16">
      <header class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          {h1}
        </h1>

        <p class="mt-4 text-lg leading-8 text-slate-600">
          {description}
        </p>

        <div class="mt-8 flex min-w-0 flex-col gap-4 border-y border-slate-100 py-8 sm:flex-row">
          <LineCtaButton variant="primary" class="sm:flex-1" />
          <PhoneCtaButton variant="light" class="sm:flex-1" />
        </div>

        <p class="mt-4 text-sm leading-7 text-slate-500">
