].map((section) => ({
  ...section,
  links: section.links ? dedupeLinks(section.links) : undefined
}));

const tocItems = (() => {
  const seen = new Set<string>();

  return allLongContentSections.reduce<{ id: string; label: string }[]>((items, section) => {
    const id = makeId(section.heading);
    if (!id || seen.has(id)) {
      return items;
    }

    seen.add(id);
    items.push({ id, label: section.heading });
    return items;
  }, []);
})();

const dedupedInternalLinks = dedupeLinks(internalLinks);

const groupedLinks = (() => {
  const relatedProducts: { href: string; label: string }[] = [];
  const serviceAreas: { href: string; label: string }[] = [];
  const articles: { href: string; label: string }[] = [];
  const portfolios: { href: string; label: string }[] = [];
  const infoAndContact: { href: string; label: string }[] = [];

  dedupedInternalLinks.forEach((link) => {
    const href = link.href.toLowerCase();
    if (href.includes('/พื้นที่ให้บริการ') || href.includes('-ขอนแก่น') || href.includes('-นครราชสีมา') || href.includes('-อุดรธานี') || href.includes('-อุบลราชธานี') || href.includes('พื้นที่ให้บริการ')) {
      serviceAreas.push(link);
    } else if (href.startsWith('/บทความ') || href.includes('คู่มือ') || href.includes('ขั้นตอนการขาย') || href.includes('คำถามที่พบบ่อย') || href.includes('เงื่อนไขการใช้บริการ') || href.includes('นโยบายความเป็นส่วนตัว')) {
      articles.push(link);
    } else if (href.startsWith('/ผลงาน') || href.startsWith('/รีวิว') || href.includes('รีวิวลูกค้า')) {
      portfolios.push(link);
    } else if ((href.startsWith('/รับซื้อ') || href.startsWith('/sell/')) && !href.includes('/พื้นที่') && !href.includes('-ขอนแก่น') && !href.includes('-นครราชสีมา') && !href.includes('-อุดรธานี') && !href.includes('-อุบลราชธานี')) {
      relatedProducts.push(link);
    } else {
      infoAndContact.push(link);
    }
  });

  return {
    relatedProducts,
    serviceAreas,
    articles,
    portfolios,
    infoAndContact
  };
})();
