      bundleExamples: 'ที่ชาร์จ จอ เมาส์ คีย์บอร์ด สายไฟ หรือไฟล์รายการทรัพย์สิน'
    };
  }

  if (name.includes('อุปกรณ์สำนักงาน')) {
    return {
      itemLabel: 'ตัวสินค้าแต่ละรายการ',
      evaluationFields: 'ประเภทสินค้า จำนวน รุ่นหลัก จำนวนพอร์ตหรือสเปก สภาพการใช้งาน และอุปกรณ์ประกอบ',
      issueExamples: 'พิมพ์ไม่ออก พอร์ต LAN เสีย UPS แบตเสื่อม หรือ Access Point ไม่ปล่อยสัญญาณ',
      bundleExamples: 'สายไฟ อะแดปเตอร์ สาย LAN ถาดกระดาษ หรืออุปกรณ์ประกอบ'
    };
  }

  if (name.includes('อุปกรณ์เสริม')) {
    return {
      itemLabel: 'ตัวสินค้า',
      evaluationFields: 'ประเภทสินค้า ยี่ห้อ รุ่น วัตต์ ความจุ จำนวนพอร์ต สภาพการใช้งาน และอุปกรณ์ที่มี',
      issueExamples: 'พอร์ตหลวม ชาร์จไม่เข้า เปิดไม่ติด หรือแบตเสื่อม',
      bundleExamples: 'กล่อง สายเดิม หัวแปลง คู่มือ หรือใบเสร็จ'
    };
  }

  if (name.includes('อุปกรณ์เกมมิ่ง')) {
    return {
      itemLabel: 'ตัวสินค้าแต่ละชิ้น',
      evaluationFields: 'ประเภทสินค้า ยี่ห้อ รุ่น สภาพปุ่ม เซ็นเซอร์ การเชื่อมต่อ และอุปกรณ์ที่มี',
      issueExamples: 'คลิกเบิล ไมค์ไม่ติด Analog drift หรือ RGB บางจุดไม่ทำงาน',
      bundleExamples: 'กล่อง สาย Dongle Receiver Keycap สำรอง หรือขาตั้ง'
    };
  }

  if (name.includes('มือถือ')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'แบรนด์ รุ่น ความจุ RAM สภาพจอ สุขภาพแบต กล้อง และสถานะบัญชี',
      issueExamples: 'จอแตก แบตเสื่อม กล้องไม่โฟกัส หรือยังติดบัญชีเดิม',
      bundleExamples: 'กล่อง สายชาร์จ หัวชาร์จ เคส หรือใบเสร็จ'
    };
  }

  if (name.includes('iPhone')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'รุ่น ความจุ Battery Health สภาพจอ กล้อง และสถานะ iCloud',
      issueExamples: 'แบตเสื่อม Face ID ใช้ไม่ได้ จอมีเส้น หรือกล้องมีปัญหา',
      bundleExamples: 'กล่อง สายชาร์จ หัวชาร์จ หรือใบเสร็จ'
    };
  }

  if (name.includes('iPad')) {
    return {
      itemLabel: 'ตัวเครื่อง',
      evaluationFields: 'รุ่นย่อย ความจุ สภาพจอ ระบบทัช พอร์ตชาร์จ และสถานะ Apple ID',
