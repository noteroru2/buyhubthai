type LongContentSection = {
  heading: string;
  paragraphs?: string[];
  content?: string[];
  list?: string[];
  orderedList?: string[];
  links?: { href: string; label: string }[];
  note?: string;
};

interface Props {
  path: string;
  title: string;
  description: string;
  h1: string;
  serviceName: string;
  breadcrumbs: BreadcrumbItem[];
  provinceName: string;
  productName: string;
  intro: string[];
  areas: string[];
  whatWeBuy: string[];
  pricingFactors: string[];
  howToSend: string[];
  internalLinks: { href: string; label: string }[];
  faqs: { question: string; answer: string }[];
  longContentSections?: LongContentSection[];
  customVisual?: { imageSrc: string; imageAlt: string; ogImage: string; };
}

const {
  path,
  title,
  description,
  h1,
  serviceName,
  breadcrumbs,
  provinceName,
  productName,
  intro,
  areas,
  whatWeBuy,
  pricingFactors,
  howToSend,
  internalLinks,
  faqs,
  longContentSections = [],
  customVisual
} = Astro.props;

const jsonLd = [
  breadcrumbJsonLd(breadcrumbs),
  serviceJsonLd({ name: serviceName, description, url: path, areas }),
  faqPageJsonLd(faqs)
];

const makeId = (text: string) =>
  text
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^\u0E00-\u0E7Fa-z0-9-]/g, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');

const normalizeLinkHref = (href: string) => {
  const trimmedHref = href.trim();
  if (trimmedHref === '/') return '/';

  return trimmedHref.endsWith('/') ? trimmedHref.slice(0, -1) : trimmedHref;
};

const dedupeLinks = (links: { href: string; label: string }[]) => {
  const seen = new Set<string>();

  return links.filter((link) => {
    const key = normalizeLinkHref(link.href);
    if (seen.has(key)) {
      return false;
    }

    seen.add(key);
    return true;
  });
};

type ProductNarrative = {
  itemLabel: string;
  evaluationFields: string;
  issueExamples: string;
  bundleExamples: string;
};

type ProductVisual = {
  imageSrc: string;
  imageAlt: string;
  ogImage: string;
};

