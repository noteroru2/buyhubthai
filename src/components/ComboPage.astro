<BaseLayout title={title} description={description} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <article class="bg-white">
    <div class="mx-auto min-w-0 max-w-3xl px-4 py-14 sm:px-6 sm:py-16">
      <header class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          {h1}
        </h1>

        <p class="mt-4 text-lg leading-8 text-slate-600">
          {description}
        </p>

        <div class="mt-8 flex min-w-0 flex-col gap-4 border-y border-slate-100 py-8 sm:flex-row">
          <LineCtaButton variant="primary" class="sm:flex-1" />
          <PhoneCtaButton variant="light" class="sm:flex-1" />
        </div>

        <p class="mt-4 text-sm leading-7 text-slate-500">
          ส่งรูปสินค้าและรายละเอียดอย่าง {productNarrative.evaluationFields} รวมถึงอำเภอหรือจุดนัดโดยประมาณ เพื่อให้ทีม BuyHub
          ประเมินราคาเบื้องต้นได้เร็วขึ้น
        </p>
      </header>

      <div class="mt-8 space-y-4 text-base leading-8 text-slate-700">
        {intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {
        tocItems.length > 0 && (
          <nav
            class="mt-10 rounded-2xl border border-slate-200 bg-slate-50/80 p-5"
            aria-labelledby="page-toc-heading"
          >
            <h2 id="page-toc-heading" class="text-lg font-bold tracking-tight text-slate-950">
              เนื้อหาในหน้านี้
            </h2>
            <ul class="mt-4 space-y-2 text-sm leading-7 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:space-y-0">
              {tocItems.map((item) => (
                <li>
                  <a class="font-medium text-emerald-700 hover:underline" href={`#${item.id}`}>
                    {item.label}
                  </a>
                </li>
              ))}
              <li>
                <a class="font-medium text-emerald-700 hover:underline" href="#combo-summary">
                  สรุปข้อมูลที่ควรส่งประเมิน
                </a>
              </li>
              <li>
                <a class="font-medium text-emerald-700 hover:underline" href="#combo-faq">
                  คำถามที่พบบ่อย
                </a>
              </li>
            </ul>
          </nav>
        )
      }

      {
        allLongContentSections.length > 0 && (
          <div class="mt-12 space-y-12">
            {allLongContentSections.map((section, index) => {
              const sectionId = makeId(section.heading);
              const paragraphs = section.paragraphs ?? section.content ?? [];

              return (
                <>
                  <section id={sectionId} aria-labelledby={`${sectionId}-heading`} class="min-w-0">
                    <h2
                      id={`${sectionId}-heading`}
                      class="text-2xl font-bold tracking-tight text-slate-950"
                    >
                      {section.heading}
                    </h2>

                    <div class="mt-5 space-y-4 text-base leading-8 text-slate-700">
                      {paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>

                    {
                      section.list && section.list.length > 0 && (
                        <ul class="mt-5 space-y-2 text-sm leading-7 text-slate-700">
                          {section.list.map((item) => (
                            <li class="flex gap-2">
                              <span class="text-emerald-600" aria-hidden="true">
                                •
                              </span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ul>
                      )
                    }

                    {
                      section.orderedList && section.orderedList.length > 0 && (
                        <ol class="mt-5 space-y-2 text-sm leading-7 text-slate-700">
                          {section.orderedList.map((item, orderedIndex) => (
                            <li class="flex gap-3">
                              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">
                                {orderedIndex + 1}
                              </span>
                              <span>{item}</span>
                            </li>
                          ))}
                        </ol>
                      )
                    }

                    {
                      section.links && section.links.length > 0 && (
                        <ul class="mt-5 grid gap-2 text-sm sm:grid-cols-2">
                          {section.links.map((link) => (
                            <li class="min-w-0">
                              <a
                                class="break-words font-semibold text-emerald-700 hover:underline"
                                href={link.href}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )
                    }

                    {
                      section.note && (
                        <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm leading-7 text-amber-900">
                          {section.note}
                        </div>
                      )
                    }
                  </section>

                  {
                    index === midArticleIndex && (
                      <aside class="rounded-3xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-white p-6 shadow-sm">
                        <p class="text-sm font-semibold text-emerald-700">
                          อยากรู้ราคาของ {productName} ใน {provinceName} ตอนนี้?
                        </p>
                        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
                          ส่งรูปให้ BuyHub ประเมินฟรีก่อนตัดสินใจขาย
                        </h2>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                          ส่งรูปและรายละเอียดอย่าง {productNarrative.evaluationFields} พร้อมอำเภอใน {provinceName}{' '}
                          ผ่าน LINE @buyhub เพื่อให้ทีมงานประเมินราคาเบื้องต้นได้เร็วขึ้น
                        </p>
                        <div class="mt-5 flex min-w-0 flex-col gap-3 sm:flex-row">
                          <LineCtaButton variant="primary" class="sm:flex-1" />
                          <PhoneCtaButton variant="light" class="sm:flex-1" />
                        </div>
                      </aside>
                    )
                  }
                </>
              );
            })}
          </div>
        )
      }

      <section
        class="mt-12 rounded-3xl border border-slate-200 bg-slate-50/80 p-6"
        id="combo-summary"
        aria-labelledby="combo-summary-heading"
      >
        <h2 id="combo-summary-heading" class="text-2xl font-bold tracking-tight text-slate-950">
          สรุปข้อมูลสำคัญสำหรับการขาย {productName} ใน {provinceName}
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          ถ้าต้องการให้ประเมินเร็วและใกล้เคียงหน้างาน แนะนำให้เตรียมข้อมูลตามเช็กลิสต์ด้านล่างก่อนทัก
          LINE @buyhub
        </p>

        <div class="mt-6 grid gap-5">
          <section aria-labelledby="combo-areas">
            <h3 id="combo-areas" class="text-lg font-bold tracking-tight text-slate-950">
              พื้นที่ใน {provinceName} ที่ส่งรูปประเมินได้
            </h3>
            <p class="mt-2 text-sm leading-7 text-slate-600">
              แจ้งอำเภอหรือจุดนัดโดยประมาณในข้อความ จะช่วยให้ทีมงานแนะนำวิธีนัดรับหรือการส่งมอบได้เหมาะกับคิวงาน
            </p>
            <ul class="mt-4 grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
              {areas.map((area) => (
                <li class="rounded-xl border border-slate-200 bg-white px-4 py-2">{area}</li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="combo-what">
            <h3 id="combo-what" class="text-lg font-bold tracking-tight text-slate-950">
              รับซื้อ {productName} แบบไหนบ้าง
            </h3>
            <ul class="mt-4 space-y-2 text-sm leading-7 text-slate-700">
              {whatWeBuy.map((item) => (
                <li class="flex gap-2">
                  <span class="text-emerald-600" aria-hidden="true">
                    •
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="combo-price">
            <h3 id="combo-price" class="text-lg font-bold tracking-tight text-slate-950">
              ปัจจัยที่ใช้ประเมินราคา {productName}
            </h3>
            <ul class="mt-4 space-y-2 text-sm leading-7 text-slate-700">
              {pricingFactors.map((item) => (
                <li class="flex gap-2">
                  <span class="text-emerald-600" aria-hidden="true">
                    •
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="combo-send">
            <h3 id="combo-send" class="text-lg font-bold tracking-tight text-slate-950">
              เช็กลิสต์ข้อมูลที่ควรส่งเพื่อประเมิน
            </h3>
            <ol class="mt-4 space-y-2 text-sm leading-7 text-slate-700">
              {howToSend.map((item, index) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white">
                    {index + 1}
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ol>
          </section>
        </div>
      </section>

      <div id="combo-faq" class="mt-12">
        <FaqAccordion
          id="combo-faq-heading"
          heading={`คำถามที่พบบ่อยเกี่ยวกับ${buyProductText} ใน ${provinceName}`}
          intro={`คำตอบสรุปสำหรับคนที่ต้องการ${sellProductText} ใน ${provinceName}`}
          items={faqs}
        />
        <div class="sr-only">
          {faqs.map((faq) => (
            <div>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <section
        class="mt-12 rounded-2xl border border-slate-200 bg-slate-50/70 p-6"
        aria-labelledby="combo-links"
      >
        <h2 id="combo-links" class="text-lg font-bold tracking-tight text-slate-950">
          ลิงก์ที่เกี่ยวข้อง
        </h2>
        <ul class="mt-4 grid gap-2 text-sm sm:grid-cols-2">
          {dedupedInternalLinks.map((link) => (
            <li class="min-w-0">
              <a class="break-words font-semibold text-emerald-700 hover:underline" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>

  <CtaBand
    heading={`${buyProductText} ใน ${provinceName} - ส่งรูปเช็กราคาได้ก่อน`}
    sub={`${sendProductText} พร้อมข้อมูลอย่าง ${productNarrative.evaluationFields} และอำเภอใน ${provinceName} ทาง LINE @buyhub เพื่อประเมินฟรีก่อนตัดสินใจขาย`}
    lineLabel={`${sendForEvaluationProductText} ทาง LINE`}
  />
</BaseLayout>
