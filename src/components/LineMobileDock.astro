---
import { LINE_URL } from '../lib/constants';
import { PHONE_DISPLAY, PHONE_E164 } from '../lib/constants';
---

<div
  class="safe-pb fixed bottom-0 left-0 right-0 z-50 border-t border-slate-200/90 bg-white/[0.98] px-3 py-3 shadow-[0_-12px_40px_-8px_rgba(7,17,31,0.14)] backdrop-blur-xl md:hidden print:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <div class="mx-auto flex w-full min-w-0 max-w-lg items-stretch gap-2.5">
    <a
      href={LINE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-[1.15] flex-col items-center justify-center gap-0.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 px-2 py-3 text-white shadow-lg shadow-emerald-500/30 transition hover:scale-[1.02] hover:from-emerald-400 hover:to-emerald-500"
      aria-label="LINE @buyhub — ประเมินราคา แตะเพื่อเปิดแอป LINE"
    >
      <span class="flex items-center gap-2 text-sm font-bold tracking-tight">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 320 320" fill="currentColor" aria-hidden="true">
          <path
            d="M280 149c0 77-81 140-181 140-36 0-69-9-97-25h-1L32 298l38-86v-1c-21-26-33-58-33-93 0-77 81-140 181-140s180 62 180 139z"
          />
        </svg>
        LINE @buyhub
      </span>
      <span class="text-xs font-semibold text-white">ประเมินราคา</span>
    </a>
    <a
      href={`tel:${PHONE_E164}`}
      class="flex flex-1 flex-col items-center justify-center gap-0.5 rounded-2xl border-2 border-slate-300 bg-white px-2 py-3 text-slate-900 shadow-md transition hover:border-slate-400 hover:bg-slate-50"
      aria-label={`โทร ${PHONE_DISPLAY}`}
    >
      <span class="flex items-center gap-1.5 text-sm font-semibold">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
            fill="currentColor"
          />
        </svg>
        โทร
      </span>
      <span class="text-xs font-semibold tabular-nums leading-tight text-slate-800">{PHONE_DISPLAY}</span>
    </a>
  </div>
</div>
