---
import { LINE_URL, NAV, SITE_NAME } from '../lib/constants';
import LineCtaButton from './LineCtaButton.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-white/10 bg-buyhub-navy/95 backdrop-blur-xl backdrop-saturate-150 transition-colors duration-300"
>
  <div class="mx-auto flex min-w-0 max-w-7xl items-center justify-between gap-3 px-4 py-3.5 sm:px-6 lg:gap-6 lg:px-8">
    <a href="/" class="group flex min-w-0 flex-1 items-center gap-3 focus-visible:outline-none md:flex-none">
      <span
        class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 text-[0.7rem] font-bold tracking-tight text-white shadow-lg shadow-emerald-500/30 ring-2 ring-white/15 transition group-hover:ring-emerald-400/35"
        aria-hidden="true"
      >
        BH
      </span>
      <span class="min-w-0 text-left">
        <span class="block truncate text-base font-bold tracking-tight text-white sm:text-lg">{SITE_NAME}</span>
        <span
          class="block truncate text-[0.7rem] font-medium uppercase tracking-wider text-slate-400 sm:text-xs"
        >
          ศูนย์รับซื้อไอที · buyhubthai.com
        </span>
      </span>
    </a>

    <nav aria-label="เมนูหลัก" class="hidden items-center gap-0.5 lg:flex lg:gap-1 xl:gap-1.5">
      {
        NAV.map(({ href, label }) => {
          const normalized = href === '/' ? '/' : href.replace(/\/$/, '');
          const active =
            normalized === '/'
              ? pathname === '/'
              : pathname === normalized || pathname.startsWith(`${normalized}/`);
          return (
            <a
              href={href}
              class:list={[
                'whitespace-nowrap rounded-xl px-3 py-2.5 text-sm font-medium transition duration-200 xl:px-3.5',
                active
                  ? 'bg-white/10 text-white shadow-inner shadow-black/25'
                  : 'text-slate-300 hover:bg-white/[0.08] hover:text-white'
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <LineCtaButton
        variant="primary"
        size="sm"
        label="ประเมินราคาฟรี"
        class="hidden shadow-emerald-500/25 sm:inline-flex"
      />
      <a
        href={LINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-lg shadow-emerald-500/30 transition hover:scale-[1.02] hover:from-emerald-400 hover:to-emerald-500 sm:hidden"
        aria-label="ประเมินราคาฟรีทาง LINE"
      >
        LINE
      </a>

      <details class="group relative lg:hidden">
        <summary
          class="list-none rounded-xl border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm font-medium text-white marker:content-none [&::-webkit-details-marker]:hidden"
          aria-expanded="false"
          aria-label="เปิดเมนูนำทาง"
        >
          เมนู
        </summary>
        <div
          class="absolute right-0 z-50 mt-2 w-[min(20rem,calc(100dvw-1.5rem))] max-w-[calc(100dvw-1.5rem)] overflow-hidden rounded-2xl border border-white/10 bg-buyhub-surface/98 p-2 shadow-2xl shadow-black/45 backdrop-blur-xl"
          role="navigation"
          aria-label="เมนูมือถือ"
        >
          {
            NAV.map(({ href, label }) => (
              <a
                href={href}
                class="block rounded-xl px-4 py-3.5 text-sm font-medium text-slate-100 transition hover:bg-white/10 hover:text-white"
              >
                {label}
              </a>
            ))
          }
          <div class="mt-2 border-t border-white/10 pt-2">
            <LineCtaButton variant="primary" size="sm" label="ประเมินราคาทาง LINE @buyhub" class="w-full justify-center" />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var el = document.getElementById('site-header');
    if (!el) return;
    var onScroll = function () {
      if (window.scrollY > 16) el.classList.add('header-scrolled');
      else el.classList.remove('header-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
