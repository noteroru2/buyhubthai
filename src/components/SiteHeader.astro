---
import { NAV, LINE_URL } from '../lib/constants';
const pathname = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '') || '/';
---
<header class="bh-header">
  <div class="bh-wrap bh-header-inner">
    <a href="/" class="bh-logo" aria-label="BuyHub หน้าแรก"><span class="bh-logo-mark" aria-hidden="true">b<span>↗</span></span><span>buy<span class="bh-logo-accent">hub</span><small>ขายไอทีง่าย รู้ราคาก่อนตัดสินใจ</small></span></a>
    <nav class="bh-nav" aria-label="เมนูหลัก">{NAV.map(item => <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>)}</nav>
    <div class="bh-header-actions"><a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="bh-button bh-button-small">ส่งรูปเช็กราคา <span aria-hidden="true">↗</span></a>
    <details class="bh-menu"><summary aria-label="เปิดเมนูนำทาง">เมนู</summary><nav aria-label="เมนูมือถือ">{NAV.map(item => <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>)}<a href="/พื้นที่ให้บริการ">พื้นที่ให้บริการ</a><a href="/เกี่ยวกับเรา">เกี่ยวกับ BuyHub</a></nav></details></div>
  </div>
</header>
