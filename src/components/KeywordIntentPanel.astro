---
interface KeywordGroup {
  title: string;
  blurb?: string;
  items: string[];
}

interface Props {
  sectionId: string;
  title: string;
  intro?: string[];
  groups: KeywordGroup[];
  className?: string;
}

const { sectionId, title, intro = [], groups, className = '' } = Astro.props;
const previewLimit = 6;
const visibleGroups = groups
  .filter((group) => group.items?.length)
  .map((group) => ({
    ...group,
    previewItems: group.items.slice(0, previewLimit),
    hasMoreItems: group.items.length > previewLimit
  }));
---

<section
  aria-labelledby={sectionId}
  class:list={[
    'rounded-3xl border border-slate-200/80 bg-slate-50/50 p-6 md:p-8 shadow-sm backdrop-blur-sm',
    className
  ]}
>
  <div class="flex flex-col gap-4">
    <div class="max-w-4xl">
      <h2 id={sectionId} class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">
        {title}
      </h2>
      {
        intro.length ? (
          <div class="mt-3.5 space-y-3.5 text-sm sm:text-base leading-relaxed text-slate-600">
            {intro.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ) : null
      }
      <p class="mt-3 text-xs leading-relaxed text-slate-500">
        เพื่อความสะดวกในการเข้าถึงข้อมูลอย่างรวดเร็ว ส่วนนี้รวบรวมกลุ่มหัวข้อยอดนิยมที่ผู้ใช้งานในพื้นที่ภาคอีสานสนใจและค้นหาบ่อยที่สุด เพื่อช่วยคัดกรองเนื้อหาและนำคุณไปยังหัวข้อที่ตรงกับอุปกรณ์ของคุณในทันที
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))]">
    {visibleGroups.map((group) => (
      <section class="flex flex-col justify-between rounded-2xl border border-slate-200/60 bg-white p-5 shadow-xs hover:shadow-sm transition-all duration-300">
        <div>
          <h3 class="text-sm font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
            {group.title}
          </h3>
          {group.blurb ? <p class="mt-1.5 text-xs text-slate-500 leading-relaxed">{group.blurb}</p> : null}
          
          <div class="flex flex-wrap gap-1.5 mt-4">
            {group.previewItems.map((item) => (
              <span class="inline-flex items-center rounded-full bg-slate-50 px-2.5 py-1 text-[0.7rem] sm:text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-100 hover:bg-emerald-50 hover:text-emerald-700 hover:ring-emerald-200/80 transition-all duration-200 cursor-default select-none shadow-3xs">
                #{item}
              </span>
            ))}
          </div>
        </div>
        {
          group.hasMoreItems ? (
            <div class="mt-4 rounded-xl border border-dashed border-slate-100 bg-slate-50/50 px-3 py-1.5 text-[0.7rem] leading-normal text-slate-400">
              ระบบรับช่วงค้นหาตามรุ่นและจังหวัดเป้าหมายอัตโนมัติ
            </div>
          ) : null
        }
      </section>
    ))}
  </div>
</section>
