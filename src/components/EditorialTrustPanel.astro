---
import { EDITORIAL_REVIEWER, EDITORIAL_REVIEWER_TITLE, EDITORIAL_REVIEWER_BIO, EDITORIAL_REVIEWER_SOCIAL } from '../lib/constants';

type LinkItem = {
  href: string;
  label: string;
};

interface Props {
  reviewedAt: string;
  reviewedBy: string;
  scope: string;
  notes?: string[];
  links?: LinkItem[];
  reviewerTitle?: string;
  reviewerBio?: string;
  reviewerSocial?: string;
}

const { 
  reviewedAt, 
  reviewedBy, 
  scope, 
  notes = [], 
  links = [],
  reviewerTitle = reviewedBy === EDITORIAL_REVIEWER ? EDITORIAL_REVIEWER_TITLE : undefined,
  reviewerBio = reviewedBy === EDITORIAL_REVIEWER ? EDITORIAL_REVIEWER_BIO : undefined,
  reviewerSocial = reviewedBy === EDITORIAL_REVIEWER ? EDITORIAL_REVIEWER_SOCIAL : undefined
} = Astro.props;

const reviewedLabel = new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' }).format(new Date(reviewedAt));
---

<aside class="rounded-3xl border border-slate-200 bg-slate-50/80 p-6" aria-label="ข้อมูลการตรวจทานเนื้อหา">
  <h2 class="text-xl font-bold tracking-tight text-slate-950">ตรวจทานเนื้อหาและขอบเขตข้อมูล</h2>
  <dl class="mt-4 grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">อัปเดตล่าสุด</dt>
      <dd class="mt-2 text-sm font-semibold leading-7 text-slate-950">{reviewedLabel}</dd>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">ตรวจทานโดย</dt>
      <dd class="mt-2 text-sm font-semibold leading-7 text-slate-950">
        {reviewerSocial ? (
          <a href={reviewerSocial} class="text-emerald-700 hover:text-emerald-800 hover:underline transition" target="_blank" rel="noopener noreferrer">
            {reviewedBy}
          </a>
        ) : (
          reviewedBy
        )}
        {reviewerTitle && <span class="block mt-0.5 text-xs font-normal text-slate-500 leading-normal">{reviewerTitle}</span>}
      </dd>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3">
      <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">ขอบเขตหน้า</dt>
      <dd class="mt-2 text-sm leading-7 text-slate-700">{scope}</dd>
    </div>
  </dl>

  {
    notes.length ? (
      <ul class="mt-5 space-y-2 text-sm leading-7 text-slate-700">
        {notes.map((note) => (
          <li class="flex gap-2">
            <span class="text-emerald-600" aria-hidden="true">
              •
            </span>
            <span>{note}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  {
    reviewerBio ? (
      <div class="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50/20 p-5 text-sm leading-relaxed text-slate-700">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white font-bold text-base shadow-sm">
            {reviewedBy.substring(0, 3) || 'UA'}
          </div>
          <div>
            <p class="font-bold text-slate-900 leading-6">{reviewedBy}</p>
            {reviewerTitle && <p class="text-xs text-emerald-700 font-semibold leading-normal mt-0.5">{reviewerTitle}</p>}
            <p class="mt-2 text-xs leading-5 text-slate-600">{reviewerBio}</p>
            {reviewerSocial && (
              <a href={reviewerSocial} class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition" target="_blank" rel="noopener noreferrer">
                <span>ดูโปรไฟล์ความเชี่ยวชาญเพิ่มเติม</span>
                <span class="text-[10px]" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </div>
    ) : null
  }

  {
    links.length ? (
      <div class="mt-5 grid gap-2 sm:grid-cols-2">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-2xl border border-emerald-200 bg-white px-4 py-3 text-sm font-semibold leading-7 text-emerald-700 transition-colors hover:border-emerald-300 hover:text-emerald-800"
          >
            {link.label}
          </a>
        ))}
      </div>
    ) : null
  }
</aside>

