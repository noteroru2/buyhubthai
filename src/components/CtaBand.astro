---
import { PHONE_DISPLAY, PHONE_E164 } from '../lib/constants';
import LineCtaButton from './LineCtaButton.astro';

interface Props {
  heading?: string;
  sub?: string;
  lineLabel?: string;
}

const {
  heading = 'พร้อมขายสินค้าแล้วหรือยัง?',
  sub = 'ส่งรูปสินค้าให้ BuyHub ประเมินราคาเบื้องต้นฟรี รับราคาประเมินไว และโอนเงินทันทีหลังตรวจสอบสินค้า',
  lineLabel = 'ประเมินราคาทาง LINE @buyhub'
} = Astro.props;
---

<section
  class="relative isolate overflow-x-hidden border-y border-white/10 bg-buyhub-surface py-16 text-white sm:py-20"
  aria-labelledby="cta-band-title"
  style="background-image: radial-gradient(circle at 18% 22%, rgba(16,185,129,0.22), transparent 38%), radial-gradient(circle at 88% 78%, rgba(245,184,75,0.14), transparent 36%), radial-gradient(circle at 50% 100%, rgba(16,185,129,0.08), transparent 45%), linear-gradient(135deg, #0b1728 0%, #07111f 100%);"
>
  <div
    class="pointer-events-none absolute -left-24 top-1/3 h-72 w-72 -translate-y-1/2 rounded-full bg-emerald-500/20 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute -right-16 bottom-1/4 h-80 w-80 rounded-full bg-amber-400/15 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-px w-[min(100%,48rem)] -translate-x-1/2 bg-gradient-to-r from-transparent via-emerald-400/25 to-transparent"
    aria-hidden="true"
  />
  <div class="relative mx-auto min-w-0 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="min-w-0 rounded-2xl border border-white/10 bg-white/5 p-8 shadow-[0_24px_64px_-16px_rgba(0,0,0,0.5)] backdrop-blur-sm sm:p-10 lg:p-12"
    >
      <h2
        id="cta-band-title"
        class="text-center text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl"
      >
        {heading}
      </h2>
      <p class="mx-auto mt-5 max-w-3xl text-center text-base leading-8 text-slate-300">
        {sub}
      </p>
      <div class="mt-10 flex min-w-0 flex-col items-stretch justify-center gap-3 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-4">
        <LineCtaButton variant="primary" label={lineLabel} class="w-full min-w-0 sm:w-auto sm:max-w-md" />
        <a
          href={`tel:${PHONE_E164}`}
          class="inline-flex w-full min-w-0 items-center justify-center gap-2 rounded-2xl border-2 border-white/30 bg-white/10 px-6 py-3.5 text-base font-semibold text-white shadow-md backdrop-blur-sm transition duration-200 hover:border-white/35 hover:bg-white/15 sm:w-auto sm:max-w-md"
          aria-label={`โทรหา BuyHub ที่เบอร์ ${PHONE_DISPLAY}`}
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
              fill="currentColor"
            />
          </svg>
          โทร {PHONE_DISPLAY}
        </a>
      </div>
      <ul class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-x-6 gap-y-2 text-center text-xs leading-relaxed text-slate-300 sm:text-sm sm:leading-relaxed">
        <li>ไม่มีค่าประเมินเบื้องต้น</li>
        <li class="hidden sm:list-item">·</li>
        <li>แจ้งรายละเอียดก่อนนัด</li>
        <li class="hidden sm:list-item">·</li>
        <li>ตกลงราคาก่อนโอน</li>
      </ul>
    </div>
  </div>
</section>
