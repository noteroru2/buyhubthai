---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialTrustPanel from '../../components/EditorialTrustPanel.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import LineCtaButton from '../../components/LineCtaButton.astro';
import LongformSections from '../../components/LongformSections.astro';
import PhoneCtaButton from '../../components/PhoneCtaButton.astro';
import { breadcrumbJsonLd, faqPageJsonLd, webPageJsonLd } from '../../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER, LINE_AT } from '../../lib/constants';
import { areaThaiHref } from '../../lib/thaiRoutes';

const entries = await getCollection('areas', ({ data }) => !data.draft);
const sorted = entries.sort((a, b) => a.data.province.localeCompare(b.data.province, 'th'));
const byId = Object.fromEntries(sorted.map((e) => [e.id, e]));

const regions = [
  {
    title: 'อีสานบน',
    sub: 'โซนอีสานเหนือ เหมาะกับลูกค้าที่อยู่ใกล้อุดรธานี หนองคาย เลย บึงกาฬ สกลนคร นครพนม และจังหวัดรอบ ๆ',
    ids: ['udon-thani', 'nong-khai', 'loei', 'bueng-kan', 'sakon-nakhon', 'nakhon-phanom'] as const
  },
  {
    title: 'อีสานกลาง',
    sub: 'โซนอีสานกลาง เช่น ขอนแก่น มหาสารคาม ร้อยเอ็ด กาฬสินธุ์ และพื้นที่ใกล้เคียง',
    ids: ['khon-kaen', 'maha-sarakham', 'roi-et', 'kalasin'] as const
  },
  {
    title: 'อีสานล่าง',
    sub: 'โซนอีสานใต้ เช่น อุบลราชธานี ศรีสะเกษ สุรินทร์ บุรีรัมย์ นครราชสีมา ยโสธร อำนาจเจริญ ชัยภูมิ มุกดาหาร หนองบัวลำภู และจังหวัดรอบ ๆ',
    ids: [
      'ubon-ratchathani',
      'sisaket',
      'surin',
      'buriram',
      'nakhon-ratchasima',
      'yasothon',
      'amnat-charoen',
      'chaiyaphum',
      'mukdahan',
      'nong-bua-lamphu'
    ] as const
  }
] as const;

const title = 'พื้นที่ให้บริการรับซื้อสินค้าไอทีมือสองทั่วภาคอีสาน';
const description =
  `BuyHub รับซื้อสินค้าไอทีมือสองทั่วภาคอีสาน ครอบคลุมอุบลราชธานี ขอนแก่น นครราชสีมา อุดรธานี บุรีรัมย์ สุรินทร์ ศรีสะเกษ และทุกจังหวัดในอีสาน ส่งรูปประเมินราคาฟรีผ่าน LINE ${LINE_AT}`;

const geoFaqs = [
  {
    question: 'อยู่ต่างจังหวัดในภาคอีสาน ขายสินค้าไอทีให้ BuyHub ได้ไหม?',
    answer:
      'ได้ คุณสามารถส่งรูปและข้อมูลสินค้าเพื่อประเมินราคาฟรีก่อน จากนั้นทีมงานจะแนะนำวิธีนัดรับ/ส่งมอบตามจังหวัดและคิวงาน'
  },
  {
    question: 'ควรส่งข้อมูลอะไรพร้อมจังหวัดเพื่อให้ประเมินได้เร็ว?',
    answer:
      `แนะนำส่งรูปชัดหลายมุม + รุ่น/สเปก + ตำหนิ/สภาพ + อุปกรณ์ที่มี และแจ้งจังหวัด/อำเภอโดยประมาณใน LINE ${LINE_AT}`
  },
  {
    question: 'พื้นที่ที่ไม่มีหน้าแยกยังประเมินได้ไหม?',
    answer:
      'ได้ บางพื้นที่ยังไม่มีหน้าแยก แต่ยังสามารถประเมินจากรูปและคุยวิธีนัดรับ/ส่งมอบตามความเหมาะสมได้'
  },
  {
    question: 'รับซื้อเฉพาะในตัวเมืองหรือรับต่างอำเภอด้วย?',
    answer:
      'ประเมินได้ทั้งตัวเมืองและต่างอำเภอ รายละเอียดขึ้นกับคิวงานและความเหมาะสมของพื้นที่ แนะนำแจ้งอำเภอ/จุดนัดที่สะดวกใน LINE'
  }
] as const;

const editorialSignals = {
  scope:
    'หน้าพื้นที่ให้บริการใช้สรุปภาพรวมจังหวัดที่ BuyHub รองรับในภาคอีสาน พร้อมบอกวิธีเริ่มส่งข้อมูลจากจังหวัดหรืออำเภอของตัวเองให้ตรงบริบทพื้นที่มากที่สุด',
  about: ['พื้นที่ให้บริการภาคอีสาน', 'ขายสินค้า IT ต่างจังหวัด', 'เริ่มประเมินตามจังหวัดและอำเภอ'],
  notes: [
    'เหมาะสำหรับคนที่ต้องการเช็กก่อนว่าควรเริ่มจากหน้าจังหวัดไหน หรือถ้าอยู่ต่างอำเภอควรแจ้งพื้นที่อย่างไร',
    'หน้าจังหวัดแต่ละหน้าจะลงลึกกว่าหน้านี้ในเชิงบริบทพื้นที่ คำถามเฉพาะจังหวัด และลิงก์ต่อยอดที่เกี่ยวข้อง',
    'หากยังไม่เจอจังหวัดตัวเองในรายการ ให้เลือกจังหวัดใกล้ที่สุดแล้วแจ้งพื้นที่จริงในข้อความแรกเพื่อให้ทีมงานแนะนำคิวได้ตรงขึ้น'
  ],
  links: [
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขายทั้งหมด' },
    { href: '/รีวิวลูกค้า', label: 'ดูรีวิวลูกค้า' },
    { href: '/ติดต่อเรา', label: 'ดูช่องทางติดต่อ' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: 'พื้นที่ให้บริการ', href: '/พื้นที่ให้บริการ' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/พื้นที่ให้บริการ',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  faqPageJsonLd(geoFaqs)
];

const areaOverviewLinks = sorted.slice(0, 12).map((entry) => ({
  href: areaThaiHref(entry.id),
  label: `รับซื้อสินค้า IT มือสอง ${entry.data.province}`
}));

const geoLongSections = [
  {
    heading: 'ใช้หน้าพื้นที่ให้บริการนี้อย่างไร ถ้าคุณอยู่ภาคอีสานและอยากขายสินค้า IT',
    paragraphs: [
      'หน้าพื้นที่ให้บริการของ BuyHub ถูกสร้างขึ้นเพื่อช่วยให้คนที่อยู่ในภาคอีสานเห็นทันทีว่าบริการรองรับพื้นที่ของตัวเองหรือไม่ และควรเริ่มต้นจากจังหวัดไหนก่อน เพราะผู้ขายในแต่ละจังหวัดไม่ได้มีบริบทเหมือนกันทั้งหมด บางคนอยู่ในตัวเมือง บางคนอยู่ต่างอำเภอ บางคนต้องการขายเครื่องเดียว ขณะที่บางคนมีอุปกรณ์หลายรายการจากร้านค้าหรือสำนักงาน หน้านี้จึงต้องช่วยจัดกรอบความเข้าใจให้ชัดว่า “เริ่มจากการส่งรูปประเมินได้ก่อน” แล้วค่อยคุยเรื่องวิธีส่งมอบตามพื้นที่จริง',
      'ในมุมของการค้นหา ผู้ใช้ที่พิมพ์คำอย่าง “รับซื้อโน๊ตบุ๊ค ขอนแก่น” หรือ “ขาย iPhone อุดรธานี” มักคาดหวังว่าหน้าเว็บจะตอบเรื่องพื้นที่จริง ไม่ใช่เพียงเอาชื่อจังหวัดมาแปะไว้บนเทมเพลตเดิม การทำหน้ารวมพื้นที่ให้บริการที่มีคำอธิบายเชิงพื้นที่ชัดเจน ช่วยให้ทั้งคนอ่านและเสิร์ชเอนจินเข้าใจว่า BuyHub มีโครงสร้างเนื้อหาที่เชื่อมจากหน้ากลางไปยังหน้าจังหวัดอย่างเป็นระบบ'
    ],
    list: regions.map((region) => `${region.title}: ${region.sub}`)
  },
  {
    heading: 'ถ้าอยู่ต่างอำเภอหรือนอกตัวเมือง ควรแจ้งข้อมูลอะไรเพิ่ม',
    paragraphs: [
      'สำหรับการขายสินค้า IT มือสองในภาคอีสาน ข้อมูลพื้นที่ไม่ควรหยุดแค่ชื่อจังหวัด เพราะความต่างระหว่างตัวเมืองกับต่างอำเภอมีผลกับการนัดหมายและรูปแบบการส่งมอบอย่างชัดเจน ถ้าคุณอยู่ต่างอำเภอ แนะนำให้แจ้งอำเภอ จุดอ้างอิงโดยประมาณ และช่วงเวลาที่สะดวกตั้งแต่ต้น วิธีนี้ทำให้ทีมงานช่วยแนะนำขั้นตอนที่เหมาะกับบริบทจริงได้เร็วขึ้น แทนที่จะต้องย้อนถามเรื่องพื้นที่ในภายหลัง',
      'การแจ้งพื้นที่ที่ละเอียดขึ้นยังช่วยในแง่ GEO และ Local SEO เพราะคอนเทนต์ที่อ้างอิงพื้นที่จริงจะตอบโจทย์คำค้นหาท้องถิ่นได้ดีกว่าคำอธิบายกว้าง ๆ เช่น “รับซื้อทั่วอีสาน” อย่างเดียว คนอ่านต้องการรู้ว่าบริการนี้เข้าใจระยะทาง เวลา และความสะดวกของเขาหรือไม่ การอธิบายเรื่องพื้นที่แบบเป็นรูปธรรมจึงช่วยเพิ่มทั้งความน่าเชื่อถือและคุณภาพของคำตอบบนหน้าเว็บ'
    ],
    list: [
      'จังหวัดและอำเภอที่อยู่หรือจุดนัดที่สะดวก',
      'ช่วงเวลาที่สะดวกสำหรับการคุยรายละเอียดหรือการนัดตรวจ',
      'ประเภทสินค้า จำนวนชิ้น และหมวดที่ใกล้เคียงที่สุด',
      'ข้อจำกัดด้านการเดินทางหรือช่วงเวลาที่ไม่สะดวก',
      'รูปสินค้าหลายมุมพร้อมรุ่น สเปก และสภาพจริง'
    ]
  },
  {
    heading: 'หน้าจังหวัดช่วยเรื่อง SEO, AEO และ GEO ของเว็บอย่างไร',
    paragraphs: [
      'หน้าจังหวัดที่ดีไม่ได้มีไว้เพียงให้ติดคำค้นชื่อจังหวัด แต่ช่วยทำให้คำตอบบนเว็บมีบริบทเฉพาะพื้นที่มากขึ้น เช่น จังหวัดไหนมีบริการรับซื้อที่คนค้นหาบ่อย หมวดสินค้าหลักที่มักขายในพื้นที่นั้นคืออะไร และควรเริ่มคุยเรื่องคิวหรือจุดนัดแบบไหน การมีหน้ารวมพื้นที่ให้บริการที่เชื่อมไปยังหน้าจังหวัด ทำให้โครงสร้างเว็บไซต์ชัดทั้งต่อผู้ใช้และต่อเสิร์ชเอนจิน',
      'ในแง่ AEO หน้าพื้นที่รวมยังมีหน้าที่ตอบคำถามสั้นระดับภาพรวม เช่น “อยู่ต่างจังหวัดขายได้ไหม” หรือ “ต้องแจ้งพื้นที่ไหมตอนประเมิน” ก่อนพาผู้อ่านไปยังหน้าจังหวัดที่ลึกขึ้น ส่วนในแง่ GEO การมีข้อความที่อ้างอิงภูมิภาคและการใช้งานจริงในภาคอีสาน ช่วยให้หน้าเว็บดูมีประโยชน์กว่าเนื้อหาที่เปลี่ยนชื่อพื้นที่แบบผิวเผิน ซึ่งเป็นสิ่งที่ระบบค้นหาสมัยใหม่แยกแยะได้ชัดขึ้นเรื่อย ๆ'
    ],
    links: areaOverviewLinks
  },
  {
    heading: 'ถ้ามีหลายชิ้นหรือเป็นงานองค์กร ควรเริ่มจากหน้าพื้นที่หรือหน้าหมวดสินค้า',
    paragraphs: [
      'ถ้าคุณมีสินค้าหลายชิ้นจากสำนักงาน ร้านค้า หรือการอัปเกรดพร้อมกัน การเริ่มจากหน้าพื้นที่ให้บริการจะช่วยให้คุณเช็กก่อนว่าพื้นที่ของคุณรองรับการคุยคิวและการนัดหมายแบบไหน จากนั้นค่อยไปหน้าหมวดสินค้าที่ตรงกับรายการหลัก เช่น คอมบริษัท โน๊ตบุ๊ค หรืออุปกรณ์สำนักงาน IT วิธีนี้ช่วยให้การประเมินไม่หลุดประเด็น และช่วยให้ทีมงานตอบทั้งเรื่องราคาและขั้นตอนตามพื้นที่ได้พร้อมกัน',
      'ในทางกลับกัน ถ้าคุณมีเพียงเครื่องเดียวและรู้หมวดชัด เช่น iPhone หรือ MacBook การเริ่มจากหน้าหมวดก่อนอาจเหมาะกว่า เพราะจะได้อ่านปัจจัยราคาของสินค้านั้นโดยตรง แล้วค่อยย้อนมาดูหน้าจังหวัดหรือหน้าพื้นที่ถ้าต้องการข้อมูลเรื่องพื้นที่เพิ่ม การอธิบายเส้นทางการใช้งานสองแบบนี้บนหน้าพื้นที่รวม ช่วยลดความสับสนของผู้ใช้และเพิ่มโอกาสที่ผู้อ่านจะไปยังหน้าที่ตรงเจตนาจริงของตัวเอง'
    ],
    list: [
      'เครื่องเดียวและรู้หมวดชัด: ไปหน้าหมวดสินค้าก่อน แล้วค่อยดูพื้นที่ถ้าจำเป็น',
      'หลายชิ้นจากองค์กรหรือร้านค้า: เช็กพื้นที่ก่อน แล้วค่อยดูหมวดสินค้าหลัก',
      'ถ้ายังไม่แน่ใจ: ส่งรายการคร่าว ๆ พร้อมจังหวัดเข้ามาประเมินได้ทันที',
      'การแจ้งพื้นที่พร้อมจำนวนชิ้นช่วยให้จัดคิวและรูปแบบนัดได้ง่ายขึ้น'
    ]
  },
  {
    heading: 'สรุปแนวทางเริ่มต้นสำหรับคนที่ค้นหาว่า BuyHub รับซื้อถึงจังหวัดของตัวเองไหม',
    paragraphs: [
      'คำตอบสั้นคือ เริ่มจากการดูหน้าจังหวัดของตัวเองหรือจังหวัดใกล้เคียง แล้วใช้ข้อมูลบนหน้านั้นประกอบการส่งรูปประเมิน ถ้ามีคำถามเชิงพื้นที่ เช่น อยู่ต่างอำเภอได้ไหม หรือควรแจ้งจุดนัดอย่างไร ให้ส่งคำถามพร้อมรูปสินค้าในข้อความเดียวกัน วิธีนี้ช่วยให้ทั้งการประเมินและการวางแผนขั้นตอนต่อไปมีความชัดเจนมากขึ้น',
      'เป้าหมายของหน้าพื้นที่ให้บริการไม่ใช่เพียงทำให้เว็บมีรายชื่อจังหวัดครบ แต่คือทำให้คนในภาคอีสานรู้สึกว่าตัวเองได้รับคำตอบที่ตรงกับบริบทจริงของพื้นที่ หากผู้อ่านเข้าใจหลังจบหน้านี้ว่าควรเริ่มจากหน้าจังหวัดไหน ควรแจ้งข้อมูลอะไร และสามารถไปอ่านหน้าหมวดหรือบทความต่อได้ที่ไหน ก็ถือว่าหน้านี้ตอบโจทย์ทั้ง Local SEO, GEO และประสบการณ์ใช้งานจริงแล้ว'
    ],
    orderedList: [
      'เลือกจังหวัดของตัวเองหรือจังหวัดใกล้เคียงจากรายการด้านบน',
      'อ่านหน้าจังหวัดเพื่อดูบริบทพื้นที่และหมวดสินค้าที่เกี่ยวข้อง',
      'ถ่ายรูปหลายมุมพร้อมระบุรุ่น สเปก สภาพ และอุปกรณ์ในชุด',
