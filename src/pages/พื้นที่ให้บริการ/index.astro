---
import { getCollection } from 'astro:content';
import InfoPage from '../../components/InfoPage.astro';
const areas = (await getCollection('areas', ({data}) => !data.draft)).sort((a,b) => a.data.province.localeCompare(b.data.province, 'th'));
---
<InfoPage path="/พื้นที่ให้บริการ" title="พื้นที่และวิธีส่งมอบสินค้าไอที | BuyHub" heading="แจ้งพื้นที่ก่อน เลือกวิธีขายที่สะดวก" description="ส่งรูปประเมินผ่าน LINE @buyhub ก่อนคุยเรื่องเข้าร้าน นัดรับ หรือจัดส่ง ตรวจสอบพื้นที่และคิวงานกับทีมงานก่อนส่งมอบสินค้า">
  <section><h2>เลือกวิธีส่งมอบหลังทราบราคาเบื้องต้น</h2><div class="bh-service-list"><a href="/ติดต่อเรา"><h3>นำเข้าร้านหลักที่อุบลราชธานี ↗</h3><p>ติดต่อก่อนเดินทางเพื่อยืนยันวัน เวลา และรายการสินค้าที่นำเข้าตรวจ</p></a><a href="/ติดต่อเรา"><h3>สอบถามคิวนัดรับหรือจัดส่ง ↗</h3><p>แจ้งอำเภอ จำนวน และประเภทสินค้า ทีมงานจะตรวจสอบรูปแบบที่รองรับในรายการของคุณ</p></a></div></section>
  <section><h2>ข้อมูลสำหรับผู้ขายในภาคอีสาน</h2><p>เลือกจังหวัดเพื่อดูแนวทางเริ่มติดต่อ รายชื่อด้านล่างเป็นหน้าข้อมูลพื้นที่ ไม่ใช่รายชื่อสาขา และไม่ได้ยืนยันบริการรับถึงที่ทุกอำเภอ การนัดรับต้องตกลงกับทีมงานเป็นรายงาน</p><div class="bh-link-list">{areas.map(entry => <a href={`/พื้นที่ให้บริการ/${entry.data.province}`}>{entry.data.province} ↗</a>)}</div></section>
  <section><h2>อยู่พื้นที่อื่นหรือมีสินค้าหลายรายการ?</h2><p>แจ้งจังหวัด อำเภอ จำนวน และรูปตัวอย่างให้ทีมงานพิจารณาก่อนได้ หากต้องจัดส่งให้ยืนยันที่อยู่ เงื่อนไขตรวจสินค้า ค่าขนส่ง และการชำระเงินให้ครบก่อนส่ง</p><a class="bh-text-link" href="/รับซื้อคอมบริษัท">ข้อมูลรับซื้อหลายเครื่องและยกล็อต ↗</a></section>
</InfoPage>
