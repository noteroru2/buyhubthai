---
import InfoPage from '../components/InfoPage.astro';
import { FACEBOOK_URL } from '../lib/constants';
---
<InfoPage path="/รีวิวลูกค้า" title="ข้อมูลประกอบการตัดสินใจขายกับ BuyHub" heading="ตรวจสอบข้อมูล ก่อนตัดสินใจขาย" description="ดูช่องทางแบรนด์ ภาพสินค้า ข้อมูลผู้ดำเนินการ และขั้นตอนการรับซื้อของ BuyHub ก่อนเริ่มส่งรูปประเมิน">
  <section><h2>ดูข้อมูลจากช่องทางของแบรนด์</h2><p>คุณสามารถเปิด Facebook BuyHub เพื่อตรวจสอบโพสต์และข้อมูลที่เผยแพร่ หรือสอบถามทีมงานโดยตรงผ่าน LINE @buyhub ก่อนตกลงส่งมอบสินค้า</p><a class="bh-text-link" href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">เปิด Facebook BuyHub ↗</a></section>
  <section><h2>ข้อมูลที่ช่วยตรวจสอบบริการ</h2><div class="bh-link-list"><a href="/เกี่ยวกับเรา">ผู้ดำเนินการ BuyHub ↗</a><a href="/ผลงานรับซื้อจริง">ภาพสินค้าประกอบบริการ ↗</a><a href="/ขั้นตอนการขาย">วิธีประเมินและส่งมอบ ↗</a><a href="/ติดต่อเรา">ที่อยู่และช่องทางติดต่อ ↗</a></div></section>
</InfoPage>
