<BaseLayout
  title={title}
  description={description}
  ogImage="/images/og/buyhub-reviews-share.png"
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
>
  <article class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <header class="max-w-3xl">
        <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">รีวิวลูกค้า BuyHub</h1>
        <p class="mt-5 text-base leading-8 text-slate-700">
          หน้านี้รวมตัวอย่างรีวิวและหลักฐานประกอบแบบ <span class="font-semibold text-slate-950">ปิดข้อมูลส่วนตัว</span> เพื่อให้ลูกค้าเห็นภาพการคุยงานจริง
          ตั้งแต่การส่งรูปประเมินราคา ไปจนถึงการตรวจสอบสินค้าและการโอนเงินตามขั้นตอน
        </p>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          หากต้องการประเมินราคา แอด LINE <span class="font-semibold text-slate-950">{LINE_AT}</span> แล้วส่งรูปสินค้า + รุ่น/สเปก + ตำหนิ/สภาพ + จังหวัด ได้เลย
        </p>
      </header>

      <div class="mt-10">
        <EditorialTrustPanel
          reviewedAt={EDITORIAL_REVIEWED_AT}
          reviewedBy={EDITORIAL_REVIEWER}
          scope="หน้านี้รวบรวมตัวอย่างรีวิวและหลักฐานประกอบแบบปิดข้อมูลส่วนบุคคล เพื่อช่วยให้คนขายเห็นรูปแบบการคุยงานจริงและมาตรฐานการสื่อสารก่อนเริ่มประเมิน"
          notes={[
            'รีวิวและหลักฐานประกอบใช้เพื่ออธิบายกระบวนการทำงาน ไม่ได้ใช้เป็นตัวแทนราคาของทุกเคส เพราะราคาจริงขึ้นกับรุ่น สเปก สภาพ และอุปกรณ์ในชุด',
            'ข้อมูลที่ระบุตัวบุคคลได้ เช่น ชื่อ เบอร์โทร หรือรายละเอียดธุรกรรม ต้องถูกปิดก่อนนำมาใช้เป็นตัวอย่างเสมอ',
            'หากคุณอยู่ต่างจังหวัด ควรใช้หน้านี้ควบคู่กับหน้าพื้นที่ให้บริการ เพื่อดูว่าควรแจ้งจังหวัด อำเภอ หรือจุดนัดอย่างไรตั้งแต่ข้อความแรก'
          ]}
          links={[
            { href: '/ผลงานรับซื้อจริง', label: 'ดูผลงานรับซื้อจริงเพิ่มเติม' },
            { href: '/พื้นที่ให้บริการ', label: 'ดูหน้าพื้นที่ให้บริการทั้งหมด' }
          ]}
        />
      </div>

      <section class="mt-12" aria-labelledby="review-proof-heading">
        <h2 id="review-proof-heading" class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
          ตัวอย่างหลักฐานและรีวิว (ปิดข้อมูลส่วนตัว)
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-8 text-slate-600">
          ภาพชุดนี้เป็นตัวอย่างเพื่อประกอบความเข้าใจเท่านั้น ราคาจริงขึ้นกับรุ่น สเปก สภาพ และข้อมูลที่ส่งมา
        </p>

        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {proofCards.map((c) => (
            <li class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-xl">
              <div class="aspect-[4/3] w-full bg-slate-100">
                <img
                  src={c.src}
                  alt={c.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="p-6">
                <h3 class="text-lg font-bold tracking-tight text-slate-950">{c.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{c.sub}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="review-local-areas">
        <h2 id="review-local-areas" class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
          จังหวัดที่คนมักดูต่อหลังจากหน้ารีวิวลูกค้า
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-8 text-slate-600">
          ถ้าคุณดูรีวิวแล้วอยากเริ่มคุยงานแบบมีบริบทมากขึ้น ลองไปดูหน้าจังหวัดที่ใกล้กับพื้นที่ของคุณต่อได้เลย เพราะแต่ละหน้าจะช่วยจัดลำดับว่าควรบอกอะไรเพื่อให้ประเมินง่ายขึ้น
        </p>
        <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredAreaSpotlights.map((item) => (
            <li>
              <a
                href={item.href}
                class="block h-full rounded-2xl border border-slate-200 bg-slate-50/70 p-5 transition-all duration-200 hover:border-slate-300 hover:bg-white hover:shadow-lg"
              >
                <h3 class="text-lg font-bold tracking-tight text-slate-950">{item.province}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-700">{item.summary}</p>
                <p class="mt-3 text-sm leading-7 text-slate-600">{item.proofHint}</p>
                <span class="mt-4 inline-block text-sm font-semibold text-emerald-700">ดูหน้าพื้นที่ {item.province} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-14 rounded-2xl border border-slate-200 bg-slate-50/70 p-6 sm:p-8" aria-labelledby="review-note">
        <h2 id="review-note" class="text-xl font-bold tracking-tight text-slate-950">หมายเหตุเรื่องความโปร่งใส</h2>
        <ul class="mt-4 space-y-2 text-sm leading-7 text-slate-700">
          <li><span class="font-semibold text-slate-950">ประเมินราคาฟรี</span> จากรูปและข้อมูลที่ส่งมา</li>
          <li><span class="font-semibold text-slate-950">แจ้งราคาก่อนตัดสินใจขาย</span> และคอนเฟิร์มราคาหลังตรวจสภาพจริง</li>
          <li><span class="font-semibold text-slate-950">ให้ราคาตามรุ่นและสภาพจริง</span> พร้อมอธิบายเหตุผลหากต้องปรับราคา</li>
        </ul>
      </section>

      <LongformSections sections={reviewSections} tocHeading="หัวข้อสำคัญสำหรับหน้ารีวิวลูกค้า" />
    </div>
  </article>

  <CtaBand
    heading="อยากรู้ราคาสินค้า IT ของคุณ?"
    sub={`ส่งรูปสินค้า รุ่น/สเปก และสภาพมาที่ LINE ${LINE_AT} เพื่อประเมินราคาฟรี รู้ราคาก่อนตัดสินใจขาย`}
    lineLabel={`แอด LINE ${LINE_AT}`}
  />
</BaseLayout>
