      <div class="mt-10 max-w-3xl">
        <EditorialTrustPanel
          reviewedAt={EDITORIAL_REVIEWED_AT}
          reviewedBy={EDITORIAL_REVIEWER}
          scope={editorialSignals.scope}
          notes={[...editorialSignals.notes]}
          links={[...editorialSignals.links]}
        />
      </div>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">การประเมินราคาเบื้องต้น</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        ราคาที่แจ้งจากรูปภาพหรือข้อมูลเบื้องต้นเป็น “ราคาประเมิน” เพื่อใช้ประกอบการตัดสินใจ ทีมงานจะแจ้งแนวทางและปัจจัยที่มีผลต่อราคาก่อนนัดเสมอ
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">สิ่งที่ผู้ขายควรแจ้งให้ครบ</h2>
      <ul class="mt-4 space-y-2 text-base text-slate-600">
        <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span>รุ่น/สเปก/ความจุ และอุปกรณ์ในชุด</li>
        <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span>สภาพการใช้งานและตำหนิ (รวมประวัติซ่อมถ้ามี)</li>
        <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span>สถานะบัญชี/การล็อก (เช่น iCloud/Find My/FRP/MDM)</li>
        <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span>จังหวัด/พื้นที่ เพื่อคุยรูปแบบการส่งมอบ</li>
      </ul>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">ราคาประเมินอาจเปลี่ยนแปลงตามสภาพจริง</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        ราคาจริงจะคอนเฟิร์มหลังตรวจสภาพจริง หากสภาพ/อุปกรณ์/ข้อมูลแตกต่างจากที่แจ้งไว้ ราคาสุดท้ายอาจมีการปรับ โดยทีมงานจะแจ้งเหตุผลอย่างชัดเจนก่อนตกลงซื้อขาย
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">ผู้ขายต้องเป็นเจ้าของสินค้าหรือมีสิทธิ์ขาย</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        ผู้ขายควรเป็นเจ้าของสินค้าหรือมีสิทธิ์ในการขายสินค้า หากเป็นสินค้าจากบริษัท/หน่วยงานควรมีผู้รับผิดชอบที่สามารถยืนยันการส่งมอบได้
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">การตรวจสอบสินค้า</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        ทีมงานตรวจสอบการทำงาน จุดตำหนิ สภาพแบต และองค์ประกอบสำคัญตามประเภทสินค้า เพื่อให้ราคาสุดท้ายสะท้อนสภาพจริงอย่างเหมาะสม
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">ข้อมูลส่วนตัวและการล้างข้อมูลก่อนส่งมอบ</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        ผู้ขายควรสำรองและลบข้อมูลส่วนตัวออกจากอุปกรณ์ รวมถึงออกจากบัญชีที่ผูกไว้ก่อนส่งมอบทุกครั้ง เพื่อความปลอดภัยของข้อมูล
        (ดูแนวทางที่หน้า{' '}
        <a class="font-semibold text-emerald-700 underline decoration-emerald-500/35 underline-offset-4 hover:text-emerald-800" href="/คู่มือเตรียมสินค้าก่อนขาย">
          คู่มือเตรียมสินค้าก่อนขาย
        </a>
        )
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">การชำระเงิน</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        เมื่อคอนเฟิร์มราคาสุดท้ายและตกลงซื้อขายแล้ว จะดำเนินการชำระเงินตามขั้นตอนที่ตกลงกัน (โดยทั่วไปโอนเงินทันทีหลังตรวจสอบสินค้า)
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">สินค้าที่อาจปฏิเสธการรับซื้อ</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        บางกรณีอาจปฏิเสธการรับซื้อ เช่น รุ่นที่ไม่มีความต้องการในตลาด ความเสียหายที่ไม่คุ้มค่าการรับซื้อ หรือข้อมูลไม่ครบจนไม่สามารถประเมินได้อย่างเหมาะสม
      </p>

      <h2 class="mt-10 text-xl font-semibold text-slate-950">ข้อจำกัดความรับผิดชอบ</h2>
      <p class="mt-3 leading-relaxed text-slate-600">
        BuyHub ให้คำแนะนำและประเมินราคาตามข้อมูลที่ได้รับ และตามสภาพจริง ณ เวลาตรวจสอบ ผู้ขายควรสำรอง/ลบข้อมูลส่วนตัวก่อนส่งมอบเครื่องทุกครั้ง
      </p>

      <LongformSections sections={termsSections} tocHeading="หัวข้อสำคัญในเงื่อนไขการใช้บริการ BuyHub" />

      <div class="mt-12 flex flex-col gap-4 sm:flex-row">
        <LineCtaButton variant="primary" class="sm:flex-1" />
        <PhoneCtaButton variant="light" class="sm:flex-1" />
      </div>
    </div>
  </article>
  <CtaBand
    heading="อยากเช็กราคาก่อนตกลงขาย?"
    sub="ส่งรูปหลายมุมกับรุ่นที่ชัดเจนทาง LINE @buyhub เพื่อประเมินเบื้องต้นฟรี"
    lineLabel="ส่งรูปประเมินทาง LINE"
  />
</BaseLayout>
