---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineCtaButton from '../components/LineCtaButton.astro';
import PhoneCtaButton from '../components/PhoneCtaButton.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import LongformSections from '../components/LongformSections.astro';
import { breadcrumbJsonLd, webPageJsonLd } from '../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER } from '../lib/constants';

const title = 'เงื่อนไขการใช้บริการ BuyHub';
const description =
  'เงื่อนไขการใช้บริการ BuyHub สำหรับการประเมินราคา รับซื้อสินค้า IT มือสอง การตรวจสอบสินค้า และการชำระเงิน';

const editorialSignals = {
  scope:
    'หน้าเงื่อนไขการใช้บริการอธิบายขอบเขตการประเมินราคา ความหมายของราคาเบื้องต้น หน้าที่ของผู้ขายก่อนนัด และหลักการสื่อสารเมื่อมีข้อมูลใหม่ที่กระทบต่อราคา',
  about: ['เงื่อนไขการใช้บริการ BuyHub', 'ราคาเบื้องต้นกับราคาสุดท้าย', 'หน้าที่ของผู้ขายก่อนส่งมอบสินค้า'],
  notes: [
    'ราคาที่ได้จากแชทเป็นแนวประเมินจากข้อมูลรอบแรก และต้องยืนยันอีกครั้งเมื่อเห็นสภาพจริง',
    'ผู้ขายควรแจ้งตำหนิ สถานะบัญชี และอุปกรณ์ในชุดให้ครบตั้งแต่ต้นเพื่อลดการปรับราคาในภายหลัง',
    'หากมีข้อมูลใหม่ที่มีผลต่อราคา ควรแจ้งทันทีเพื่อให้การนัดหมายและการประเมินยังเป็นธรรมกับทั้งสองฝ่าย'
  ],
  links: [
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขายทั้งหมด' },
    { href: '/คำถามที่พบบ่อย', label: 'ดูคำถามที่พบบ่อยก่อนเริ่มขาย' },
    { href: '/ติดต่อเรา', label: 'ไปหน้าติดต่อ BuyHub' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: 'เงื่อนไขการใช้บริการ', href: '/เงื่อนไขการใช้บริการ' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/เงื่อนไขการใช้บริการ',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  })
];

const termsSections = [
  {
    heading: 'เงื่อนไขการใช้บริการของ BuyHub ควรช่วยให้ลูกค้าเข้าใจอะไรได้ชัดขึ้น',
    paragraphs: [
      'สำหรับบริการรับซื้อสินค้าไอทีมือสอง เงื่อนไขการใช้บริการมีหน้าที่สำคัญมากกว่าการรวบรวมข้อจำกัดทางกฎหมาย เพราะนี่คือหน้าที่ทำให้ลูกค้าเห็นกรอบการทำงานร่วมกันอย่างเป็นธรรม เช่น ราคาเบื้องต้นที่ได้จากแชทหมายถึงอะไร ต้องเตรียมข้อมูลอย่างไรจึงจะประเมินได้ใกล้เคียง เงื่อนไขใดอาจทำให้ราคาสุดท้ายเปลี่ยน และกรณีแบบไหนที่อาจไม่สามารถรับซื้อได้ การเขียนให้ชัดเจนตั้งแต่ต้นช่วยลดความเข้าใจคลาดเคลื่อนระหว่างผู้ขายกับ BuyHub และทำให้ทุกฝ่ายเข้าสู่การคุยราคาบนฐานข้อมูลชุดเดียวกัน',
      'ในมุมของผู้ขาย หน้านี้ควรตอบคำถามสำคัญก่อนตัดสินใจเริ่มคุย เช่น ถ้าส่งรูปมาแล้วได้ช่วงราคาไว้ก่อน แต่วันตรวจจริงเครื่องมีตำหนิเพิ่ม จะเกิดอะไรขึ้น ถ้าเป็นสินค้าจากบริษัท ต้องมีผู้รับผิดชอบหรือเอกสารแบบไหน หรือถ้าเครื่องยังออกจากบัญชีไม่เรียบร้อย จะสามารถขายได้หรือไม่ การให้คำตอบล่วงหน้าในเงื่อนไขช่วยให้ผู้ขายรู้ขอบเขตและหน้าที่ของตัวเองชัดขึ้น นั่นทำให้กระบวนการประเมินของ BuyHub เดินได้อย่างราบรื่นกว่าเดิม'
    ]
  },
  {
    heading: 'ความหมายของราคาประเมินเบื้องต้น และเหตุผลที่ราคาสุดท้ายต้องยึดตามการตรวจจริง',
    paragraphs: [
      'ราคาประเมินเบื้องต้นเป็นแนวทางที่ได้จากข้อมูลและรูปที่ลูกค้าส่งมาในรอบแรก จุดประสงค์ของราคาประเภทนี้ไม่ใช่การรับปากตายตัว แต่เป็นการช่วยให้ลูกค้ามองเห็นช่วงมูลค่าของสินค้าตัวเองภายใต้ข้อมูลที่มีอยู่ในเวลานั้น ถ้ารูปชัด ข้อมูลครบ รุ่น สเปก ความจุ ตำหนิ และสถานะบัญชีตรงกับความเป็นจริง ราคาประเมินก็มักใกล้เคียงกับราคาที่คุยปิดงานได้มาก แต่ถ้าข้อมูลที่ส่งมายังไม่ครบ หรือมีจุดที่ยังตรวจจากภาพไม่ได้ เช่น หน้าจอมีตำหนิที่มองไม่เห็น ระบบมีปัญหา แบตเสื่อมมาก หรืออุปกรณ์ไม่ครบตามที่เข้าใจ ราคาประเมินย่อมต้องมีพื้นที่เผื่อไว้',
      'เมื่อถึงขั้นตรวจสินค้าจริง ราคาสุดท้ายจึงต้องผูกกับสภาพที่ตรวจพบ ณ เวลานั้น ไม่ใช่ผูกกับความคาดหวังจากภาพรอบแรกเพียงอย่างเดียว หลักการนี้สำคัญทั้งต่อความเป็นธรรมของผู้ขายและความถูกต้องของ BuyHub เพราะหากบังคับให้ยึดราคาประเมินเดิมโดยไม่ดูสภาพจริง ก็อาจกลายเป็นการประเมินที่ไม่สอดคล้องกับข้อเท็จจริง ขณะเดียวกัน BuyHub ก็ควรมีหน้าที่อธิบายเหตุผลทุกครั้งหากต้องปรับราคา เช่น เกิดจากจุดตำหนิที่ไม่เคยแจ้งมาก่อน อุปกรณ์ในชุดไม่ครบ หรือระบบเครื่องยังมีบัญชีค้างอยู่ เงื่อนไขที่ดีจึงไม่ได้มีไว้เพื่อให้ใครเสียเปรียบ แต่มีไว้เพื่อทำให้ความต่างระหว่างราคาประเมินกับราคาสุดท้ายอธิบายได้อย่างโปร่งใส'
    ],
    note:
      'ถ้าลูกค้าต้องการให้แนวราคาที่ได้จากแชทใกล้เคียงที่สุด ควรส่งรูปหลายมุม แจ้งตำหนิให้ครบ และบอกข้อมูลรุ่นหรือสเปกให้ชัดตั้งแต่รอบแรก'
  },
  {
    heading: 'หน้าที่ของผู้ขายก่อนเริ่มประเมินและก่อนส่งมอบจริง',
    paragraphs: [
      'หน้าที่สำคัญของผู้ขายเริ่มตั้งแต่การให้ข้อมูลที่ตรงกับสภาพจริง ไม่ว่าจะเป็นรุ่น สเปก ความจุ อาการใช้งาน ตำหนิ ประวัติซ่อม หรือสถานะบัญชีที่ผูกกับอุปกรณ์ หากลูกค้ารู้ว่ามีปัญหาบางอย่าง เช่น แบตเสื่อม จอมีเส้น ปุ่มบางปุ่มไม่ทำงาน หรือมีระบบล็อกค้างอยู่ ก็ควรแจ้งตั้งแต่ต้น เพราะข้อมูลเหล่านี้มีผลต่อทั้งราคาประเมินและความเหมาะสมในการรับซื้อ การแจ้งล่วงหน้าไม่ได้ทำให้เสียเปรียบ แต่กลับช่วยให้คำตอบที่ได้ใกล้เคียงความจริงมากขึ้น และลดการย้อนกลับไปเจรจาใหม่ภายหลัง',
      'ก่อนส่งมอบจริง ผู้ขายยังมีหน้าที่จัดการข้อมูลส่วนตัวในเครื่องให้เรียบร้อย สำรองข้อมูล ออกจากบัญชีที่เกี่ยวข้อง และเตรียมอุปกรณ์ร่วมชุดให้ครบตามที่แจ้งไว้ นอกจากนี้หากเป็นสินค้าจากองค์กรหรือบริษัท ก็ควรมีผู้รับผิดชอบที่ยืนยันสิทธิในการขายได้ชัดเจน เพราะการที่ BuyHub รับประเมินไม่ได้หมายความว่ารายการนั้นจะพร้อมส่งมอบในทันทีเสมอ เงื่อนไขจึงควรกำหนดกรอบหน้าที่ของผู้ขายไว้ตั้งแต่ต้นเพื่อให้ทุกฝ่ายทำงานบนมาตรฐานเดียวกัน'
    ],
    orderedList: [
      'แจ้งรุ่น สเปก ความจุ และสภาพจริงของสินค้าให้ครบ',
      'ระบุตำหนิ ประวัติซ่อม หรือปัญหาที่ทราบอยู่แล้วตามตรง',
      'สำรองข้อมูล ออกจากบัญชี และเตรียมเครื่องให้พร้อมก่อนส่งมอบ',
      'เตรียมอุปกรณ์ร่วมชุดตามที่แจ้งไว้ เช่น กล่อง สาย หรือหัวชาร์จ',
      'หากเป็นสินค้าจากองค์กร ควรกำหนดผู้รับผิดชอบและยืนยันสิทธิในการขายให้ชัด'
    ]
  },
  {
    heading: 'กรณีใดบ้างที่ BuyHub อาจปรับราคา ปฏิเสธรับซื้อ หรือเลื่อนการปิดงาน',
    paragraphs: [
      'แม้ BuyHub จะเปิดรับประเมินหลายหมวดสินค้า แต่ก็มีหลายกรณีที่อาจทำให้การปิดงานต้องหยุดชะงักหรือไม่สามารถรับซื้อได้ เช่น สินค้าไม่ตรงกับรายละเอียดที่แจ้งไว้ สภาพจริงเสียหายมากกว่าที่เห็นจากรูป ระบบเครื่องยังติดล็อกบัญชีหรือระบบองค์กรที่ไม่สามารถส่งมอบต่อได้ อุปกรณ์หลักขาดหายจนกระทบมูลค่าหรือความพร้อมใช้งาน หรือเป็นรุ่นที่ความต้องการในตลาดต่ำมากจนไม่คุ้มต่อการรับซื้อ เงื่อนไขเหล่านี้ไม่ควรถูกซ่อนอยู่ท้ายหน้าแบบอ่านไม่เจอ แต่ควรถูกเขียนให้คนขายเข้าใจตั้งแต่ก่อนเริ่มประเมิน',
      'อีกกรณีหนึ่งคือการเลื่อนการปิดงานเนื่องจากข้อมูลยังไม่พร้อม เช่น ลูกค้ายังไม่ออกจาก iCloud, Apple ID, Google Account หรือระบบ MDM เรียบร้อย แม้เครื่องจะดูสภาพดีและราคาน่าสนใจ แต่หากยังมีข้อจำกัดด้านบัญชี ก็อาจทำให้ยังไม่สามารถส่งมอบได้จริง การอธิบายเงื่อนไขเรื่องนี้อย่างตรงไปตรงมาช่วยให้ลูกค้าไม่เสียเวลาเดินทางหรือนัดหมายก่อนทุกอย่างพร้อม นอกจากนี้ยังช่วยให้ลูกค้ามองการปฏิเสธรับซื้อหรือการปรับราคาในกรอบเหตุผลที่ตรวจสอบได้ มากกว่ามองว่าเป็นการเปลี่ยนแปลงโดยไม่มีที่มาที่ไป'
    ],
    list: [
      'ข้อมูลที่แจ้งไม่ตรงกับสภาพจริงของสินค้า',
      'มีระบบล็อกบัญชีหรือระบบองค์กรที่ยังถอดไม่เรียบร้อย',
      'สภาพเสียหายเกินกว่าที่ประเมินจากรูปได้ในรอบแรก',
      'อุปกรณ์ในชุดไม่ตรงกับที่แจ้งไว้ หรือขาดชิ้นสำคัญ',
      'รุ่นหรือสภาพไม่เหมาะกับการรับซื้อในช่วงเวลานั้น'
    ]
  },
  {
    heading: 'เงื่อนไขสำหรับงานหลายชิ้น งานองค์กร และสินค้าจากบริษัทควรต่างจากงานทั่วไปอย่างไร',
    paragraphs: [
      'งานหลายชิ้นหรือสินค้าจากองค์กรมีลักษณะต่างจากงานรายบุคคลอย่างชัดเจน เพราะมักมีหลายรุ่น หลายสภาพ หลายชุดอุปกรณ์ และอาจมีข้อกำหนดด้านการอนุมัติภายในเพิ่มเติม การประเมินกลุ่มนี้จึงควรเริ่มจากการจัดรายการรุ่น จำนวน สเปก และภาพตัวอย่างบางส่วนก่อน เพื่อให้ BuyHub เห็นภาพรวมและตอบได้ว่าควรวางขั้นตอนต่ออย่างไร การจะตีราคาทุกรายการจากข้อความสั้นเพียงไม่กี่บรรทัดมักทำให้ทั้งผู้ขายและผู้ประเมินเข้าใจไม่ตรงกัน หน้านี้จึงควรอธิบายให้ชัดว่ากรณีงานองค์กร การเตรียมรายการคือส่วนหนึ่งของเงื่อนไขที่ช่วยให้การประเมินเป็นระบบ',
      'นอกจากนี้เครื่องจากบริษัทหรือสำนักงานมักเกี่ยวพันกับการลบข้อมูล การปลดระบบองค์กร หรือการยืนยันสิทธิในการจำหน่าย จึงควรมีผู้ติดต่อหลักที่ตอบคำถามได้เรื่องสถานะทรัพย์สินและการส่งมอบ หากมีเอกสารประกอบภายในองค์กรก็ควรเตรียมไว้ให้พร้อมตามความเหมาะสม เงื่อนไขเฉพาะของงานกลุ่มนี้ไม่ได้มีไว้ทำให้ยุ่งยาก แต่มีไว้ให้ทุกฝ่ายเข้าใจตั้งแต่ต้นว่าการประเมินและการส่งมอบต้องอาศัยข้อมูลที่เป็นระบบมากกว่างานขายสินค้าชิ้นเดียวทั่วไป'
    ]
  },
  {
