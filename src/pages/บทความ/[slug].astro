---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyhubCta from '../../components/BuyhubCta.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { articleJsonLd, breadcrumbJsonLd, faqPageJsonLd } from '../../lib/schema';
import { relatedMoneyLinksFromText } from '../../data/primaryMoneyLinks';
export async function getStaticPaths() {
  return (await getCollection('blog', ({data}) => !data.draft)).map(entry => ({ params: {slug: entry.id} }));
}
const entry = await getEntry('blog', Astro.params.slug!);
if (!entry) throw new Error('Missing published article');
const {Content, headings} = await render(entry);
const {data} = entry;
const path = `/บทความ/${entry.id}`;
const breadcrumbs = [{name: 'หน้าแรก', href: '/'}, {name: 'บทความ', href: '/บทความ'}, {name: data.title, href: path}];
const related = relatedMoneyLinksFromText([data.title, ...(data.tags ?? [])].join(' '), 4);
const jsonLd = [breadcrumbJsonLd(breadcrumbs), articleJsonLd({headline: data.title, description: data.description, url: path, datePublished: data.pubDate.toISOString(), dateModified: (data.updatedDate ?? data.pubDate).toISOString(), author: data.author}), ...(data.faqs?.length ? [faqPageJsonLd(data.faqs)] : [])];
const fmt = new Intl.DateTimeFormat('th-TH', {dateStyle: 'long', timeZone: 'Asia/Bangkok'});
---
<BaseLayout title={data.title} description={data.description} ogType="article" breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <section class="bh-page-head"><div class="bh-wrap"><p class="bh-eyebrow">BUYHUB · คู่มือก่อนขาย</p><h1>{data.title}</h1><p>{data.description}</p><div class="bh-article-date">เผยแพร่ {fmt.format(data.pubDate)} · {data.author ?? 'ทีมงาน BuyHub'}{data.updatedDate && <span> · ปรับปรุง {fmt.format(data.updatedDate)}</span>}</div></div></section>
  <article class="bh-content bh-wrap"><div class="bh-article">{headings.some(item => item.depth === 2) && <nav class="bh-checklist-card" aria-label="สารบัญบทความ" style="margin-bottom:30px"><h2>ในบทความนี้</h2><ul>{headings.filter(item => item.depth === 2).map(item => <li><a class="bh-text-link" href={`#${item.slug}`}>{item.text}</a></li>)}</ul></nav>}<div class="markdown-content"><Content/></div><section style="margin-top:40px"><h2>บริการที่เกี่ยวข้อง</h2><div class="bh-link-list">{related.map(item => <a href={item.href}>{item.label} ↗</a>)}<a href="/รับซื้อ">ดูสินค้าที่รับซื้อทั้งหมด ↗</a></div></section></div></article>
  {data.faqs?.length ? <FaqAccordion items={data.faqs}/> : null}<BuyhubCta/>
</BaseLayout>
