---
import { getCollection } from 'astro:content';
import InfoPage from '../../components/InfoPage.astro';
const entries = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title, 'th'));
const groups = [
  { id: 'computer', title: 'คอมพิวเตอร์ โน๊ตบุ๊ค และ MacBook', match: /โน๊ตบุ๊ค|คอม|MacBook/i },
  { id: 'mobile', title: 'มือถือ แท็บเล็ต และอุปกรณ์ Apple', match: /iPhone|iPad|Samsung|แท็บเล็ต|AirPods|Watch|Pencil/i },
  { id: 'other', title: 'กล้อง เครื่องเกม และอุปกรณ์อื่น', match: /กล้อง|PlayStation|Switch|JBL|Marshall|จอคอม|การ์ดจอ|ปริ้น/i }
];
const assigned = new Set<string>();
const grouped = groups.map(group => ({...group, entries: entries.filter(entry => { if(assigned.has(entry.id) || !group.match.test(entry.data.title)) return false; assigned.add(entry.id); return true; })}));
const rest = entries.filter(entry => !assigned.has(entry.id));
---
<InfoPage path="/บทความ" title="บทความและคู่มือก่อนขายไอทีมือสอง | BuyHub" heading="หาคำตอบ ก่อนส่งเครื่องประเมิน" description="คู่มือขายสินค้าไอทีมือสอง การเตรียมข้อมูล ปัจจัยประเมินราคา และการออกจากบัญชีก่อนส่งมอบ เลือกอ่านตามสินค้าที่คุณมี">
<div class="bh-inline-links">{groups.map(group => <a href={`#${group.id}`}>{group.title}</a>)}</div>
{[...grouped, {id: 'more', title: 'คู่มือเพิ่มเติม', entries: rest}].filter(group => group.entries.length).map(group => <section id={group.id} style="scroll-margin-top:110px"><h2>{group.title}</h2><div class="bh-service-list">{group.entries.map(entry => <a href={`/บทความ/${entry.id}`}><h3>{entry.data.title} ↗</h3><p>{entry.data.description}</p></a>)}</div></section>)}
</InfoPage>
