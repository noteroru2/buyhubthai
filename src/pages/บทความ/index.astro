---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import EditorialTrustPanel from '../../components/EditorialTrustPanel.astro';
import KeywordIntentPanel from '../../components/KeywordIntentPanel.astro';
import LineCtaButton from '../../components/LineCtaButton.astro';
import LongformSections from '../../components/LongformSections.astro';
import PhoneCtaButton from '../../components/PhoneCtaButton.astro';
import { buildArticleHubKeywordCluster, joinThaiKeywordList } from '../../lib/keywordClusters';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER } from '../../lib/constants';

const entries = await getCollection('blog', ({ data }) => !data.draft);
const sorted = entries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'บทความ & คู่มือ';
const description = 'บทความจาก BuyHub แนวทางขายสินค้าไอทีมือสอง การเตรียมเครื่อง และเคล็ดลับประเมินราคาแบบโปร่งใส';

const editorialSignals = {
  scope:
    'หน้ารวมบทความของ BuyHub ใช้เป็นศูนย์รวมคำตอบก่อนเริ่มประเมินจริง ช่วยให้คนขายเลือกอ่านบทความที่ตรงกับปัญหาของตัวเองก่อนกลับไปเตรียมรูป รุ่น สเปก และข้อมูลที่จำเป็น',
  about: ['บทความ BuyHub', 'คู่มือก่อนขายสินค้า IT มือสอง', 'AEO สำหรับคำถามก่อนประเมินราคา'],
  notes: [
    'เหมาะสำหรับคนที่ยังมีคำถามย่อยก่อนเริ่มส่งรูปประเมิน เช่น เรื่องบัญชี ราคา ตำหนิ หรือการขายจากต่างจังหวัด',
    'แต่ละบทความเชื่อมกลับไปยังหน้าหมวดรับซื้อ ขั้นตอนการขาย และคู่มือเตรียมสินค้าก่อนขาย เพื่อให้การอ่านไม่หยุดอยู่แค่คำตอบสั้น',
    'หากอ่านจบแล้วพร้อมส่งข้อมูลจริง ควรกลับไปเตรียมรูปหลายมุม รุ่น สเปก ตำหนิ อุปกรณ์ในชุด และจังหวัดให้ครบ'
  ],
  links: [
    { href: '/รับซื้อ', label: 'ดูหมวดรับซื้อทั้งหมด' },
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'ดูคู่มือเตรียมสินค้าก่อนขาย' },
    { href: '/ติดต่อเรา', label: 'พร้อมแล้วไปหน้าติดต่อเรา' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: title, href: '/บทความ' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/บทความ',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  })
];

const fmt = new Intl.DateTimeFormat('th-TH', { dateStyle: 'long' });

const latestLinks = sorted.slice(0, 12).map((entry) => ({
  href: `/บทความ/${entry.id}`,
  label: entry.data.title
}));
const articleHubKeywordCluster = buildArticleHubKeywordCluster();
const articleHubKeywordLead = joinThaiKeywordList(articleHubKeywordCluster.localIntent ?? [], true);
const articleHubKeywordSupport = joinThaiKeywordList(articleHubKeywordCluster.modelIntent ?? [], true);
const articleHubKeywordQuestions = joinThaiKeywordList(articleHubKeywordCluster.issueIntent ?? [], true);

const articleHubSections = [
  {
    heading: 'บทความของ BuyHub ช่วยอะไรได้บ้างก่อนส่งรูปประเมิน',
    paragraphs: [
      'หลายคนไม่ได้ต้องการเช็กราคาอย่างเดียว แต่ยังมีคำถามก่อนขายอีกจำนวนมาก เช่น ต้องออก iCloud ไหม ถ้าเครื่องเสียจะยังขายได้หรือเปล่า หรือถ้าเป็นคอมเกมมิ่งควรส่งสเปกอะไรบ้าง หน้าบทความจึงมีหน้าที่ตอบคำถามที่เกิดก่อนการประเมินจริง เพื่อให้คนอ่านตัดสินใจได้อย่างมั่นใจมากขึ้นว่าจะเริ่มขายตอนนี้หรือควรเตรียมข้อมูลบางอย่างก่อน',
      'ในเชิง AEO บทความที่ดีควรมีคำตอบสั้น อ่านแล้วหยิบไปใช้ได้ทันที และมีคำอธิบายต่อว่าทำไมคำตอบนั้นจึงสำคัญต่อการประเมินราคาและขั้นตอนการขาย BuyHub จึงจัดหน้าบทความให้เป็นศูนย์รวมคำตอบสำหรับเคสที่คนขายสินค้า IT มือสองถามบ่อยที่สุด โดยเชื่อมโยงไปยังหน้าหมวดรับซื้อและหน้าคู่มือที่เกี่ยวข้องอย่างเป็นระบบ'
    ]
  },
  {
    heading: 'ควรเลือกอ่านบทความแบบไหนให้ตรงกับปัญหาของตัวเอง',
    paragraphs: [
      'ถ้าคุณมีคำถามเกี่ยวกับบัญชีและการล้างข้อมูล ควรเริ่มจากบทความกลุ่ม iCloud, Apple ID, Google Account หรือการรีเซ็ตเครื่องก่อน เพราะคำถามเหล่านี้มีผลโดยตรงต่อความพร้อมในการส่งมอบสินค้า ส่วนถ้าสงสัยเรื่องราคา ควรอ่านบทความแนว “ขายได้ราคาเท่าไหร่” หรือบทความที่อธิบายปัจจัยราคาของสินค้าประเภทนั้นโดยตรง',
      'สำหรับคนที่มีสินค้ามีตำหนิหรือเสียบางจุด เช่น แบตเสื่อม จอมีรอย หรือเครื่องไม่สมบูรณ์ บทความแนวเคสเฉพาะจะช่วยให้มองเห็นความเป็นไปได้และสิ่งที่ควรแจ้งเพิ่มเติมได้ชัดกว่าอ่านบทความทั่วไป หน้าบทความรวมจึงควรทำหน้าที่เหมือนแผงคำตอบที่จัดตามปัญหา ไม่ใช่เพียงลิสต์บทความล่าสุดอย่างเดียว'
    ],
    list: [
      'กังวลเรื่องบัญชี/ข้อมูลส่วนตัว: อ่านบทความเรื่อง iCloud, Apple ID, Google Account และการล้างข้อมูล',
      'อยากรู้ราคาก่อนขาย: อ่านบทความแนวประเมินราคาและปัจจัยราคา',
      'เครื่องมีตำหนิหรือเสีย: อ่านบทความเคสเครื่องเสีย แบตเสื่อม หรือมีข้อจำกัดเฉพาะ',
      'มีหลายชิ้นจากบริษัท: อ่านบทความเรื่องการขายคอมบริษัทหรือรายการอุปกรณ์จำนวนมาก'
    ]
  },
  {
    heading: 'ทำไมบทความเหล่านี้จึงช่วยทั้ง SEO และการใช้งานจริง',
    paragraphs: [
      'บทความที่ตอบคำถามจากสถานการณ์จริง เช่น “ขาย iPhone ต้องออก iCloud ไหม” หรือ “ขายโน๊ตบุ๊คต้องล้างข้อมูลไหม” มักตรงกับสิ่งที่คนค้นหาในช่วงก่อนตัดสินใจมากกว่าคำค้นกว้าง ๆ อย่าง “รับซื้อไอที” เพียงอย่างเดียว การมีบทความลักษณะนี้จำนวนพอดีและเชื่อมต่อไปยังหน้าบริการ จึงช่วยให้เว็บครอบคลุมเส้นทางของผู้ใช้ตั้งแต่หาคำตอบ ไปจนถึงพร้อมส่งรูปประเมิน',
      'ในทางปฏิบัติ บทความยังช่วยลดภาระของการตอบคำถามซ้ำในแชท เพราะลูกค้าหลายคนอ่านบทความก่อนแล้วเข้าใจพื้นฐานของตัวเองดีขึ้น เมื่อทักเข้ามาจึงส่งข้อมูลได้ครบและถามคำถามได้เฉพาะเจาะจงกว่าเดิม นี่คือเหตุผลที่บทความเชิง AEO ไม่ใช่เพียงส่วนเสริมของ SEO แต่เป็นเครื่องมือช่วยให้ทั้งคอนเทนต์และการทำงานหน้าบ้านมีประสิทธิภาพขึ้นพร้อมกัน'
    ],
    links: latestLinks
  },
  {
    heading: 'อ่านจบแล้วควรทำอะไรต่อเพื่อให้การประเมินเดินหน้าได้ทันที',
    paragraphs: [
      'เมื่อได้คำตอบจากบทความที่ตรงกับเคสของตัวเองแล้ว ขั้นต่อไปที่ดีที่สุดคือกลับไปเตรียมข้อมูลสำหรับการประเมินจริง ได้แก่ รูปหลายมุม รุ่น สเปก ความจุ สภาพการใช้งาน อุปกรณ์ในชุด และพื้นที่ที่อยู่ ถ้าบทความที่คุณอ่านเกี่ยวข้องกับการล้างข้อมูลหรือการออกจากบัญชี ก็อาจทำตามเช็กลิสต์ในบทความนั้นก่อน แล้วค่อยส่งรูปประเมินเพื่อให้คำตอบนิ่งขึ้น',
      'หน้ารวมบทความจึงควรช่วยให้ผู้อ่านไปต่อได้ง่าย ไม่ใช่อ่านจบแล้วจบเลย ถ้ารู้ว่าควรกลับไปหน้าหมวดรับซื้อไหน ควรอ่านคู่มืออะไรเพิ่ม หรือควรเริ่มคุยกับทีมงานทันที ก็จะช่วยให้บทความบนเว็บไซต์ไม่ได้เป็นเพียงเนื้อหาสำหรับทราฟฟิก แต่เป็นคอนเทนต์ที่ผลักผู้ใช้ไปสู่การใช้งานจริงอย่างมีคุณภาพ'
    ],
    links: [
      { href: '/รับซื้อ', label: 'ไปหน้าหมวดรับซื้อทั้งหมด' },
      { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'อ่านคู่มือเตรียมสินค้าก่อนขาย' },
      { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขายทั้งหมด' },
      { href: '/คำถามที่พบบ่อย', label: 'ดูคำถามที่พบบ่อย' }
    ]
  }
];

articleHubSections.push(
  {
    heading: 'บทความควรทำหน้าที่เชื่อมจากคำถามเล็ก ๆ ไปสู่การตัดสินใจขายจริงอย่างไร',
    paragraphs: [
      'คนจำนวนมากไม่ได้เริ่มจากการพิมพ์คำค้นกว้างอย่าง “รับซื้อไอทีมือสอง” แต่เริ่มจากคำถามเล็ก ๆ ที่อยู่ใกล้การตัดสินใจมากกว่า เช่น ต้องออก iCloud ไหม เครื่องเสียยังขายได้ไหม หรือถ้าจะขายคอมเกมมิ่งต้องส่งสเปกอะไรบ้าง หน้าศูนย์รวมบทความของ BuyHub จึงควรช่วยให้ผู้อ่านเห็นว่าแต่ละบทความเป็นชิ้นส่วนของเส้นทางเดียวกัน คือเส้นทางจากความไม่แน่ใจไปสู่ความพร้อมในการประเมินจริง ไม่ใช่บทความที่แยกกันอยู่โดยไม่มีความหมายร่วม',
      'เมื่อผู้อ่านเข้าใจว่าบทความแต่ละชิ้นตอบคำถามระดับใด เขาก็จะเลือกอ่านต่อได้อย่างมีทิศทางมากขึ้น เช่น ถ้าติดเรื่องบัญชีหรือข้อมูลส่วนตัวก็ควรไปสายบทความเตรียมเครื่อง ถ้าติดเรื่องราคาให้ไปสายบทความประเมินราคา และถ้าสินค้ามีข้อจำกัดเฉพาะก็ให้ดูบทความเฉพาะเคส การอธิบายหน้าที่ของหน้าศูนย์รวมบทความในมุมนี้ช่วยให้หน้านี้กลายเป็นแผนที่นำทางมากกว่าหน้ารวมโพสต์ธรรมดา'
    ]
  },
  {
    heading: 'อ่านบทความจบแล้ว ควรย้อนกลับไปทำอะไรบ้างก่อนเริ่มประเมินจริง',
    paragraphs: [
      'บทความที่ดีไม่ควรทำให้ผู้อ่านจบที่การรับรู้คำตอบ แต่ควรพาไปสู่การลงมือทำที่เกี่ยวข้อง เช่น ถ้าอ่านบทความเรื่องออกจาก iCloud แล้วเข้าใจแล้ว ก็ต้องกลับไปจัดการที่เครื่องให้เรียบร้อย ถ้าอ่านบทความเรื่องขายคอมเกมมิ่งแล้วรู้ว่าต้องมีสเปก ก็ต้องกลับไปเช็ก CPU, GPU, RAM และ SSD ให้ชัด หรือถ้าอ่านบทความเรื่องขายจากต่างจังหวัดได้ไหม ก็ควรกลับไปเตรียมข้อมูลพื้นที่พร้อมรูปสินค้าไว้สำหรับการคุยครั้งแรก การสรุปทางออกหลังอ่านบทความคือสิ่งที่ทำให้หน้าศูนย์รวมบทความมีพลังมากขึ้นในเชิง AEO',
      'สำหรับ BuyHub การมีหน้ารวมบทความที่ชี้เส้นทางกลับไปยังหน้าคู่มือ ขั้นตอนการขาย และหน้ารับซื้อรายหมวดอย่างชัดเจน จะช่วยให้ผู้อ่านไม่หลงอยู่ในชั้นของการอ่านอย่างเดียว แต่ขยับไปสู่การประเมินจริงได้รวดเร็วขึ้น ซึ่งมีคุณค่าทั้งกับผู้ใช้และกับเป้าหมายของเว็บไซต์ในภาพรวม'
    ],
    links: [
      { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'กลับไปดูคู่มือเตรียมเครื่องก่อนขาย' },
      { href: '/รับซื้อ', label: 'กลับไปดูหมวดรับซื้อที่ตรงกับสินค้า' },
      { href: '/ติดต่อเรา', label: 'พร้อมแล้วไปหน้าติดต่อเพื่อส่งข้อมูลประเมิน' }
    ]
  }
);

articleHubSections.push(
  {
    heading: 'บทความที่ดีควรต่อยอดจากการอ่านไปสู่การเตรียมข้อมูลและการประเมินอย่างไร',
    paragraphs: [
      'เป้าหมายของหน้าศูนย์รวมบทความไม่ควรหยุดอยู่แค่การรวบรวมคำตอบจำนวนมาก แต่ควรทำให้ผู้อ่านเห็นชัดว่าหลังจากได้คำตอบจากบทความหนึ่งแล้วต้องกลับไปเตรียมอะไร เช่น ถ้าอ่านเรื่อง iCloud หรือการล้างข้อมูล ก็ควรไปจัดการที่ตัวเครื่องก่อน ถ้าอ่านเรื่องปัจจัยราคา ก็ควรกลับไปถ่ายรูปและรวบรวมสเปกให้ครบ หรือถ้าอ่านเรื่องขายจากต่างจังหวัด ก็ควรเตรียมข้อมูลพื้นที่ให้พร้อมก่อนเริ่มทักประเมิน หน้ารวมบทความที่สรุปเส้นทางแบบนี้จะช่วยให้การอ่านเชื่อมกับการลงมือทำจริง',
      'ในด้าน SEO และ AEO การทำให้หน้ารวมบทความบอกเส้นทางถัดไปอย่างชัดเจนยังช่วยให้ทั้งคนอ่านและระบบค้นหาเข้าใจว่าบทความแต่ละชิ้นไม่ใช่ปลายทางแยกเดี่ยว แต่เป็นส่วนหนึ่งของประสบการณ์เว็บทั้งหมดของ BuyHub ซึ่งพาผู้ใช้จากคำถามเล็ก ๆ ไปสู่การเตรียมตัวและการขายจริงได้เป็นลำดับ'
    ],
    orderedList: [
      'อ่านบทความที่ตรงกับปัญหาของตัวเองให้จบ',
      'กลับไปจัดการหรือเตรียมข้อมูลที่บทความแนะนำ',
      'รวบรวมรูป รุ่น สเปก สภาพ และพื้นที่ให้ครบ',
      'เริ่มส่งข้อมูลประเมินเมื่อพร้อมบนฐานข้อมูลที่ชัดกว่าเดิม'
    ]
  }
);
articleHubSections.push({
  heading: 'บทความที่ดีควรช่วยให้คนอ่านกลับไปเตรียมข้อมูลสำหรับการประเมินได้ดีขึ้นอย่างไร',
  paragraphs: [
    'เมื่ออ่านบทความใดบทความหนึ่งจบแล้ว คนขายไม่ควรได้เพียงคำตอบว่า “ทำได้” หรือ “ควรทำ” เท่านั้น แต่ควรกลับไปเตรียมข้อมูลได้ดีขึ้นจริง เช่น ถ้าเพิ่งอ่านเรื่องปัจจัยราคา ก็ควรรู้ว่าครั้งต่อไปที่ทักประเมินควรแนบรูปมุมไหน บอกรุ่นหรือสเปกส่วนใด และแจ้งตำหนิอย่างไรให้คำตอบแม่นขึ้น หรือถ้าเพิ่งอ่านเรื่องการออกจากบัญชี ก็ควรรู้ว่าต้องกลับไปเช็กที่ตัวเครื่องจุดไหนก่อนถึงจะพร้อมขายจริง การเพิ่มบทสรุปลักษณะนี้ในหน้าศูนย์รวมบทความช่วยให้หน้าไม่ได้เป็นเพียงแค่อินเด็กซ์โพสต์ แต่เป็นหน้าที่พาผู้อ่านจากความเข้าใจไปสู่การลงมือทำอย่างเป็นขั้นตอน',
    'ในเชิง AEO และ conversion ประโยชน์ของหน้ารวมบทความไม่ได้อยู่ที่จำนวนโพสต์มากอย่างเดียว แต่อยู่ที่การช่วยให้ผู้อ่าน “เลือกเรื่องถัดไปได้ถูก” และ “รู้ว่าต้องทำอะไรต่อ” หลังจากอ่านจบ การสรุปแนวคิดนี้ช่วยให้ทั้งคนอ่านและระบบค้นหาเห็นว่าบทความของ BuyHub แต่ละชิ้นมีบทบาทเชื่อมกัน ไม่ได้แยกเป็นเนื้อหากระจัดกระจาย แต่ร่วมกันตอบคำถามก่อนขายและพาไปสู่หน้าหมวดรับซื้อ หน้าคู่มือ และหน้าติดต่อได้อย่างมีทิศทาง'
  ],
  links: [
    { href: '/รับซื้อ', label: 'กลับไปดูหมวดรับซื้อที่ตรงกับสินค้า' },
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'กลับไปดูคู่มือเตรียมสินค้าก่อนขาย' },
    { href: '/ติดต่อเรา', label: 'เตรียมพร้อมแล้วไปหน้าติดต่อเรา' }
  ]
});

articleHubSections.push({
  heading: 'ถ้ายังไม่แน่ใจว่าจะอ่านบทความไหนต่อ ให้แยกตามปัญหาที่กำลังติดอยู่',
  paragraphs: [
    'หลายครั้งคนอ่านไม่ได้เริ่มจากความตั้งใจจะอ่านเนื้อหายาว แต่เริ่มจากคำถามเล็ก ๆ ที่อยากเคลียร์ก่อน เช่น ต้องออกจากบัญชีไหม เครื่องมีตำหนิยังขายได้หรือเปล่า หรือถ้ามีหลายชิ้นจากร้านและสำนักงานควรเริ่มส่งข้อมูลแบบไหน หน้า “บทความ” ที่ดีจึงควรช่วยจัดทางเลือกให้เห็นว่าแต่ละคำถามควรไปต่อที่บทความแนวไหน เพื่อไม่ให้คนอ่านต้องเปิดหลายหน้าแบบเดาสุ่มก่อนจะเจอคำตอบที่ตรงที่สุด',
    'สำหรับ BuyHub วิธีคิดแบบนี้ยังช่วยเชื่อมบทความกับหน้าหมวดรับซื้อและหน้าคู่มือได้ชัดขึ้นด้วย เพราะเมื่อคนอ่านรู้ว่าปัญหาหลักของตัวเองคืออะไร ก็จะกลับไปเตรียมข้อมูลได้ตรงจุดกว่าเดิม เช่น ถ้าติดเรื่องบัญชีหรือการล้างข้อมูลก็ไปต่อที่บทความเชิงเตรียมเครื่อง แต่ถ้าติดเรื่องมูลค่าและความคุ้มก็ขยับไปหน้าหมวดรับซื้อของสินค้านั้นเพื่อประเมินตามรุ่นและสภาพจริง การจัดเส้นทางอ่านแบบนี้ทำให้หน้าศูนย์รวมบทความมีบทบาททั้งด้าน AEO และการพาคนอ่านไปสู่การลงมือขายจริง'
  ],
  orderedList: [
    'ถ้าติดเรื่องบัญชี ข้อมูล หรือการรีเซ็ตเครื่อง ให้เริ่มจากบทความแนวเตรียมเครื่องก่อน',
    'ถ้าติดเรื่องช่วงราคา ความคุ้ม หรือเครื่องมีตำหนิ ให้มองหาบทความที่อธิบายปัจจัยราคาและเคสเฉพาะ',
    'ถ้าเป็นงานหลายชิ้นจากร้านหรือสำนักงาน ให้เลือกบทความที่ช่วยจัดรูปแบบการสรุปรายการก่อนส่งประเมิน',
    'เมื่อได้คำตอบแล้ว ให้กลับไปหน้าหมวดรับซื้อหรือหน้าติดต่อเพื่อส่งข้อมูลในรอบเดียวให้ครบขึ้น'
  ],
  links: latestLinks.slice(0, 4)
});
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'หน้าแรก', href: '/' },
    { name: title, href: '/บทความ' }
  ]}
>
  <article class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-16">
      <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">บทความ & คู่มือ</h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">
        รวมแนวทางสำหรับผู้ขายสินค้าไอที — อ่านจบแล้วส่งรูประเมินเบื้องต้นทาง LINE @buyhub ได้ทันที
      </p>
      <div class="mt-10 max-w-3xl">
        <EditorialTrustPanel
          reviewedAt={EDITORIAL_REVIEWED_AT}
          reviewedBy={EDITORIAL_REVIEWER}
          scope={editorialSignals.scope}
          notes={[...editorialSignals.notes]}
          links={[...editorialSignals.links]}
        />
      </div>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row">
        <LineCtaButton variant="primary" label="อ่านจบแล้วส่งรูปเช็กราคาทาง LINE" />
        <PhoneCtaButton variant="light" />
      </div>
      <KeywordIntentPanel
        sectionId="article-hub-keywords"
        title="คำค้นหลักและคำค้นรองที่หน้าศูนย์รวมบทความตั้งใจตอบ"
        className="mt-12"
        intro={[
          `หน้านี้ถูกวางให้ตอบคำค้นหลักอย่าง “${articleHubKeywordCluster.primary}” พร้อมคำค้นรองอย่าง ${articleHubKeywordLead} เพื่อให้คนที่กำลังหาคำตอบก่อนขายจริงเจอจุดเริ่มต้นที่ตรงปัญหาได้เร็วขึ้น`,
          `ถ้าคุณกำลังค้นหาทั้ง ${articleHubKeywordSupport || 'คำค้นจากบทความสำคัญของเว็บ'} และ ${articleHubKeywordQuestions || 'คำถามย่อยก่อนประเมินราคา'} หน้านี้จะช่วยเชื่อมจากคำถามเล็ก ๆ ไปสู่บทความที่ตรงกับสถานการณ์ขายของคุณมากที่สุด`
        ]}
        groups={[
          {
            title: 'คำค้นก่อนเลือกอ่านบทความ',
            blurb: 'เหมาะกับคนที่รู้แค่ว่ายังมีคำถามก่อนขาย แต่ยังไม่รู้ว่าควรเริ่มอ่านเรื่องไหนก่อน',
            items: articleHubKeywordCluster.localIntent ?? []
          },
          {
            title: 'คำค้นจากบทความหลักที่คนมักค้นหาตรง ๆ',
            blurb: 'กลุ่มนี้ครอบคลุมบทความที่มี intent สูง เช่น iCloud, Apple ID, สเปกคอมเกมมิ่ง และงานคอมบริษัท',
            items: articleHubKeywordCluster.modelIntent ?? []
          },
          {
            title: 'คำค้นคำถามย่อยก่อนเริ่มประเมินราคา',
            blurb: 'ช่วยตอบคำถามต่อเนื่องเรื่องเครื่องเสีย อุปกรณ์ไม่ครบ การล้างข้อมูล และการเตรียมตัวก่อนขาย',
            items: articleHubKeywordCluster.issueIntent ?? []
          }
        ]}
      />

      <section class="mt-16" aria-labelledby="posts-list">
        <h2 id="posts-list" class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
          บทความล่าสุด
        </h2>
        <ul class="mt-8 divide-y divide-slate-200 border-t border-slate-200">
          {
            sorted.length ? (
              sorted.map((e) => (
                <li class="py-8">
                  <a href={`/บทความ/${e.id}`} class="group block">
                    <time class="text-sm font-semibold text-emerald-700" datetime={e.data.pubDate.toISOString()}>
                      {fmt.format(e.data.pubDate)}
                    </time>
                    <h3 class="mt-2 text-xl font-bold tracking-tight text-slate-950 group-hover:text-emerald-700">{e.data.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">{e.data.description}</p>
                    <span class="mt-3 inline-block text-sm font-semibold text-emerald-700">อ่านบทความ →</span>
                  </a>
                </li>
              ))
            ) : (
              <li class="py-10 text-base leading-8 text-slate-600">
                กำลังเตรียมบทความใหม่ — ระหว่างนี้แนะนำให้ดูหน้า <a class="font-semibold text-emerald-700 underline decoration-emerald-500/35 underline-offset-4 hover:text-emerald-800" href="/ขั้นตอนการขาย">ขั้นตอนการขาย</a> หรือส่งรูปประเมินราคาทาง LINE @buyhub ได้เลย
              </li>
            )
          }
        </ul>
      </section>

      <LongformSections sections={articleHubSections} tocHeading="หัวข้อสำคัญสำหรับหน้าบทความ BuyHub" />
    </div>
  </article>
  <CtaBand
    heading="อ่านจบแล้วอยากเช็กราคาเครื่องตัวเอง?"
    sub="ส่งรูปและรุ่นทาง LINE @buyhub ทีมงานช่วยประเมินเบื้องต้นให้ก่อนคุณตัดสินใจขาย"
    lineLabel="ส่งรูปเช็กราคาหลังอ่านบทความ"
  />
</BaseLayout>
