  paragraphs: [
    'ในสถานการณ์จริง บางคนเจอของอยู่ต่างสถานที่ บางคนกำลังรวมของจากหลายห้องหรือหลายสาขา และบางคนยังไม่มีเวลาถ่ายรูปทุกมุมในทันที หน้าติดต่อที่ดีจึงควรบอกให้ชัดว่าการเริ่มต้นไม่จำเป็นต้องสมบูรณ์แบบร้อยเปอร์เซ็นต์ตั้งแต่นาทีแรก แต่ควรเริ่มด้วยข้อมูลแกนหลักที่ช่วยให้ทีมงานเข้าใจภาพรวมก่อน เช่น สินค้าเป็นอะไร มีประมาณกี่ชิ้น รุ่นหรือสเปกโดยคร่าวคืออะไร สภาพโดยรวมประมาณไหน และอยู่จังหวัดใด จากนั้นค่อยทยอยเพิ่มรูปและรายละเอียดที่ขาดในบทสนทนาเดิม วิธีนี้ดีกว่าการรอจนพร้อมทุกอย่างแล้วค่อยเริ่ม เพราะอย่างน้อยคุณจะได้รู้ก่อนว่าควรเก็บข้อมูลส่วนไหนเพิ่มเพื่อให้การประเมินใกล้เคียงขึ้น',
    'การอธิบายแนวทางนี้ไว้บนหน้าติดต่อช่วยให้ผู้ใช้ไม่รู้สึกว่าถ้าเริ่มต้นไม่ครบจะทำอะไรต่อไม่ได้ อีกทั้งยังส่งผลดีต่อคุณภาพ lead เพราะทีมงานจะมองเห็นได้ตั้งแต่ต้นว่างานนั้นเป็นสินค้าชิ้นเดียว หลายชิ้น หรืองานองค์กรที่ต้องวางลำดับการเก็บข้อมูลต่อ ในเชิง AEO คำตอบลักษณะนี้ยังตอบ intent ที่พบบ่อยมากของคนขายคือ “ถ้ายังไม่พร้อมเต็มที่ เริ่มถามก่อนได้ไหม” ซึ่งเป็นคำถามที่มักเกิดก่อนการติดต่อจริงเสมอ'
  ],
  orderedList: [
    'เริ่มจากแจ้งประเภทสินค้า จำนวน และจังหวัดก่อน',
    'บอกรุ่นหรือสเปกโดยคร่าวเท่าที่ทราบ',
    'แนบรูปตัวอย่างชุดแรกเท่าที่สะดวกก่อน แล้วค่อยเพิ่มภายหลัง',
    'อัปเดตข้อมูลเพิ่มในบทสนทนาเดิมเพื่อให้ตามเรื่องง่าย'
  ]
});

---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'หน้าแรก', href: '/' },
    { name: 'ติดต่อเรา', href: '/ติดต่อเรา' }
  ]}
>
  <article class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-16">
      <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">ติดต่อ BuyHub</h1>
      <p class="mt-5 text-base leading-8 text-slate-700">
        ช่องทางหลักในการประเมินราคาและติดต่อ BuyHub คือ <span class="font-semibold text-slate-950">LINE {LINE_AT}</span>
        — ส่งรูปสินค้า รุ่น สเปก สภาพเครื่อง และจังหวัดที่อยู่ เพื่อให้ทีมงานประเมินราคาเบื้องต้นได้ฟรี
      </p>
      <div class="mt-10 max-w-3xl">
        <EditorialTrustPanel
          reviewedAt={EDITORIAL_REVIEWED_AT}
          reviewedBy={EDITORIAL_REVIEWER}
          scope={editorialSignals.scope}
          notes={[...editorialSignals.notes]}
          links={[...editorialSignals.links]}
        />
      </div>

      <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50/80 p-6">
        <p class="text-sm font-semibold text-slate-950">เวลาติดต่อ</p>
        <p class="mt-2 text-sm leading-7 text-slate-600">{BUSINESS_HOURS_SHORT}</p>
        <p class="mt-3 text-xs leading-6 text-slate-500">แนะนำทัก LINE ก่อนนัด เพื่อยืนยันคิวและพื้นที่ให้บริการล่าสุด</p>
      </div>

      <div class="mt-10 rounded-3xl border-2 border-emerald-500/35 bg-gradient-to-br from-emerald-500/[0.07] via-white to-amber-50/40 p-8 shadow-lg shadow-emerald-950/[0.06] ring-1 ring-emerald-500/15">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-800">แนะนำ</p>
        <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-950 sm:text-2xl">ส่งรูปประเมินได้ทันทีทาง LINE</h2>
        <p class="mt-3 text-base leading-8 text-slate-700">
          กดปุ่มด้านล่างเพื่อเปิด LINE แล้วแนบรูปกับรุ่นตาม checklist — จะได้คำตอบเร็วและใกล้ความจริงมากขึ้น
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-stretch sm:gap-4">
          <LineCtaButton
            variant="primary"
            label={`ส่งรูปประเมินราคาฟรี — LINE ${LINE_AT}`}
            class="w-full justify-center shadow-emerald-500/30 sm:flex-1 sm:px-10 sm:py-4"
          />
          <PhoneCtaButton variant="light" class="w-full justify-center sm:flex-1" />
        </div>
        <p class="mt-4 text-xs leading-relaxed text-slate-600">
          ลิงก์:
          <a
            href={LINE_URL}
            class="break-all font-medium text-emerald-800 underline underline-offset-2 hover:text-emerald-700"
            target="_blank"
            rel="noopener noreferrer"
          >
            {LINE_URL}
          </a>
        </p>
        <p class="mt-3 text-xs leading-relaxed text-slate-600">
          โทร:
          <a href={`tel:${PHONE_E164}`} class="font-semibold text-slate-950 underline decoration-slate-300 underline-offset-2 hover:text-emerald-800">
            {PHONE_DISPLAY}
          </a>
        </p>
      </div>

      <section class="mt-12" aria-labelledby="eval-checklist">
        <h2 id="eval-checklist" class="text-xl font-bold tracking-tight text-slate-950 sm:text-2xl">
          ส่งข้อมูลเหล่านี้เพื่อประเมินราคาไวขึ้น
        </h2>
        <ul class="mt-6 space-y-4">
          {
            evalChecklist.map((item) => (
              <li class="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50/80 p-5">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white" aria-hidden="true">
                  ✓
                </span>
                <div>
                  <p class="font-semibold text-slate-950">{item.t}</p>
                  <p class="mt-1 text-sm leading-6 text-slate-600">{item.d}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="fast-start">
        <h2 id="fast-start" class="text-xl font-bold tracking-tight text-slate-950 sm:text-2xl">
          ถ้าไม่แน่ใจจะเริ่มยังไง (ทางลัด)
        </h2>
        <p class="mt-3 text-base leading-8 text-slate-700">
          1) เลือกหมวดใกล้เคียงจากหน้า <a class="font-semibold text-emerald-700 hover:underline" href="/รับซื้อ">รับซื้อสินค้าไอทีมือสอง</a> 2) ส่งรูปตาม checklist
          3) ทีมงานตอบแนวราคาและคิวรับ/ส่งมอบให้ก่อนคุณตัดสินใจ
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/คู่มือเตรียมสินค้าก่อนขาย">
            คู่มือเตรียมสินค้าก่อนขาย →
          </a>
          <a class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/คำถามที่พบบ่อย">
            คำถามที่พบบ่อย →
          </a>
        </div>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          บทความที่คนอ่านบ่อย: {' '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/บทความ/ขาย-iphone-ต้องออก-icloud-ไหม">ขาย iPhone ต้องออก iCloud ไหม</a>
          {' · '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/บทความ/ขาย-ipad-ต้องเตรียมอะไรบ้าง">ขาย iPad ต้องเตรียมอะไรบ้าง</a>
          {' · '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/บทความ/ขายโน๊ตบุ๊คต้องล้างข้อมูลไหม">ขายโน๊ตบุ๊คต้องล้างข้อมูลไหม</a>
        </p>
      </section>

      <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="trust-links">
        <h2 id="trust-links" class="text-xl font-bold tracking-tight text-slate-950 sm:text-2xl">ดูความน่าเชื่อถือก่อนตัดสินใจ</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          หากอยากดูตัวอย่างงานและคำตอบเพิ่มเติม แนะนำ 3 หน้านี้:
        </p>
        <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
          <li>
            <a class="block rounded-xl border border-slate-200 bg-slate-50/70 p-4 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/รีวิวลูกค้า">
              รีวิวลูกค้า →
            </a>
          </li>
          <li>
            <a class="block rounded-xl border border-slate-200 bg-slate-50/70 p-4 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/ผลงานรับซื้อจริง">
              ผลงานรับซื้อจริง →
            </a>
          </li>
          <li>
            <a class="block rounded-xl border border-slate-200 bg-slate-50/70 p-4 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/คำถามที่พบบ่อย">
              คำถามที่พบบ่อย →
            </a>
          </li>
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="contact-faqs">
        <h2 id="contact-faqs" class="text-xl font-bold tracking-tight text-slate-950 sm:text-2xl">คำถามที่พบบ่อยเรื่องการติดต่อและการประเมินราคา</h2>
        <div class="mt-5">
          <FaqAccordion items={contactFaqs} />
        </div>
      </section>

      <LongformSections sections={contactSections} tocHeading="หัวข้อสำคัญสำหรับหน้าติดต่อ BuyHub" />
    </div>
  </article>
  <CtaBand
    heading="อยากรู้ราคาสินค้าของคุณ?"
    sub={`ส่งรูปสินค้าให้ BuyHub ประเมินราคาฟรี รู้ราคาก่อนตัดสินใจขาย — ทัก LINE ${LINE_AT} หรือโทร ${PHONE_DISPLAY}`}
    lineLabel="ส่งรูปประเมินราคาฟรีทาง LINE"
  />
</BaseLayout>
