---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineCtaButton from '../components/LineCtaButton.astro';
import PhoneCtaButton from '../components/PhoneCtaButton.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import { BUSINESS_HOURS_SHORT, EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER, LINE_AT, LINE_URL, PHONE_DISPLAY, PHONE_E164 } from '../lib/constants';
import FaqAccordion from '../components/FaqAccordion.astro';
import LongformSections from '../components/LongformSections.astro';
import { breadcrumbJsonLd, faqPageJsonLd, webPageJsonLd } from '../lib/schema';

const title = 'ติดต่อ BuyHub ประเมินราคาสินค้า IT มือสองฟรี';
const description =
  `ติดต่อ BuyHub เพื่อประเมินราคาสินค้าไอทีมือสองฟรี แอด LINE ${LINE_AT} หรือโทร ${PHONE_DISPLAY} ส่งรูปสินค้าเพื่อเช็กราคาได้ทันที`;

const evalChecklist = [
  { t: 'รูปตัวเครื่อง', d: 'ด้านหน้า/ด้านหลัง/มุม/ตำหนิ ถ้ามี' },
  { t: 'รุ่นสินค้า', d: 'รุ่นเต็มหรือโค้ดรุ่นที่มองเห็นได้' },
  { t: 'สเปก', d: 'CPU/RAM/ความจุ หรือความจุเครื่อง (มือถือ/แท็บเล็ต)' },
  { t: 'สภาพ / ตำหนิ', d: 'หน้าจอ แบต ประวัติซ่อม การใช้งานปกติไหม' },
  { t: 'อุปกรณ์ที่มี', d: 'กล่อง สายชาร์จ หัวชาร์จ ใบเสร็จ (ถ้ามี)' },
  { t: 'จังหวัดที่อยู่', d: 'ช่วยประเมินคิวรับ/รูปแบบการส่งมอบได้ตรงขึ้น' },
  { t: 'ราคาที่ต้องการขาย', d: 'ถ้ามี — ใช้เทียบแนวทางตลาดและช่วยสื่อสารเร็วขึ้น' }
] as const;

const contactFaqs = [
  {
    question: 'ประเมินราคาฟรีไหม',
    answer: `ฟรี คุณสามารถส่งรูปและข้อมูลเบื้องต้นผ่าน LINE ${LINE_AT} เพื่อรับแนวราคาก่อนตัดสินใจขาย`
  },
  {
    question: 'ต้องส่งข้อมูลอะไรให้ประเมินไวที่สุด',
    answer:
      'รูปหลายมุม (รวมตำหนิ) + รุ่น/สเปกหรือความจุ + สุขภาพแบต (ถ้าดูได้) + อุปกรณ์ในชุด และจังหวัด/พื้นที่'
  },
  {
    question: 'ยังไม่อยากล้างข้อมูล ส่งมาประเมินได้ไหม',
    answer:
      'ได้ ส่งมาประเมินเบื้องต้นได้ก่อน แต่ก่อนส่งมอบแนะนำสำรองและลบข้อมูลส่วนตัว รวมถึงออกจากบัญชีที่ผูกไว้ เพื่อความปลอดภัย'
  },
  {
    question: 'อยู่ต่างจังหวัดขายได้ไหม',
    answer:
      'ได้ แจ้งจังหวัด/อำเภอเพื่อคุยรูปแบบการส่งมอบและคิวให้เหมาะสม (BuyHub ให้บริการหลายจังหวัดในภาคอีสานและพื้นที่ใกล้เคียง)'
  },
  {
    question: 'ราคาประเมินกับราคาจริงต่างกันไหม',
    answer:
      'ราคาประเมินเป็นแนวทางจากรูป/ข้อมูล ราคาสุดท้ายคอนเฟิร์มหลังตรวจสภาพจริง หากข้อมูลตรงกันราคามักใกล้เคียงเดิม และจะแจ้งเหตุผลก่อนปรับราคาเสมอ'
  }
] as const;

const editorialSignals = {
  scope:
    'หน้าติดต่อรวบรวมช่องทางเริ่มประเมินราคากับ BuyHub พร้อม checklist ข้อมูลที่ควรส่งในข้อความแรก และแนวทางสำหรับคนที่อยู่ต่างจังหวัดในภาคอีสาน',
  about: ['ติดต่อ BuyHub', 'ส่งข้อมูลประเมินราคาผ่าน LINE', 'ช่องทางเริ่มขายสินค้า IT มือสอง'],
  notes: [
    'เหมาะสำหรับคนที่พร้อมเริ่มส่งรูปสินค้าแล้ว แต่ยังไม่แน่ใจว่าควรทักอย่างไรให้ได้คำตอบเร็วที่สุด',
    'LINE เป็นช่องทางหลักสำหรับการประเมินราคาเพราะแนบรูป รุ่น สเปก และตำหนิได้ครบในรอบเดียว',
    'หากอยู่ต่างจังหวัดหรือมีหลายชิ้น ควรแจ้งจังหวัด อำเภอ และจำนวนสินค้าพร้อมกันตั้งแต่ข้อความแรก'
  ],
  links: [
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'ดูคู่มือเตรียมสินค้าก่อนขาย' },
    { href: '/พื้นที่ให้บริการ', label: 'ดูพื้นที่ให้บริการ' },
    { href: '/รีวิวลูกค้า', label: 'ดูรีวิวลูกค้า' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: 'ติดต่อเรา', href: '/ติดต่อเรา' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/ติดต่อเรา',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  faqPageJsonLd([...contactFaqs])
];

const contactSections = [
  {
    heading: 'หน้าติดต่อที่ดีควรตอบอะไรได้บ้างก่อนที่ลูกค้าจะทักจริง',
    paragraphs: [
      'หน้าติดต่อที่ดีไม่ควรมีแค่ปุ่มให้กดหรือเบอร์โทรเท่านั้น แต่ควรตอบคำถามพื้นฐานที่ทำให้คนตัดสินใจเริ่มคุยได้ง่ายขึ้น เช่น ควรติดต่อผ่านช่องทางไหน ส่งอะไรไปก่อนถึงจะประเมินได้ไว เวลาให้บริการเป็นอย่างไร และถ้าอยู่ต่างจังหวัดในภาคอีสานยังสามารถเริ่มต้นประเมินได้หรือไม่',
      'โดยเฉพาะบริการรับซื้อสินค้า IT มือสอง การติดต่อครั้งแรกมีผลมากต่อความรู้สึกของผู้ขาย ถ้าหน้านี้ช่วยให้คนอ่านรู้ว่าควรเตรียมอะไรบ้างก่อนกด LINE หรือโทรออก ก็จะลดความกังวลและช่วยให้การสนทนารอบแรกมีคุณภาพมากขึ้นทันที'
    ]
  },
  {
    heading: 'ควรทัก LINE หรือโทร เมื่อไรถึงจะเหมาะที่สุด',
    paragraphs: [
      'สำหรับการประเมินราคาเบื้องต้น LINE มักเป็นช่องทางที่เหมาะที่สุด เพราะสามารถส่งรูป หลายมุม รุ่น สเปก และตำหนิได้ในรอบเดียว ทำให้ทีมงานมีข้อมูลมากพอจะตอบแนวราคากลับได้ไวกว่า ส่วนการโทรเหมาะกับกรณีที่ต้องการสอบถามภาพรวมสั้น ๆ ยืนยันเวลาติดต่อ หรือมีข้อสงสัยเร่งด่วนที่อธิบายด้วยข้อความยาว ๆ แล้วอาจช้า',
      'การบอกความต่างของสองช่องทางนี้บนหน้าติดต่อช่วยให้ผู้ใช้เลือกวิธีเริ่มต้นได้ตรงกับเป้าหมายของตัวเอง เช่น ถ้าต้องการประเมินราคาให้เร็ว ควรเริ่มจาก LINE แต่ถ้าแค่ต้องการถามเรื่องคิวหรือยืนยันช่องทางติดต่อ การโทรก็อาจสะดวกกว่า'
    ]
  },
  {
    heading: 'ถ้าอยากให้การติดต่อครั้งแรกจบในรอบเดียว ควรส่งอะไรไปบ้าง',
    paragraphs: [
      'ข้อมูลที่ช่วยให้การคุยรอบแรกมีคุณภาพคือ รูปหลายมุม รุ่น สเปกหรือความจุ สภาพจริง อุปกรณ์ในชุด และพื้นที่ที่อยู่ เพราะข้อมูลชุดนี้เชื่อมตรงไปยังการประเมินราคาและการแนะนำขั้นตอนต่อไปทันที หากส่งครบ ทีมงานมักตอบได้ทั้งเรื่องแนวราคาและสิ่งที่ควรทำต่อโดยไม่ต้องถามกลับหลายรอบ',
      'กรณีเครื่องมีตำหนิ เคยซ่อม หรือยังออกจากบัญชีไม่เรียบร้อย ก็ควรแจ้งตรงตั้งแต่ข้อความแรก เพราะช่วยให้คำตอบที่ได้ใกล้เคียงสภาพจริงกว่าเดิม และเป็นจุดเริ่มต้นของการสื่อสารที่โปร่งใส'
    ],
    list: evalChecklist.map((item) => `${item.t}: ${item.d}`)
  },
  {
    heading: 'คนที่อยู่ต่างจังหวัดในภาคอีสานควรใช้หน้าติดต่ออย่างไร',
    paragraphs: [
      'สำหรับคนที่อยู่นอกตัวเมืองหรืออยู่อีกจังหวัดหนึ่ง หน้าติดต่อควรทำให้มั่นใจได้ว่ายังเริ่มต้นประเมินได้ โดยการแจ้งจังหวัด อำเภอ หรือจุดนัดโดยประมาณพร้อมข้อมูลสินค้า วิธีนี้ช่วยให้ทีมงานตอบได้ทั้งเรื่องแนวราคาและบริบทการนัดหมายที่เหมาะกับพื้นที่จริง',
      'การอธิบายเรื่องนี้ในหน้าติดต่อมีผลต่อทั้งการใช้งานและ Local SEO เพราะผู้ค้นหาที่เห็นหน้าติดต่อมักอยู่ในช่วงตัดสินใจว่าจะลองคุยดีไหม ถ้าหน้านี้ตอบเรื่องพื้นที่ได้ชัด ก็จะช่วยเปลี่ยนจากความลังเลเป็นการเริ่มต้นสนทนาได้ง่ายขึ้น'
    ],
    links: [
      { href: '/พื้นที่ให้บริการ', label: 'ดูพื้นที่ให้บริการทั้งหมด' },
      { href: '/รับซื้อ', label: 'ดูหมวดรับซื้อสินค้า' },
      { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'เช็กคู่มือก่อนส่งข้อมูล' }
    ]
  },
  {
    heading: 'สรุป: ถ้าพร้อมเริ่มคุย ควรทำอะไรต่อจากหน้านี้',
    paragraphs: [
      'หลังอ่านหน้านี้จบ คุณควรรู้แล้วว่าควรเริ่มจาก LINE หรือโทร ควรเตรียมข้อมูลอะไร และควรอ่านหน้าไหนต่อถ้ายังมีข้อกังวลเกี่ยวกับการล้างข้อมูลหรือขั้นตอนการขาย หากข้อมูลพร้อมแล้ว การทัก LINE พร้อมรูปและรายละเอียดคือจุดเริ่มต้นที่ดีที่สุด เพราะเปลี่ยนจากการถามกว้าง ๆ ไปสู่การประเมินที่มีข้อมูลรองรับทันที',
      'เป้าหมายของหน้าติดต่อจึงไม่ใช่ทำให้คนเห็นปุ่มติดต่อเฉย ๆ แต่คือช่วยให้การกดติดต่อครั้งแรกเกิดขึ้นบนความเข้าใจที่ชัดเจน และทำให้กระบวนการขายเดินหน้าได้เร็วที่สุด'
    ]
  }
];

contactSections.push(
  {
    heading: 'ถ้ามีสินค้าหลายชิ้นหรือมาจากหลายหมวด ควรเริ่มคุยกับ BuyHub แบบไหนถึงจะประเมินง่าย',
    paragraphs: [
      'กรณีที่ลูกค้ามีสินค้าหลายชิ้น เช่น มีทั้งโน๊ตบุ๊ค มือถือ จอคอม และอุปกรณ์เสริม หรือเป็นการเคลียร์สินค้าจากบ้าน ร้านค้า หรือสำนักงาน หน้าติดต่อควรบอกให้ชัดว่าการเริ่มต้นไม่จำเป็นต้องส่งรูปทุกชิ้นแบบกระจัดกระจายทันที ทางที่เหมาะกว่าคือเริ่มจากสรุปรายการคร่าว ๆ ว่ามีอะไรบ้าง กี่ชิ้น หมวดไหนบ้าง แล้วเลือกส่งรูปตัวอย่างของรายการหลักที่อยากประเมินก่อน เมื่อทีมงานเห็นภาพรวมแล้วจึงค่อยไล่เก็บรายละเอียดทีละชุด วิธีนี้ช่วยลดความสับสนทั้งฝั่งลูกค้าและฝั่งประเมิน เพราะทำให้รู้ลำดับความสำคัญของงานชัดขึ้นตั้งแต่ต้น',
      'สำหรับงานที่มีหลายชิ้นจากองค์กรหรือสำนักงาน การส่งข้อมูลแบบมีโครงสร้างยิ่งสำคัญมาก เช่น ระบุหมวดสินค้า รุ่นโดยประมาณ จำนวนต่อหมวด สภาพโดยรวม และพื้นที่ที่ต้องการนัดหรือส่งมอบ ข้อมูลเหล่านี้ไม่เพียงช่วยเรื่องราคา แต่ยังช่วยให้ BuyHub วางแนวทางคิวและประสานงานต่อได้เหมาะกับบริบทจริง ลูกค้าที่อ่านหน้านี้จึงควรเข้าใจว่าการติดต่อครั้งแรกไม่จำเป็นต้องสมบูรณ์แบบทุกอย่าง แต่ควรมีแกนข้อมูลที่ทำให้ทีมงานต่อยอดได้ โดยเฉพาะเมื่องานมีความซับซ้อนมากกว่าการขายของเพียงชิ้นเดียว'
    ],
    list: [
      'เริ่มจากสรุปรายการคร่าว ๆ ก่อน เช่น หมวด รุ่น จำนวน และสภาพโดยรวม',
      'เลือกส่งรูปตัวอย่างของสินค้าหลักก่อน ไม่จำเป็นต้องกระจายส่งทีละชิ้นแบบไร้ลำดับ',
      'แจ้งพื้นที่หรือจังหวัดพร้อมไปด้วยเพื่อช่วยวางคิวและรูปแบบการส่งมอบ',
      'หากเป็นงานองค์กร ควรระบุผู้ติดต่อหลักที่ตอบข้อมูลต่อได้'
    ]
  },
  {
    heading: 'เรื่องเวลาตอบกลับและการเตรียมคำถามให้ตรงประเด็น สำคัญต่อคุณภาพการคุยอย่างไร',
