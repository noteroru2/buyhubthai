---
import InfoPage from '../components/InfoPage.astro';
import { LINE_URL, LINE_AT, PHONE_E164, PHONE_DISPLAY, FACEBOOK_URL, GOOGLE_MAPS_URL, PARENT_ORG_NAME, BUSINESS_HOURS_SHORT } from '../lib/constants';
---
<InfoPage path="/ติดต่อเรา" title="ติดต่อ BuyHub ส่งรูปเช็กราคาไอทีมือสอง" heading="คุยกับเรา เริ่มจากสินค้าของคุณ" description="ส่งรูปและรายละเอียดให้ทีมงาน BuyHub ประเมินเบื้องต้นฟรี ทาง LINE @buyhub หรือโทร 095-547-9408">
  <div class="bh-two-columns"><section><h2>ช่องทางติดต่อเดิมของ BuyHub</h2><div class="bh-service-list"><a href={LINE_URL} target="_blank" rel="noopener noreferrer"><h3>LINE {LINE_AT} ↗</h3><p>เหมาะกับการส่งรูปและรายการสินค้า</p></a><a href={`tel:${PHONE_E164}`}><h3>{PHONE_DISPLAY}</h3><p>โทรสอบถามรายละเอียดบริการ</p></a><a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer"><h3>Facebook BuyHub ↗</h3><p>ช่องทาง Facebook ของแบรนด์</p></a></div><p style="margin-top:22px">เวลาติดต่อออนไลน์: {BUSINESS_HOURS_SHORT}<br/>ทีมงานตอบตามคิว กรุณารอยืนยันก่อนนัดรับหรือจัดส่ง</p></section><section class="bh-checklist-card"><h2>ส่งอะไรในข้อความแรก?</h2><ul class="bh-check-list"><li>รูปตัวเครื่องหลายมุมและตำหนิ</li><li>รุ่น สเปก หรือความจุ</li><li>สภาพการใช้งานและประวัติซ่อม</li><li>อุปกรณ์ที่มี พร้อมจำนวน</li><li>จังหวัด อำเภอ และวิธีส่งมอบที่สะดวก</li></ul><p>ไม่ต้องส่งรหัสผ่านหรือรหัส OTP เพื่อประเมินราคา หากถ่ายรูปหน้าจอ กรุณาปิดข้อมูลส่วนตัวที่ไม่เกี่ยวข้อง</p></section></div>
  <section><h2>หน้าร้านหลักของผู้ดำเนินการ</h2><p>BuyHub ดำเนินการโดย {PARENT_ORG_NAME} มีหน้าร้านหลักที่ <strong>740/8 ถนนชยางกูร ตำบลในเมือง อำเภอเมืองอุบลราชธานี จังหวัดอุบลราชธานี 34000</strong></p><p>หากต้องการนำสินค้าเข้าร้าน กรุณาติดต่อ LINE @buyhub เพื่อยืนยันวัน เวลา และรายการสินค้าก่อนเดินทาง สำหรับการจัดส่ง โปรดรอที่อยู่และเงื่อนไขที่ทีมงานยืนยันในรายการของคุณ</p><a class="bh-text-link" href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer">เปิดแผนที่หน้าร้านหลัก ↗</a></section>
</InfoPage>
