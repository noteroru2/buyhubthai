    ],
    orderedList: [
      'เลือกหมวดสินค้าที่ใกล้กับของคุณที่สุด',
      'อ่านหน้าหมวดเพื่อดูปัจจัยราคาและเช็กลิสต์ข้อมูลที่ต้องส่ง',
      'ถ่ายรูปหลายมุมพร้อมรูปตำหนิถ้ามี',
      'ระบุรุ่น สเปก ความจุ อาการใช้งาน และอุปกรณ์ในชุด',
      'แจ้งจังหวัดหรือพื้นที่ แล้วส่งทั้งหมดเข้ามาประเมินทาง LINE'
    ],
    links: featuredSellLinks
  }
];

sellHubLongSections.push({
  heading: 'ถ้ายังไม่รู้ว่าจะเริ่มจากหมวดไหน ให้ใช้หน้า /รับซื้อ เป็นหน้าตัดสินใจก่อนทักประเมิน',
  paragraphs: [
    'หน้ารวมหมวดรับซื้อมีหน้าที่สำคัญมากสำหรับคนที่ยังไม่แน่ใจว่าสินค้าของตัวเองจัดอยู่ในหมวดใด หรือมีหลายชิ้นหลายประเภทจนไม่รู้ว่าจะเริ่มจากหน้าไหนก่อน สิ่งที่หน้าลักษณะนี้ควรทำไม่ใช่เพียงแสดงรายชื่อหมวด แต่ควรช่วยให้คนขายเข้าใจว่าหมวดต่าง ๆ ถูกแยกขึ้นมาเพราะปัจจัยประเมินของแต่ละประเภทไม่เหมือนกัน เช่น สินค้ากลุ่ม Apple มักเกี่ยวข้องกับบัญชีและสุขภาพแบต ขณะที่กลุ่มคอมพิวเตอร์จะเน้นสเปกและการใช้งานจริง การมีคำอธิบายภาพรวมแบบนี้ทำให้ผู้ใช้รู้ว่าทำไมการเลือกหมวดให้ตรงจึงช่วยให้การประเมินแม่นและเร็วขึ้น',
    'อีกมุมหนึ่ง หน้าศูนย์รวมหมวดรับซื้อยังช่วยให้ลูกค้าที่มีของหลายชิ้นจากบ้านหรือองค์กรใช้เป็นหน้าเริ่มต้นในการจัดความคิดได้ด้วย เพราะสามารถไล่ดูว่ารายการใดควรถูกจัดอยู่หมวดไหน รายการใดควรอ่านบทความประกอบเพิ่มเติม และรายการใดควรเริ่มจากการส่งข้อมูลประเมินเข้ามาก่อนโดยไม่ต้องกังวลว่าจะเลือกผิด 100% ตั้งแต่แรก ถ้าหน้านี้ทำงานดี ลูกค้าจะไม่รู้สึกว่าต้องเดาเอง แต่จะมีโครงให้เดินตามจนพร้อมเริ่มคุยจริง'
  ],
  links: [
    { href: '/บทความ', label: 'ดูบทความเฉพาะเคสก่อนขาย' },
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'ดูคู่มือเตรียมเครื่องก่อนขาย' },
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขายทั้งหมด' }
  ]
});

sellHubLongSections.push({
  heading: 'ถ้าสินค้าหนึ่งชิ้นดูเหมือนอยู่ได้หลายหมวด ควรเลือกหน้าไหนก่อน',
  paragraphs: [
    'ของบางอย่างไม่ได้เข้าหมวดแบบตายตัวในสายตาของผู้ขาย เช่น iPad ที่ใช้ทำงานร่วมกับ Apple Pencil อาจทำให้ลังเลว่าจะเริ่มจากหมวดแท็บเล็ตหรือหมวดอุปกรณ์เสริมก่อน หรือคอมบริษัทที่มีทั้งจอคอม อุปกรณ์สำนักงาน และโน๊ตบุ๊คหลายเครื่องอาจดูเหมือนต้องเปิดหลายหน้าไปพร้อมกัน ในสถานการณ์แบบนี้หน้ารวม /รับซื้อ ควรทำหน้าที่ช่วยตัดสินใจง่าย ๆ ว่าให้เริ่มจากหมวดที่ “ใกล้กับตัวสินค้าหลักหรือเป้าหมายการขายหลักที่สุด” ก่อน เพราะหน้าหมวดนั้นจะมีบริบทการประเมินที่แม่นที่สุด แล้วค่อยใช้ลิงก์ภายในไปยังหมวดรองที่เกี่ยวข้องเพิ่มเติมเมื่อจำเป็น',
    'แนวคิดนี้ช่วยทั้งการใช้งานจริงและ Local SEO/AEO เพราะทำให้หน้า /รับซื้อ กลายเป็นหน้ากลางที่ช่วยตอบ intent แบบยังไม่แน่ใจ ไม่ใช่เพียงหน้ารวมลิงก์ธรรมดา เมื่อผู้ใช้รู้ว่าถ้าไม่แน่ใจให้เริ่มจากหมวดหลักก่อน แล้วแจ้งรายการรองหรือของหลายชิ้นในข้อความแรกได้ เขาจะก้าวต่อได้เร็วขึ้นโดยไม่ต้องเสียเวลาเลือกให้เป๊ะตั้งแต่ต้น และยังช่วยให้ข้อความรอบแรกที่ส่งมาหา BuyHub มีโครงสร้างมากขึ้นตามธรรมชาติ'
  ],
  orderedList: [
    'เลือกหมวดที่ตรงกับสินค้าหลักหรือเป้าหมายการขายหลักที่สุดก่อน',
    'ใช้หน้าหมวดนั้นดูปัจจัยประเมินและลิงก์บทความเฉพาะเคส',
    'แจ้งรายการรองหรือสินค้าที่เกี่ยวข้องเพิ่มเติมในข้อความแรก',
    'หากยังไม่แน่ใจ ให้แนบรูปและสรุปรายการทั้งหมดเพื่อให้ทีมงานช่วยจัดหมวดร่วมกัน'
  ]
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/images/og/buyhub-sell-share.png"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'หน้าแรก', href: '/' },
    { name: title, href: '/รับซื้อ' }
  ]}
>
  <article class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">{title}</h1>
      <div class="mt-5 max-w-3xl space-y-4 text-base leading-8 text-slate-700">
        <p>
          หน้านี้คือหน้ารวมหมวดสินค้าที่ BuyHub รับซื้อ เหมาะสำหรับเริ่มต้นเลือกหมวดที่ตรงกับสินค้าของคุณ
          หรือใช้เป็นจุดเชื่อมไปยังหน้ารับซื้อรายหมวด (เช่น MacBook, iPhone, โน๊ตบุ๊ค, คอมบริษัท) เพื่ออ่านรายละเอียดเพิ่มก่อนตัดสินใจ
        </p>
        <p>
          หากต้องการประเมินราคาแบบเร็วที่สุด แนะนำส่งรูปสินค้า รุ่น/สเปก และสภาพเครื่องผ่าน LINE <strong class="font-semibold text-slate-950">{LINE_AT}</strong>
          ทีมงานจะให้แนวราคาฟรีและแจ้งเงื่อนไขก่อนนัดตรวจ
        </p>
      </div>
      <div class="mt-10">
        <EditorialTrustPanel
          reviewedAt={EDITORIAL_REVIEWED_AT}
          reviewedBy={EDITORIAL_REVIEWER}
          scope={editorialSignals.scope}
          notes={[...editorialSignals.notes]}
          links={[...editorialSignals.links]}
        />
      </div>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <LineCtaButton variant="primary" label={`ประเมินราคาทาง LINE ${LINE_AT}`} />
        <PhoneCtaButton variant="light" />
      </div>
      <ContentVisualPanel
        eyebrow="ภาพรวมการประเมิน"
        title="เริ่มจากข้อมูลจริง แล้วค่อยไปหน้าหมวดที่ตรง"
        body="คนที่ต้องการขายสินค้าไอทีมือสองไม่จำเป็นต้องไล่พิมพ์คีย์เวิร์ดยาว ๆ เพื่อให้ระบบเข้าใจ สิ่งที่ช่วยมากกว่าคือการบอกรุ่น สเปก สภาพเครื่อง อุปกรณ์ที่มี และจังหวัดที่สะดวก จากนั้นหน้า hub และหน้าหมวดที่เกี่ยวข้องจะรับช่วงต่อเอง ทำให้ทั้งคนอ่านและระบบค้นหาเห็นว่าหน้านี้มีประโยชน์จริง ไม่ได้ตั้งใจวางคำค้นซ้ำเป็นก้อน"
        gallery={[
          { src: '/images/buyback/buyhub-xiaomi-pad-tablet.webp', alt: 'ตัวอย่างแท็บเล็ต Xiaomi Pad สภาพสวยพร้อมกล่องสำหรับประเมินราคา' },
          { src: '/images/buyback/buyhub-notebook-asus-vivobook-oled.webp', alt: 'ตัวอย่างโน๊ตบุ๊ค Asus Vivobook OLED บนโต๊ะที่นัดประเมินราคาจริง' },
          { src: '/images/buyback/buyhub-notebook-asus-2026.webp', alt: 'ตัวอย่างโน๊ตบุ๊ค Windows อีกรุ่นบนโต๊ะนัดประเมินราคาจริง' },
          { src: '/images/buyback/buyhub-iphone-15-used-box.webp', alt: 'ตัวอย่างสมาร์ทโฟน iPhone 15 พร้อมกล่องสวยงามสำหรับนัดประเมินราคาจริง' }
        ]}
        points={[
          'เริ่มจากรุ่นหรือสเปกที่อ่านได้จากตัวเครื่อง',
          'ส่งรูปสภาพจริงหลายมุมพร้อมตำหนิที่เห็นชัด',
          'แจ้งอุปกรณ์ในชุดและจังหวัดที่สะดวกไว้ตั้งแต่ข้อความแรก'
        ]}
      />
      <KeywordIntentPanel
        sectionId="sell-hub-keywords"
        title="คำค้นหลักและคำค้นรองที่หน้ารับซื้อรวมตั้งใจตอบ"
        className="mt-12"
        intro={[
          `หน้านี้ถูกวางให้ตอบคำค้นหลักอย่าง “${sellHubKeywordCluster.primary}” พร้อมคำค้นรองอย่าง ${sellHubKeywordLead} เพื่อให้คนที่ยังไม่แน่ใจว่าควรเริ่มจากหมวดไหนมีจุดเริ่มต้นที่ชัดขึ้น`,
          `ถ้าคุณกำลังค้นหาทั้ง ${sellHubKeywordSupport || 'คำค้นตามหมวดสินค้า'} และ ${sellHubKeywordQuestions || 'คำค้นก่อนตัดสินใจประเมิน'} รวมถึง ${sellHubKeywordPrice || 'คำค้นเชิงราคา'} และ ${sellHubKeywordDecision || 'คำค้นเชิงเลือกหมวด'} หน้านี้จะช่วยเชื่อมจากคำค้นกว้างไปสู่หน้าหมวดที่ตรงกับสินค้าจริงของคุณได้เร็วขึ้น`
        ]}
        groups={[
          {
            title: 'คำค้นก่อนเริ่มเลือกหมวดรับซื้อ',
            blurb: 'เหมาะกับคนที่รู้เพียงว่าต้องการขายสินค้า IT มือสอง แต่ยังไม่แน่ใจว่าควรเข้าหน้าไหนก่อน',
            items: sellHubKeywordCluster.localIntent ?? []
          },
          {
            title: 'คำค้นตามหมวดสินค้าที่คนมักหาต่อ',
            blurb: 'กลุ่มนี้ช่วยครอบคลุมคำค้นที่โยงไปยัง Apple, คอมพิวเตอร์, เกมมิ่ง และหมวดองค์กรที่สำคัญ',
            items: sellHubKeywordCluster.modelIntent ?? []
          },
          {
            title: 'คำค้นก่อนส่งรูปประเมินหรือขายหลายชิ้น',
            blurb: 'ใช้ตอบคำถามที่มักเกิดก่อนเริ่มคุยจริง เช่น เครื่องมีตำหนิ, มีหลายชิ้น หรือยังไม่รู้ว่าจะเลือกหน้าหมวดไหนดี',
            items: sellHubKeywordCluster.issueIntent ?? []
          },
          {
            title: 'คำค้นเชิงราคาและช่วงประเมิน',
            blurb: 'เหมาะกับคนที่อยากรู้ก่อนว่าขายตอนนี้จะได้ราคาช่วงไหนและควรเตรียมข้อมูลอะไรเพิ่ม',
            items: sellHubKeywordCluster.priceIntent ?? []
          },
          {
            title: 'คำค้นเชิงตัดสินใจเลือกเส้นทางขาย',
            blurb: 'ช่วยตอบคนที่กำลังเลว่าจะขายช่องทางไหน ควรขายตอนนี้ไหม หรือควรขายเป็นก้อนดีกว่า',
            items: sellHubKeywordCluster.decisionIntent ?? []
          }
        ]}
      />

      <div class="mt-14 space-y-14">
        {groups.map((g) => (
          <section aria-labelledby={`sell-group-${g.title}`}>
            <h2 id={`sell-group-${g.title}`} class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
              {g.title}
            </h2>
            <p class="mt-3 max-w-3xl text-base leading-8 text-slate-600">{g.sub}</p>
            <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {g.ids.map((id) => {
                const e = byId[id];
                if (!e) return null;
                const href = sellThaiHref(e.id);
                return (
                  <li class="h-full">
                    <a
                      href={href}
                      class="group flex h-full min-h-[12rem] flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl"
                    >
                      <span class="text-lg font-bold text-slate-950 group-hover:text-emerald-700">{e.data.title}</span>
                      <span class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{e.data.description}</span>
                      <span class="mt-5 text-sm font-semibold text-emerald-700">อ่านเพิ่มเติม →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>

      <section class="mt-16 rounded-2xl border border-slate-200 bg-slate-50/70 p-6 sm:p-8" aria-labelledby="send-info">
        <h2 id="send-info" class="text-xl font-bold tracking-tight text-slate-950">วิธีส่งรูปประเมินราคาให้เร็ว</h2>
        <ul class="mt-4 grid gap-2 text-sm leading-7 text-slate-700 sm:grid-cols-2">
          <li><span class="font-semibold text-slate-950">รูปสินค้า</span> หลายมุม + จุดตำหนิ</li>
          <li><span class="font-semibold text-slate-950">รุ่น/ความจุ/สเปก</span> (ถ้ามี)</li>
          <li><span class="font-semibold text-slate-950">สภาพการใช้งาน</span> เช่น จอ ปุ่ม พอร์ต ลำโพง</li>
          <li><span class="font-semibold text-slate-950">แบตเตอรี่</span> (ถ้าดูได้)</li>
          <li><span class="font-semibold text-slate-950">อุปกรณ์</span> กล่อง สาย หัวชาร์จ</li>
          <li><span class="font-semibold text-slate-950">จังหวัด</span> เพื่อคุยเรื่องคิวรับซื้อ/ส่งมอบ</li>
        </ul>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          ถ้าอยากอ่านแนวทางรายเคสแบบเร็ว แนะนำเริ่มจาก{' '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/คู่มือเตรียมสินค้าก่อนขาย">คู่มือเตรียมสินค้าก่อนขาย</a>{' '}
          และบทความที่ตรงกับสินค้า:
          {' '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/บทความ/ขาย-iphone-ต้องออก-icloud-ไหม">ขาย iPhone ต้องออก iCloud ไหม</a>
          {' · '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/บทความ/ขาย-macbook-ต้องออก-apple-id-ไหม">ขาย MacBook ต้องออก Apple ID ไหม</a>
          {' · '}
          <a class="font-semibold text-emerald-700 hover:underline" href="/บทความ/ขาย-คอมเกมมิ่ง-ต้องส่งสเปกอะไรบ้าง">ขายคอมเกมมิ่งต้องส่งสเปกอะไรบ้าง</a>
        </p>
      </section>

      <section class="mt-12 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="trust-links">
        <h2 id="trust-links" class="text-xl font-bold tracking-tight text-slate-950">ก่อนตัดสินใจขาย ดูตัวอย่างจริงได้</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          ถ้าคุณอยากดูหลักฐานและคำตอบเพิ่มเติม แนะนำ 3 หน้านี้:
        </p>
        <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
          <li>
            <a class="block rounded-xl border border-slate-200 bg-slate-50/70 p-4 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/รีวิวลูกค้า">
              รีวิวลูกค้า →
            </a>
          </li>
          <li>
            <a class="block rounded-xl border border-slate-200 bg-slate-50/70 p-4 font-semibold text-emerald-800 hover:border-slate-300 hover:bg-white" href="/ผลงานรับซื้อจริง">
              ผลงานรับซื้อจริง →
            </a>
          </li>
