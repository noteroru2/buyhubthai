---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyhubCta from '../components/BuyhubCta.astro';
import { serviceGroups } from '../data/serviceCatalog';
import { breadcrumbJsonLd } from '../lib/schema';
const breadcrumbs = [{ name: 'หน้าแรก', href: '/' }, { name: 'สินค้าที่รับซื้อ', href: '/รับซื้อ' }];
---
<BaseLayout title="สินค้าที่รับซื้อ โน๊ตบุ๊ค คอม มือถือ และอุปกรณ์ไอที | BuyHub" description="เลือกหมวดสินค้าที่ต้องการขายกับ BuyHub ดูรายละเอียดรับซื้อและข้อมูลที่ใช้ประเมิน ทั้งโน๊ตบุ๊ค คอมพิวเตอร์ MacBook มือถือ กล้อง และงานไอทียกล็อต" breadcrumbs={breadcrumbs} jsonLd={[breadcrumbJsonLd(breadcrumbs)]}>
  <section class="bh-page-head"><div class="bh-wrap"><p class="bh-eyebrow">บริการรับซื้อ</p><h1>ไอทีชิ้นไหนที่คุณอยากขาย?</h1><p>เลือกหมวดเพื่อดูสิ่งที่รับพิจารณา ปัจจัยประเมินราคา และรูปที่ควรส่งให้ทีมงาน เช็กราคาเบื้องต้นได้ฟรีก่อนตัดสินใจ</p><div class="bh-inline-links">{serviceGroups.map(group => <a href={`#${group.id}`}>{group.title}</a>)}</div></div></section>
  <div class="bh-content bh-wrap">{serviceGroups.map(group => <section id={group.id} style="scroll-margin-top:110px"><p class="bh-eyebrow">BUYHUB</p><h2>{group.title}</h2><p>{group.description}</p><div class="bh-service-list">{group.items.map(item => <a href={item.href}><h3>รับซื้อ{item.name} ↗</h3><p>{item.detail}</p></a>)}</div></section>)}<section><h2>สินค้าเสีย มีตำหนิ หรือไม่อยู่ในรายการ?</h2><p>ส่งรูป รุ่น และอาการให้ทีมงานพิจารณาได้ก่อน การรับซื้อขึ้นอยู่กับรุ่น สภาพ และความเหมาะสมของแต่ละรายการ หากมีหลายชนิด ให้แยกรุ่นและจำนวนเพื่อประเมินได้ชัดเจนขึ้น</p><a class="bh-text-link" href="/ติดต่อเรา">ติดต่อทีมงาน BuyHub ↗</a></section></div><BuyhubCta/>
</BaseLayout>
