---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ContentVisualPanel from '../components/ContentVisualPanel.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import KeywordIntentPanel from '../components/KeywordIntentPanel.astro';
import LineCtaButton from '../components/LineCtaButton.astro';
import LongformSections from '../components/LongformSections.astro';
import PhoneCtaButton from '../components/PhoneCtaButton.astro';
import { buildSellHubKeywordCluster, joinThaiKeywordPreview } from '../lib/keywordClusters';
import { breadcrumbJsonLd, faqPageJsonLd, webPageJsonLd } from '../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER, LINE_AT } from '../lib/constants';
import { sellThaiHref } from '../lib/thaiRoutes';

const entries = await getCollection('sell', ({ data }) => !data.draft);
const sorted = entries.sort((a, b) => a.data.title.localeCompare(b.data.title, 'th'));
const byId = Object.fromEntries(entries.map((e) => [e.id, e]));

const title = 'รับซื้อสินค้าไอทีมือสองทุกประเภท';
const description =
  `BuyHub รับซื้อสินค้าไอทีมือสองทุกประเภท โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad กล้อง จอคอม การ์ดจอ อุปกรณ์เกมมิ่ง และคอมบริษัท ส่งรูปประเมินราคาฟรีผ่าน LINE ${LINE_AT}`;

const groups = [
  {
    title: 'กลุ่มสินค้า Apple',
    sub: 'เหมาะกับ iPhone iPad MacBook Apple Watch AirPods และอุปกรณ์เสริม Apple',
    ids: ['iphone', 'ipad', 'macbook', 'apple-watch', 'airpods', 'apple-pencil'] as const
  },
  {
    title: 'กลุ่มโน๊ตบุ๊คและคอมพิวเตอร์',
    sub: 'รวมโน๊ตบุ๊ค คอมตั้งโต๊ะ คอมประกอบ คอมเกมมิ่ง และอุปกรณ์ที่เกี่ยวข้อง',
    ids: ['notebook', 'desktop-pc', 'gaming-pc', 'pc-assembled', 'monitor', 'gpu'] as const
  },
  {
    title: 'กลุ่มมือถือและแท็บเล็ต',
    sub: 'มือถือ Android และแท็บเล็ตหลายยี่ห้อ ประเมินตามรุ่น/สเปก/สภาพจริง',
    ids: ['mobile-phone', 'tablet', 'samsung'] as const
  },
  {
    title: 'กลุ่มกล้องและอุปกรณ์ถ่ายภาพ',
    sub: 'กล้อง เลนส์ อุปกรณ์ประกอบ ประเมินตามรุ่นและสภาพการใช้งาน',
    ids: ['camera'] as const
  },
  {
    title: 'กลุ่มเกมมิ่งและอุปกรณ์เสริม',
    sub: 'เครื่องเกมและอุปกรณ์เกมมิ่ง รวมถึงอุปกรณ์เสริม IT ที่ขายต่อได้',
    ids: ['game-console', 'playstation', 'nintendo-switch', 'gaming-gear', 'it-accessories'] as const
  },
  {
    title: 'กลุ่มคอมบริษัทและอุปกรณ์สำนักงาน',
    sub: 'รับประเมินงานจำนวนมากจากบริษัท/สำนักงาน/หน่วยงาน และอุปกรณ์สำนักงาน IT ที่เกี่ยวข้อง',
    ids: ['corporate-it', 'printer', 'office-it'] as const
  }
] as const;

const hubFaqs = [
  {
    question: 'BuyHub รับซื้อสินค้าไอทีมือสองอะไรบ้าง?',
    answer:
      'รับซื้อหลายหมวด เช่น โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad มือถือ Android แท็บเล็ต กล้อง จอคอม การ์ดจอ อุปกรณ์เกมมิ่ง คอมบริษัท และอุปกรณ์เสริม IT'
  },
  {
    question: 'ประเมินราคาฟรีไหม และต้องส่งอะไรบ้าง?',
    answer:
      `ฟรี แนะนำส่งรูปหลายมุม + รุ่น/สเปก + ตำหนิ/สภาพ + อุปกรณ์ที่มี และจังหวัดทาง LINE ${LINE_AT} เพื่อให้ประเมินได้เร็วและใกล้เคียง`
  },
  {
    question: 'รับซื้อสินค้าจำนวนมากจากบริษัท/หน่วยงานไหม?',
    answer:
      'รับประเมินได้ แนะนำส่งรายการคร่าว ๆ จำนวน และรูปประกอบ เพื่อให้ทีมงานประเมินเป็นก้อนและวางแผนคิวรับซื้อ'
  },
  {
    question: 'อยู่ต่างจังหวัดในภาคอีสานขายได้ไหม?',
    answer:
      'ได้ BuyHub ให้บริการภาคอีสาน ลูกค้าสามารถส่งรูปประเมินก่อน แล้วค่อยคุยนัดรับ/ส่งมอบตามจังหวัดและคิวงาน'
  }
] as const;

const editorialSignals = {
  scope:
    'หน้ารวมหมวดรับซื้อของ BuyHub ใช้เป็นทางเข้าไปยังหน้าสินค้าแต่ละประเภท พร้อมอธิบายหลักการประเมิน ราคา และวิธีเริ่มส่งข้อมูลให้ตรงหมวดมากที่สุด',
  about: ['รับซื้อสินค้า IT มือสอง', 'เลือกหมวดรับซื้อให้ตรงสินค้า', 'ประเมินราคาผ่าน LINE'],
  notes: [
    'เหมาะสำหรับคนที่ยังไม่แน่ใจว่าควรเริ่มจากหน้าสินค้าหมวดไหนก่อน และต้องการดูภาพรวมทั้งเว็บในหน้าเดียว',
    'ราคาประเมินจริงยังขึ้นกับรุ่น สเปก สภาพ อุปกรณ์ที่มี และข้อมูลพื้นที่ที่ส่งมาพร้อมรูปสินค้า',
    'หากขายหลายชิ้นหรือเป็นงานองค์กร ควรเริ่มจากหน้าหมวดที่ใกล้ที่สุดแล้วส่งรายการคร่าว ๆ มาพร้อมกันในข้อความแรก'
  ],
  links: [
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'ดูคู่มือเตรียมสินค้าก่อนขาย' },
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขายทั้งหมด' },
    { href: '/ผลงานรับซื้อจริง', label: 'ดูผลงานรับซื้อจริง' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: title, href: '/รับซื้อ' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/รับซื้อ',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  faqPageJsonLd(hubFaqs)
];

const featuredSellLinks = sorted.slice(0, 12).map((entry) => ({
  href: sellThaiHref(entry.id),
  label: entry.data.title
}));
const sellHubKeywordCluster = buildSellHubKeywordCluster();
const sellHubKeywordLead = joinThaiKeywordPreview(sellHubKeywordCluster.localIntent ?? [], 4, true);
const sellHubKeywordSupport = joinThaiKeywordPreview(sellHubKeywordCluster.modelIntent ?? [], 4, true);
const sellHubKeywordQuestions = joinThaiKeywordPreview(sellHubKeywordCluster.issueIntent ?? [], 4, true);
const sellHubKeywordPrice = joinThaiKeywordPreview(sellHubKeywordCluster.priceIntent ?? [], 3, true);
const sellHubKeywordDecision = joinThaiKeywordPreview(sellHubKeywordCluster.decisionIntent ?? [], 3, true);

const sellHubLongSections = [
  {
    heading: 'ใช้หน้าหมวดรับซื้อนี้อย่างไร ถ้ายังไม่แน่ใจว่าสินค้าของตัวเองอยู่หมวดไหน',
    paragraphs: [
      'หน้ารับซื้อของ BuyHub ถูกออกแบบมาเพื่อให้คนที่มีสินค้า IT มือสองหลายประเภทสามารถเริ่มต้นได้จากจุดเดียว ไม่ว่าคุณจะมี iPhone, MacBook, โน๊ตบุ๊ค Windows, คอมตั้งโต๊ะ, กล้อง, เครื่องเกม, จอคอม หรืออุปกรณ์สำนักงาน IT จุดสำคัญไม่ใช่การท่องชื่อหมวดทั้งหมด แต่คือการหาหน้าที่ใกล้กับสินค้าจริงของคุณมากที่สุด เพื่อให้ได้ทั้งรายละเอียดเรื่องปัจจัยราคา วิธีถ่ายรูป และลิงก์อ่านต่อที่ตรงรุ่นกว่า',
      'การมีหน้าฮับที่แข็งแรงยังช่วยให้ผู้ค้นหาที่เจตนายังไม่ชัดสามารถไล่ต่อจากหน้าเดียวได้ เช่น คนที่พิมพ์คำว่า “รับซื้อไอทีมือสอง” อาจยังไม่รู้ว่าควรดูหมวดไหนก่อน ถ้าหน้านี้ช่วยจับคู่เจตนาค้นหากับหมวดสินค้าได้ดี ก็จะช่วยทั้งการใช้งานจริงและการทำ SEO เพราะลดการเด้งกลับและเพิ่มโอกาสให้ผู้อ่านไปต่อยังหน้าที่มีความเกี่ยวข้องสูงกว่า'
