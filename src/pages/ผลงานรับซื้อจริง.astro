<BaseLayout title={title} description={description} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <article class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <header class="max-w-3xl">
        <h1 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">ผลงานรับซื้อสินค้า IT มือสองจริง</h1>
        <p class="mt-5 text-base leading-8 text-slate-700">
          รวมตัวอย่างผลงานรับซื้อจริง เพื่อให้เห็นหมวดสินค้าที่รับประเมินและแนวทางตรวจเช็คก่อนตกลงราคา
          หากต้องการประเมินแบบตรงรุ่น แอด LINE <span class="font-semibold text-slate-950">{LINE_AT}</span> แล้วส่งรูปสินค้าได้เลย
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <LineCtaButton variant="primary" label={`ส่งรูปประเมินราคาฟรีผ่าน LINE ${LINE_AT}`} />
          <PhoneCtaButton variant="light" />
        </div>
      </header>

      <div class="mt-10">
        <EditorialTrustPanel
          reviewedAt={EDITORIAL_REVIEWED_AT}
          reviewedBy={EDITORIAL_REVIEWER}
          scope="หน้านี้รวบรวมตัวอย่างผลงานรับซื้อจริงตามหมวดสินค้า เพื่อช่วยให้คนขายเห็นประเภทงานที่ BuyHub รับประเมินและเข้าใจข้อมูลที่ควรเตรียมก่อนส่งราคาจริง"
          notes={[
            'ภาพตัวอย่างใช้เพื่อประกอบความเข้าใจเรื่องประเภทสินค้าและวิธีเตรียมข้อมูล ไม่ได้ใช้แทนการประเมินราคาของสินค้ารายชิ้น',
            'หากมีภาพแชทหรือข้อมูลประกอบที่เกี่ยวข้องกับลูกค้า จะต้องปิดข้อมูลส่วนบุคคลก่อนเผยแพร่เสมอ',
            'สำหรับคนที่อยู่ต่างจังหวัด หน้านี้ควรใช้ควบคู่กับหน้าพื้นที่ให้บริการ เพื่อดูบริบทการแจ้งอำเภอและขั้นตอนต่อในพื้นที่จริง'
          ]}
          links={[
            { href: '/พื้นที่ให้บริการ', label: 'ดูหน้าพื้นที่ให้บริการทั้งหมด' },
            { href: '/รีวิวลูกค้า', label: 'ดูรีวิวลูกค้าและหลักฐานเพิ่มเติม' }
          ]}
        />
      </div>

      <section class="mt-12" aria-labelledby="proof-local-areas">
        <h2 id="proof-local-areas" class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
          จังหวัดที่คนมักดูต่อหลังจากหน้า “ผลงานรับซื้อจริง”
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-8 text-slate-600">
          ถ้าคุณดูหมวดสินค้าที่ใกล้กับของตัวเองแล้ว ขั้นถัดไปที่มีประโยชน์คือไปดูหน้าจังหวัดที่เกี่ยวข้อง เพื่อเช็กบริบทการเริ่มประเมินและการแจ้งพื้นที่ให้ตรงกับเคสของคุณ
        </p>
        <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featuredAreaSpotlights.map((item) => (
            <li>
              <a
                href={item.href}
                class="block h-full rounded-2xl border border-slate-200 bg-slate-50/70 p-5 transition-all duration-200 hover:border-slate-300 hover:bg-white hover:shadow-lg"
              >
                <h3 class="text-lg font-bold tracking-tight text-slate-950">{item.province}</h3>
                <p class="mt-3 text-sm leading-7 text-slate-700">{item.summary}</p>
                <p class="mt-3 text-sm leading-7 text-slate-600">{item.proofHint}</p>
                <span class="mt-4 inline-block text-sm font-semibold text-emerald-700">ดูหน้าพื้นที่ {item.province} →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="mt-14 space-y-16">
        {groups.map((g) => (
          <section aria-labelledby={`proof-${g.group}`}>
            <h2 id={`proof-${g.group}`} class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
              {g.group}
            </h2>
            <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {g.items.map((i) => (
                <li class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-xl">
                  <div class="aspect-[4/3] w-full bg-slate-100">
                    <img src={i.src} alt={i.alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  </div>
                  <div class="p-6">
                    <h3 class="text-lg font-bold tracking-tight text-slate-950">{i.title}</h3>
                    {i.province ? <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-emerald-700">{i.province}</p> : null}
                    <p class="mt-2 text-sm leading-6 text-slate-600">{i.detail}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <LongformSections sections={showcaseSections} tocHeading="หัวข้อสำคัญสำหรับหน้าผลงานรับซื้อจริง" />
    </div>
  </article>

  <CtaBand
    heading="ต้องการให้ประเมินแบบตรงรุ่น?"
    sub={`ส่งรูปสินค้า รุ่น/สเปก และสภาพมาที่ LINE ${LINE_AT} เพื่อประเมินราคาฟรี แล้วค่อยตัดสินใจขาย`}
    lineLabel={`แอด LINE ${LINE_AT}`}
  />
</BaseLayout>
