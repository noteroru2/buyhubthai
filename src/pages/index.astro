---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyhubCta from '../components/BuyhubCta.astro';
import SellingSteps from '../components/SellingSteps.astro';
import ProductGallery from '../components/ProductGallery.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { featuredServices } from '../data/serviceCatalog';
import { LINE_URL, PHONE_DISPLAY, PHONE_E164 } from '../lib/constants';
import { faqPageJsonLd } from '../lib/schema';
const faqs = [
  { question: 'ส่งรูปเช็กราคาต้องเสียค่าใช้จ่ายไหม?', answer: 'ประเมินเบื้องต้นฟรี ส่งรูป รุ่น สเปก สภาพ อุปกรณ์ และจังหวัดผ่าน LINE @buyhub คุณตัดสินใจได้หลังทราบแนวราคา โดยยังไม่ต้องส่งสินค้ามาก่อน' },
  { question: 'เครื่องมีตำหนิหรือแบตเสื่อม ส่งประเมินได้ไหม?', answer: 'ส่งข้อมูลให้พิจารณาได้ กรุณาแจ้งอาการและถ่ายรูปตำหนิให้ชัด การรับซื้อและราคาขึ้นอยู่กับรุ่น อาการ และสภาพจริงของแต่ละเครื่อง' },
  { question: 'อยู่ต่างจังหวัดต้องส่งสินค้าอย่างไร?', answer: 'แจ้งจังหวัด อำเภอ และจำนวนสินค้าก่อน ทีมงานจะยืนยันวิธีนัดรับหรือจัดส่งตามพื้นที่และคิวงาน โปรดรอรายละเอียดและที่อยู่ยืนยันก่อนส่งสินค้า' },
  { question: 'ราคาจากรูปเป็นราคาสุดท้ายหรือไม่?', answer: 'เป็นราคาเบื้องต้นจากข้อมูลที่ได้รับ ราคาสุดท้ายยืนยันหลังตรวจสินค้าจริง หากพบสภาพต่างจากข้อมูลเดิม ทีมงานจะแจ้งให้ทราบก่อนตกลงทำรายการ' }
];
---
<BaseLayout title="รับซื้อสินค้าไอทีมือสอง ขายง่าย รู้ราคาก่อนตัดสินใจ | BuyHub" description="ขายโน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad และกล้องกับ BuyHub ส่งรูปเช็กราคาฟรี รู้ขั้นตอนก่อนส่งมอบ ติดต่อ LINE @buyhub โทร 095-547-9408" jsonLd={[faqPageJsonLd(faqs)]}>
  <section class="bh-hero"><div class="bh-wrap bh-hero-grid"><div>
    <p class="bh-eyebrow"><span class="bh-dot"></span> BUYHUB · IT BUYBACK</p>
    <h1>ไอทีที่ไม่ได้ใช้<br/>เปลี่ยนเป็น<span>เงินก้อนใหม่</span></h1>
    <p class="bh-hero-lead">รับซื้อสินค้าไอทีมือสอง<br/>ขายง่าย รู้ราคาก่อนตัดสินใจ</p>
    <p class="bh-hero-copy">โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad และกล้อง ส่งรูปให้เราประเมินเบื้องต้นฟรี แล้วค่อยเลือกวิธีส่งมอบที่เหมาะกับคุณ</p>
    <div class="bh-actions"><a class="bh-button" href={LINE_URL} target="_blank" rel="noopener noreferrer">ส่งรูปเช็กราคาฟรี <span aria-hidden="true">↗</span></a><a class="bh-text-link" href="#categories">เลือกสินค้าที่อยากขาย ↓</a></div>
    <div class="bh-hero-notes"><span>✓ ประเมินฟรี</span><span>✓ ไม่บังคับขาย</span><span>✓ ยืนยันราคาหลังตรวจ</span></div>
  </div><div class="bh-hero-visual"><div class="bh-hero-photo"><img src="/images/buyback/buyhub-notebook-asus-vivobook-oled.webp" alt="โน๊ตบุ๊ค ASUS มือสองบนโต๊ะตรวจสินค้า" width="1024" height="768" fetchpriority="high"/><span class="bh-photo-label">เครื่องเก่าของคุณ ยังมีมูลค่า</span></div><div class="bh-hero-mini"><img src="/images/buyback/buyhub-iphone-15-used-box.webp" alt="iPhone พร้อมกล่อง" width="800" height="600"/><div><span>เริ่มได้จากเครื่องเดียว</span><strong>ส่งรูป · เช็กราคา · ตัดสินใจ</strong></div><span class="bh-mini-arrow" aria-hidden="true">↗</span></div></div></div></section>
  <div class="bh-service-strip"><div class="bh-wrap"><span>รับซื้อจากบุคคลทั่วไป</span><span>ร้านค้าและสินค้าหลายชิ้น</span><span>คอมบริษัทและงานยกล็อต</span><a href={`tel:${PHONE_E164}`}>คุยกับทีมงาน {PHONE_DISPLAY} ↗</a></div></div>
  <section id="categories" class="bh-section"><div class="bh-wrap"><div class="bh-section-heading"><div><p class="bh-eyebrow">สินค้าที่รับซื้อ</p><h2>คุณอยากขายอะไร?</h2><p>เลือกหมวด เพื่อดูรายละเอียดและข้อมูลที่ใช้ประเมิน</p></div><a class="bh-text-link" href="/รับซื้อ">ดูทุกหมวดสินค้า ↗</a></div>
    <div class="bh-category-grid">{featuredServices.map((item, i) => <a class="bh-category-card" href={item.href}><div class="bh-category-top"><span>0{i+1}</span><span aria-hidden="true">↗</span></div><img src={`/images/buyback/${item.image}`} alt={item.name} width="800" height="600" loading="lazy"/><h3>รับซื้อ{item.name}</h3><p>{item.detail}</p></a>)}</div>
    <div class="bh-inline-links"><span>มีอย่างอื่นด้วย?</span><a href="/รับซื้อการ์ดจอ">การ์ดจอ</a><a href="/รับซื้อจอคอม">จอคอม</a><a href="/รับซื้อ-ps5">PS5</a><a href="/รับซื้อ-jbl">JBL</a><a href="/รับซื้อ-marshall">Marshall</a></div>
  </div></section>
  <section class="bh-section bh-tint"><div class="bh-wrap"><div class="bh-section-heading"><div><p class="bh-eyebrow">ขายกับ BuyHub</p><h2>รู้ขั้นตอนก่อน เริ่มขายได้สบายใจ</h2></div><a href="/ขั้นตอนการขาย" class="bh-text-link">อ่านขั้นตอนทั้งหมด ↗</a></div><SellingSteps/></div></section>
  <section class="bh-section"><div class="bh-wrap"><div class="bh-section-heading"><div><p class="bh-eyebrow">ภาพสินค้าจาก BuyHub</p><h2>เห็นสินค้าจริง ก่อนเริ่มคุย</h2><p>ภาพสินค้าในเว็บไซต์ ใช้ประกอบการดูประเภทและการเตรียมรูปประเมิน</p></div><a class="bh-text-link" href="/ผลงานรับซื้อจริง">ดูภาพเพิ่มเติม ↗</a></div><ProductGallery limit={3}/></div></section>
  <section class="bh-section bh-tint"><div class="bh-wrap bh-two-columns"><div><p class="bh-eyebrow">ประเมินตามข้อมูลจริง</p><h2>ราคาไม่ได้ขึ้นอยู่กับ<br/>ชื่อรุ่นเพียงอย่างเดียว</h2><p class="bh-lead">รุ่น สเปก สภาพ แบตเตอรี่ ประกัน และอุปกรณ์ ล้วนมีผลต่อราคา เราขอข้อมูลก่อนเพื่อประเมินให้ใกล้เคียงกับสินค้าของคุณ</p><a class="bh-text-link" href="/คู่มือเตรียมสินค้าก่อนขาย">เตรียมข้อมูลก่อนส่งประเมิน ↗</a></div><div class="bh-checklist-card"><h3>ส่งข้อมูลให้ครบในครั้งเดียว</h3><ul class="bh-check-list"><li>รูปตัวเครื่องหลายมุมและจุดตำหนิ</li><li>ชื่อรุ่น สเปก หรือความจุ</li><li>สภาพการใช้งาน แบตเตอรี่ และประวัติซ่อม</li><li>อุปกรณ์ที่มี พร้อมจำนวนสินค้า</li><li>จังหวัดและอำเภอที่สะดวกส่งมอบ</li></ul><p>ราคาประเมินเป็นเบื้องต้น ราคาสุดท้ายยืนยันหลังตรวจสินค้าจริง</p></div></div></section>
  <section class="bh-section"><div class="bh-wrap"><div class="bh-business-panel"><div><p class="bh-eyebrow">สำหรับร้านค้าและองค์กร</p><h2>หลายเครื่อง หลายรายการ<br/>ส่งประเมินเป็นล็อตได้</h2><p>คอมสำนักงาน โน๊ตบุ๊ค และอุปกรณ์ไอทีที่เปลี่ยนใหม่ เริ่มจากส่งรายการ รุ่น จำนวน สภาพ และพื้นที่ให้ทีมงานพิจารณา</p><a class="bh-button" href="/รับซื้อคอมบริษัท">ดูบริการรับซื้อยกล็อต ↗</a></div><div class="bh-lot-list"><span>01 <strong>เตรียมรายการอุปกรณ์</strong></span><span>02 <strong>แนบรูปและสภาพจริง</strong></span><span>03 <strong>คุยราคาและการส่งมอบ</strong></span></div></div></div></section>
  <section class="bh-section bh-tint"><div class="bh-wrap bh-two-columns"><div><p class="bh-eyebrow">พื้นที่และการส่งมอบ</p><h2>เริ่มจากส่งรูป<br/>ยังไม่ต้องเดินทาง</h2><p class="bh-lead">ประเมินผ่าน LINE ก่อน แล้วคุยเรื่องเข้าร้าน นัดรับ หรือจัดส่งตามพื้นที่และเงื่อนไขที่ตกลง หน้าร้านหลักของผู้ดำเนินการอยู่ที่อุบลราชธานี</p><div class="bh-actions"><a class="bh-text-link" href="/พื้นที่ให้บริการ">ดูพื้นที่ให้บริการ ↗</a><a class="bh-text-link" href="/ติดต่อเรา">ที่อยู่และติดต่อทีมงาน ↗</a></div></div><div><p class="bh-eyebrow">รู้จัก BuyHub</p><h3 class="bh-large-heading">อีกช่องทางสำหรับ<br/>คนอยากขายไอที</h3><p>BuyHub เป็นแบรนด์บริการในเครือบริษัท อำพล เทรดดิ้ง จำกัด เราจัดข้อมูลให้คุณเลือกสินค้าที่ต้องการขาย เตรียมเครื่อง และสอบถามราคาได้อย่างเข้าใจง่าย</p><a class="bh-text-link" href="/เกี่ยวกับเรา">เกี่ยวกับ BuyHub ↗</a></div></div></section>
  <FaqAccordion items={faqs}/><BuyhubCta/>
</BaseLayout>
