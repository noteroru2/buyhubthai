    'ใช้หน้านี้เป็นจุดเริ่มต้นก่อนเลือกไปยังหน้าหมวดสินค้า หน้าจังหวัด หรือคู่มือที่ตรงกับสินค้าของคุณ',
    'ข้อมูลเรื่องราคาและขั้นตอนเป็นภาพรวม ส่วนราคาจริงยังอิงจากรุ่น สเปก สภาพ และอุปกรณ์ที่ส่งมาประเมิน',
    'หากอยู่ต่างจังหวัดในภาคอีสาน ควรแจ้งจังหวัดและอำเภอโดยประมาณตั้งแต่ข้อความแรกเพื่อให้ทีมงานแนะนำคิวและวิธีเริ่มต้นได้ตรงขึ้น'
  ],
  links: [
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขายทั้งหมด' },
    { href: '/พื้นที่ให้บริการ', label: 'ดูพื้นที่ให้บริการภาคอีสาน' },
    { href: '/ผลงานรับซื้อจริง', label: 'ดูผลงานรับซื้อจริง' }
  ]
} as const;
const homeKeywordCluster = buildHomeKeywordCluster();
const homeKeywordLead = joinThaiKeywordPreview(homeKeywordCluster.localIntent ?? [], 4, true);
const homeKeywordSupport = joinThaiKeywordPreview(homeKeywordCluster.modelIntent ?? [], 4, true);
const homeKeywordQuestions = joinThaiKeywordPreview(homeKeywordCluster.issueIntent ?? [], 4, true);
const homeKeywordPrice = joinThaiKeywordPreview(homeKeywordCluster.priceIntent ?? [], 3, true);
const homeKeywordDecision = joinThaiKeywordPreview(homeKeywordCluster.decisionIntent ?? [], 3, true);

const jsonLd = [
  webPageJsonLd({
    name: title,
    description,
    url: '/',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...homeEditorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  breadcrumbJsonLd([{ name: 'หน้าแรก', href: '/' }]),
  faqPageJsonLd([...homeFaqs])
];

const homeLongSections = [
  {
    heading: 'ก่อนขายสินค้า IT มือสองกับ BuyHub ควรคิดอะไรบ้าง',
    paragraphs: [
      'คนที่กำลังจะขายสินค้า IT มือสองมักมีคำถามคล้ายกันเสมอ เช่น ควรเช็กราคาอย่างไร ส่งข้อมูลอะไรถึงจะได้แนวราคาที่ใกล้เคียง ต้องล้างข้อมูลก่อนหรือไม่ และถ้าอยู่ต่างจังหวัดในภาคอีสานยังขายได้ไหม หน้าแรกของ BuyHub จึงไม่ควรทำหน้าที่เป็นเพียงจุดรวมลิงก์ไปยังหมวดต่าง ๆ แต่ต้องช่วยให้คนอ่านเห็นภาพรวมของกระบวนการตั้งแต่ต้นว่า การขายให้จบไวเริ่มจากการส่งข้อมูลที่ถูกต้อง ไม่ใช่เริ่มจากการต่อราคาแบบไม่มีข้อมูลอ้างอิง',
      'อีกประเด็นสำคัญคือความคาดหวังเรื่องราคา หลายคนเปรียบเทียบกับประกาศขายปลายทาง แต่การรับซื้อจริงจะดูทั้งรุ่น สเปก สภาพ แบต ตำหนิ อุปกรณ์ในชุด และความง่ายในการนำไปใช้งานต่อ ถ้าหน้าแรกอธิบายความจริงข้อนี้ได้ชัด คนอ่านจะเข้าใจตั้งแต่ต้นว่า BuyHub ประเมินจากสภาพจริง ไม่ได้กดราคาแบบเดาสุ่ม และนี่คือพื้นฐานสำคัญของคอนเทนต์ที่ดีทั้งสำหรับ SEO, AEO และประสบการณ์ใช้งานจริง'
    ],
    list: buyTypes.map((item) => `${item.t}: ${item.d}`)
  },
  {
    heading: 'วิธีใช้หน้าแรกนี้ให้คุ้มที่สุด ถ้าคุณยังไม่แน่ใจว่าควรไปหมวดไหน',
    paragraphs: [
      'ถ้าคุณยังไม่แน่ใจว่าสินค้าของตัวเองควรเริ่มจากหน้าไหน ให้คิดจาก “สิ่งที่คุณถืออยู่ในมือ” มากกว่าคีย์เวิร์ดที่กำลังค้นหา เช่น ถ้าเป็น iPhone, iPad หรือ MacBook ให้เริ่มที่หมวด Apple ถ้าเป็นโน๊ตบุ๊คหรือคอมเกมมิ่งให้ดูหมวดคอมและโน๊ตบุ๊คก่อน ส่วนถ้าเป็นงานหลายชิ้นจากบริษัทหรือสำนักงาน ให้ข้ามไปดูหมวดคอมบริษัทหรืออุปกรณ์สำนักงาน IT เพราะหน้าเหล่านี้มีบริบทและคำแนะนำต่างกันจริง',
      'หน้าแรกที่ดีต้องช่วยลดการคลิกแบบหลงทาง จึงควรตอบให้ได้ว่าผู้ใช้ควรไปต่อที่หน้าใดเมื่อมีเจตนาค้นหาต่างกัน คนที่อยากขายไวควรไปหมวดรับซื้อ คนที่ยังกังวลเรื่องข้อมูลควรอ่านคู่มือเตรียมสินค้าก่อนขาย คนที่อยากเข้าใจขั้นตอนควรดูหน้าขั้นตอนการขาย และคนที่อยากเช็กความน่าเชื่อถือควรดูรีวิวลูกค้าหรือผลงานรับซื้อจริง การมีเส้นทางชัดแบบนี้ช่วยทั้งคนอ่านและช่วยให้เสิร์ชเอนจินเข้าใจโครงสร้างข้อมูลของเว็บได้ดีขึ้น'
    ],
    links: [
      { href: '/รับซื้อ', label: 'ดูหมวดรับซื้อทั้งหมด' },
      { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'คู่มือเตรียมสินค้าก่อนขาย' },
      { href: '/ขั้นตอนการขาย', label: 'ขั้นตอนการขายกับ BuyHub' },
      { href: '/รีวิวลูกค้า', label: 'รีวิวลูกค้าและความน่าเชื่อถือ' },
      { href: '/ผลงานรับซื้อจริง', label: 'ตัวอย่างผลงานรับซื้อจริง' },
      { href: '/คำถามที่พบบ่อย', label: 'คำถามที่พบบ่อยก่อนขาย' }
    ]
  },
  {
    heading: 'ขายสินค้าในภาคอีสานให้ประเมินไว ควรแจ้งพื้นที่อย่างไร',
    paragraphs: [
      'สำหรับเว็บที่เน้น Local SEO และ GEO อย่าง BuyHub การระบุพื้นที่ไม่ใช่รายละเอียดเล็กน้อย แต่เป็นข้อมูลที่ช่วยให้การประเมินและการนัดงานเป็นจริงขึ้นทันที คนที่อยู่ในตัวเมืองและคนที่อยู่ต่างอำเภอมักมีข้อจำกัดเรื่องเวลา จุดนัด และวิธีส่งมอบไม่เหมือนกัน ถ้าคุณแจ้งจังหวัด อำเภอ และช่วงเวลาที่สะดวกตั้งแต่แรก ทีมงานจะช่วยแนะนำแนวทางที่เหมาะกับพื้นที่ได้ตรงกว่าเดิม',
      'มุมของคอนเทนต์ก็เช่นกัน หน้าแรกที่อธิบายบริบทพื้นที่อย่างชัดเจนจะทำให้คนในภาคอีสานรู้สึกว่าเว็บนี้ไม่ได้เป็นเพียงหน้ากลางที่เปลี่ยนชื่อจังหวัด แต่เป็นบริการที่เข้าใจการใช้งานจริงในพื้นที่ เมื่อผู้อ่านเห็นทั้งรายชื่อจังหวัดหลัก หมวดสินค้าที่รองรับ และวิธีเริ่มต้นอย่างง่าย ก็มีแนวโน้มจะส่งข้อมูลเข้ามาประเมินมากกว่าหน้าที่บอกแค่ “รับซื้อทั่วไทย” แบบกว้างเกินไป'
    ],
    list: provinces.map((province) => `พื้นที่หลักที่คนค้นหาบ่อย: ${province.label}`),
    note:
      'ถ้าอยู่ในพื้นที่ใกล้เคียงแต่ไม่เห็นชื่อจังหวัดในส่วนบนของหน้า สามารถเริ่มจากหน้าพื้นที่ให้บริการแล้วค่อยทัก LINE เพื่อยืนยันคิวและจุดนัดที่เหมาะสมได้'
  },
  {
    heading: 'สรุปแนวทางเริ่มต้นแบบ 3 นาทีสำหรับคนที่อยากเช็กราคาก่อนขาย',
    paragraphs: [
      'ถ้าคุณมีเวลาไม่มาก วิธีเริ่มที่ดีที่สุดคือรวบรวมข้อมูลให้ครบในรอบเดียวแล้วค่อยส่งมาประเมิน ขั้นแรกถ่ายรูปหลายมุมให้เห็นสภาพจริง ขั้นต่อมาระบุรุ่นหรือสเปกให้ชัด ถ้ามีอาการผิดปกติให้แจ้งตามจริง และสุดท้ายบอกจังหวัดหรือพื้นที่โดยประมาณ เมื่อทำครบสี่ขั้นตอนนี้แล้ว การประเมินจะรวดเร็วและใกล้เคียงกว่าการคุยแบบค่อย ๆ เติมข้อมูลไปเรื่อย ๆ',
      'คอนเทนต์บนหน้าแรกควรช่วยให้ผู้อ่านไปถึงจุดนี้ได้ภายในไม่กี่นาที เพราะเป้าหมายของ BuyHub ไม่ใช่แค่ดึงทราฟฟิก แต่คือทำให้คนขายรู้ว่าตัวเองควรทำอะไรต่อ หากอ่านจบแล้วรู้ว่าจะไปหมวดไหน จะส่งข้อมูลอะไร และควรอ่านบทความอะไรเพิ่มในกรณีที่ยังมีข้อกังวล ก็ถือว่าหน้านี้ทำหน้าที่ได้ครบทั้งเชิงธุรกิจและเชิง SEO แล้ว'
    ],
    orderedList: checklist
  }
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/images/og/buyhub-home-share.png"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'หน้าแรก', href: '/' }]}
>
  <section
    class="relative isolate overflow-x-hidden bg-[#07111F] text-white"
    aria-labelledby="hero-heading"
    style="background-image: radial-gradient(circle at top left, rgba(16,185,129,0.18), transparent 32%), radial-gradient(circle at top right, rgba(245,184,75,0.10), transparent 28%), linear-gradient(135deg, #07111F 0%, #0B1728 55%, #07111F 100%);"
  >
    <div
      class="relative mx-auto grid min-h-0 min-w-0 max-w-7xl grid-cols-1 items-center gap-8 px-4 py-16 sm:px-6 sm:py-20 lg:min-h-[72vh] lg:grid-cols-[minmax(0,1fr)_minmax(0,38.75rem)] lg:items-center lg:gap-10 lg:px-8 lg:py-24 xl:gap-12 xl:py-28"
    >
      <div class="min-w-0 lg:pr-2">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-emerald-300/95 backdrop-blur-sm sm:text-xs">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400" aria-hidden="true" />
          buyhubthai.com · IT Buyback
        </p>
        <h1
          id="hero-heading"
          class="mt-11 text-[1.9rem] font-bold leading-tight tracking-tight text-white antialiased sm:mt-12 sm:text-[2.35rem] lg:mt-[3.25rem] lg:text-5xl xl:text-[3.35rem]"
        >
          BuyHub ศูนย์รับซื้อสินค้าไอที<span class="text-emerald-300">มือสอง</span>ทั่วภาคอีสาน
        </h1>
        <p class="mt-11 max-w-[40rem] text-base leading-8 text-slate-300">
          รับซื้อโน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad กล้อง อุปกรณ์เกมมิ่ง และสินค้า IT ทุกประเภท ส่งรูปผ่าน LINE <span class="font-semibold text-emerald-200">@buyhub</span> เพื่อประเมินราคาฟรีก่อนตัดสินใจขาย
        </p>
        <div class="mt-14 flex min-w-0 max-w-full flex-col gap-3 sm:flex-row sm:items-stretch sm:gap-4">
          <LineCtaButton
            variant="primary"
            label="ส่งรูปประเมินราคาฟรีผ่าน LINE"
            class="w-full min-w-0 text-base ring-2 ring-emerald-400/40 sm:flex-1 sm:py-4 lg:text-lg"
          />
          <PhoneCtaButton variant="onDark" class="w-full min-w-0 min-h-[3.25rem] justify-center sm:flex-1 sm:py-4" />
        </div>
        <p class="mt-10 max-w-xl text-sm leading-7 text-slate-300 sm:leading-8">
          ประเมินราคาฟรี • แจ้งราคาก่อนขาย • รับซื้อหลายหมวดสินค้า • ให้บริการภาคอีสาน
        </p>
        <ul
          class="mt-12 flex flex-wrap gap-2.5 sm:gap-3"
          aria-label="จุดเด่นบริการ"
        >
          <li class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/20 bg-amber-400/10 px-3.5 py-2 text-xs font-semibold text-amber-200 backdrop-blur-sm sm:text-sm">
            <span class="text-amber-300/90" aria-hidden="true">★</span> ประเมินฟรี
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/20 bg-amber-400/10 px-3.5 py-2 text-xs font-semibold text-amber-200 backdrop-blur-sm sm:text-sm">
            <span class="text-amber-300/90" aria-hidden="true">★</span> โอนเงินทันทีหลังตกลง
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/20 bg-amber-400/10 px-3.5 py-2 text-xs font-semibold text-amber-200 backdrop-blur-sm sm:text-sm">
            <span class="text-amber-300/90" aria-hidden="true">★</span> รับซื้อถึงที่
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/20 bg-amber-400/10 px-3.5 py-2 text-xs font-semibold text-amber-200 backdrop-blur-sm sm:text-sm">
            <span class="text-amber-300/90" aria-hidden="true">★</span> มีหน้าร้านจริง
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/35 bg-emerald-500/10 px-3.5 py-2 text-xs font-medium text-emerald-100 backdrop-blur-sm sm:text-sm">
            <span class="text-emerald-400" aria-hidden="true">✓</span> แจ้งราคาก่อนนัดตรวจ
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3.5 py-2 text-xs font-medium text-slate-200 backdrop-blur-sm sm:text-sm">
            <span class="text-emerald-400" aria-hidden="true">✓</span> รับซื้อตามสภาพจริง
          </li>
          <li class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3.5 py-2 text-xs font-medium text-slate-200 backdrop-blur-sm sm:text-sm">
            <span class="text-emerald-400" aria-hidden="true">✓</span> ไม่บังคับขาย
          </li>
        </ul>
      </div>

      <div class="relative min-w-0 w-full max-w-full lg:flex lg:justify-end">
        <figure
          class="relative mx-auto w-full max-w-full overflow-hidden rounded-2xl border border-white/10 bg-[#050b14] shadow-2xl shadow-black/45 lg:mx-0 lg:max-w-[min(38.75rem,100%)]"
        >
          <div
            class="relative aspect-[819/1024] w-full max-w-full overflow-hidden rounded-2xl"
          >
            <picture class="absolute inset-0 block h-full w-full">
              <source srcset="/images/hero/buyhub-hero.webp" type="image/webp" />
              <img
                src="/images/hero/buyhub-hero.png"
                alt="BuyHub แบนเนอร์รับซื้อสินค้าไอทีมือสอง ประเมินไว โอนเงินหลังตกลง แอด LINE @buyhub โทรประเมินราคาฟรี ภาคอีสาน"
                width="819"
                height="1024"
                class="block h-full w-full max-w-full rounded-2xl object-contain object-center"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section
    class="border-b border-white/10 bg-[#0a1624] py-5 text-white"
    aria-label="จุดเด่นด้านความน่าเชื่อถือ"
  >
    <div class="mx-auto min-w-0 max-w-7xl px-4 sm:px-6 lg:px-8">
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
        {
          trustBarItems.map((item) => (
            <li class="flex min-w-0 items-start gap-2.5 rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-3 sm:px-4">
              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-200 ring-1 ring-emerald-500/25" aria-hidden="true">
                ✓
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold tracking-tight text-white">{item.title}</span>
                <span class="mt-1 block text-left text-xs leading-relaxed text-slate-300 sm:text-[0.8125rem] sm:leading-snug">
                  {item.sub}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-slate-200/80 bg-white py-8 sm:py-10" aria-label="ข้อมูลการตรวจทานหน้าแรก">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <EditorialTrustPanel
        reviewedAt={EDITORIAL_REVIEWED_AT}
        reviewedBy={EDITORIAL_REVIEWER}
        scope={homeEditorialSignals.scope}
        notes={[...homeEditorialSignals.notes]}
        links={[...homeEditorialSignals.links]}
      />
