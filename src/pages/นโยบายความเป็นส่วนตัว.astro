---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineCtaButton from '../components/LineCtaButton.astro';
import PhoneCtaButton from '../components/PhoneCtaButton.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import LongformSections from '../components/LongformSections.astro';
import { breadcrumbJsonLd, webPageJsonLd } from '../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER } from '../lib/constants';

const title = 'นโยบายความเป็นส่วนตัว BuyHub';
const description =
  'นโยบายความเป็นส่วนตัวของ BuyHub เกี่ยวกับการรับข้อมูลลูกค้า รูปสินค้า เบอร์โทร LINE และข้อมูลที่ใช้เพื่อประเมินราคาสินค้า IT มือสอง';

const editorialSignals = {
  scope:
    'หน้านโยบายความเป็นส่วนตัวอธิบายขอบเขตข้อมูลที่ BuyHub จำเป็นต้องใช้เพื่อประเมินราคา วิธีลดการส่งข้อมูลเกินจำเป็น และช่องทางที่ลูกค้าสามารถขอแก้ไขหรือลบข้อมูลได้',
  about: ['นโยบายความเป็นส่วนตัว BuyHub', 'ข้อมูลที่ใช้ประเมินราคาสินค้า IT มือสอง', 'สิทธิ์การแก้ไขและลบข้อมูล'],
  notes: [
    'เน้นให้ลูกค้าแยกให้ออกว่าข้อมูลใดจำเป็นต่อการประเมิน และข้อมูลใดไม่ควรส่งเข้ามาเกินความจำเป็น',
    'ตัวอย่างภาพหรือรีวิวที่อ้างอิงลูกค้าจริงควรถูกปิดข้อมูลส่วนตัวก่อนเผยแพร่เสมอ',
    'หากต้องการให้แก้ไขหรือลบข้อมูล ควรใช้ช่องทางติดต่อที่ระบุไว้ในเว็บเพื่อให้ทีมงานตรวจสอบและดำเนินการได้เร็ว'
  ],
  links: [
    { href: '/ติดต่อเรา', label: 'ติดต่อเพื่อขอแก้ไขหรือลบข้อมูล' },
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'ดูคู่มือเตรียมสินค้าก่อนขาย' },
    { href: '/รีวิวลูกค้า', label: 'ดูตัวอย่างรีวิวที่ปิดข้อมูลส่วนตัว' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: 'นโยบายความเป็นส่วนตัว', href: '/นโยบายความเป็นส่วนตัว' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/นโยบายความเป็นส่วนตัว',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  })
];

const privacySections = [
  {
    heading: 'นโยบายความเป็นส่วนตัวของ BuyHub ควรช่วยให้ลูกค้าเข้าใจอะไรได้บ้าง',
    paragraphs: [
      'สำหรับบริการรับซื้อสินค้าไอทีมือสอง ความเป็นส่วนตัวไม่ใช่หัวข้อปลายทางที่มีไว้เพื่อให้กฎหมายครบเท่านั้น แต่เป็นหัวใจของความมั่นใจตั้งแต่ก่อนเริ่มคุยจริง เพราะสินค้าที่ลูกค้าส่งมาประเมินมักเชื่อมกับข้อมูลส่วนตัวโดยตรง เช่น รูปถ่ายในเครื่อง รายชื่อผู้ติดต่อ บัญชีอีเมล ประวัติการใช้งาน หรือภาพหน้าจอที่อาจเผลอมีข้อมูลสำคัญติดมาด้วย นโยบายหน้านี้จึงควรช่วยให้ลูกค้าเห็นภาพชัดว่า BuyHub ต้องการข้อมูลอะไรเพื่อประเมินราคา ต้องการเพียงเท่าที่จำเป็นแค่ไหน และลูกค้าสามารถควบคุมข้อมูลของตัวเองได้อย่างไรตลอดกระบวนการ ตั้งแต่ตอนส่งรูปครั้งแรกไปจนถึงก่อนส่งมอบเครื่องจริง',
      'อีกประเด็นที่สำคัญไม่แพ้กันคือการทำให้ลูกค้ารู้สึกว่าอ่านแล้วเข้าใจได้ทันที ไม่ต้องตีความเชิงกฎหมายอย่างเดียว เช่น เมื่อลูกค้าต้องส่งรูปสินค้าเพื่อประเมินราคา คำอธิบายที่ดีควรบอกให้ชัดว่าควรหลีกเลี่ยงการส่งภาพที่มีข้อมูลส่วนตัวเกินจำเป็น หากมีภาพตัวอย่างรีวิวหรือหลักฐานประกอบใดที่นำมาใช้เผยแพร่ จะต้องมีการปิดข้อมูลส่วนบุคคลก่อนเสมอ และหากลูกค้าเคยส่งข้อมูลเข้ามาแล้วแต่ภายหลังต้องการให้ลบออก ก็ควรมีช่องทางร้องขอที่ตรงไปตรงมา หน้านี้จึงไม่ควรเป็นเพียงข้อความเพื่อป้องกันความรับผิด แต่ควรเป็นหน้าที่ทำให้ลูกค้ารู้สึกปลอดภัยพอจะเริ่มต้นพูดคุยกับ BuyHub ได้จริง'
    ]
  },
  {
    heading: 'ข้อมูลประเภทใดที่ BuyHub จำเป็นต้องใช้ และข้อมูลใดที่ลูกค้าไม่ควรส่งเกินความจำเป็น',
    paragraphs: [
      'โดยหลักแล้วข้อมูลที่จำเป็นต่อการประเมินราคาสินค้าไอทีมือสองมีอยู่ไม่กี่กลุ่ม ได้แก่ รูปสินค้าหลายมุม ข้อมูลรุ่นหรือสเปก ความจุ อุปกรณ์ที่มีร่วมในชุด อาการใช้งานหรือจุดตำหนิที่ควรทราบ และจังหวัดหรือพื้นที่โดยประมาณเพื่อช่วยเรื่องคิวและรูปแบบการรับส่งมอบ ข้อมูลกลุ่มนี้ช่วยให้ทีมงานประเมินได้ใกล้เคียงมากขึ้นโดยไม่จำเป็นต้องเข้าถึงข้อมูลเชิงลึกในเครื่องของลูกค้า เช่น ไฟล์ส่วนตัว รายชื่อผู้ติดต่อ หรือภาพหน้าจอจากแอปที่มีข้อมูลส่วนบุคคล เพราะในการประเมินเบื้องต้น BuyHub ต้องการเพียงข้อมูลด้านตัวสินค้า ไม่ใช่เนื้อหาภายในชีวิตดิจิทัลของผู้ขาย',
      'ดังนั้นลูกค้าจึงไม่ควรส่งข้อมูลเกินจำเป็น เช่น เลขบัตรประชาชน รายละเอียดบัญชีธนาคารที่ไม่เกี่ยวข้อง รหัสผ่าน รหัสยืนยันตัวตน ภาพเอกสารที่มีข้อมูลอ่อนไหว หรือภาพหน้าจอที่เผยให้เห็นหมายเลขเครื่องพร้อมข้อมูลส่วนตัวอื่นโดยไม่จำเป็น หากจำเป็นต้องส่งภาพหน้าจอเพื่อยืนยันรุ่น ความจุ หรือสุขภาพแบต ควรครอปเฉพาะส่วนสำคัญให้มากที่สุด การแยกแยะระหว่างข้อมูลที่จำเป็นกับข้อมูลที่ไม่จำเป็นแบบนี้เป็นหลักคิดพื้นฐานที่ช่วยลดความเสี่ยงทั้งสำหรับลูกค้าและสำหรับผู้ให้บริการ เพราะยิ่งมีข้อมูลส่วนเกินอยู่ในแชทหรือเอกสารน้อยเท่าไร การจัดการความเป็นส่วนตัวก็ยิ่งชัดและปลอดภัยมากขึ้นเท่านั้น'
    ],
    list: [
      'ข้อมูลที่ควรส่ง: รูปสินค้า รุ่น สเปก ความจุ ตำหนิ อุปกรณ์ และพื้นที่โดยประมาณ',
      'ข้อมูลที่ไม่ควรส่งเกินจำเป็น: รหัสผ่าน รหัส OTP เอกสารส่วนตัวเต็มฉบับ หรือรูปที่เปิดเผยข้อมูลเกินความจำเป็น',
      'หากต้องส่งภาพหน้าจอเพื่อยืนยันรุ่นหรือแบต ควรครอปเฉพาะส่วนที่เกี่ยวข้อง',
      'หากเป็นเครื่ององค์กร ควรให้ผู้รับผิดชอบภายในตรวจความพร้อมของข้อมูลก่อนทุกครั้ง'
    ]
  },
  {
    heading: 'ก่อนส่งข้อมูลมาประเมิน ลูกค้าควรปกป้องความเป็นส่วนตัวของตัวเองอย่างไร',
    paragraphs: [
      'วิธีที่ง่ายที่สุดในการปกป้องความเป็นส่วนตัวคือเริ่มจากการตั้งสติว่า “ข้อมูลที่กำลังจะส่งจำเป็นต่อการประเมินหรือไม่” หากจำเป็นเพียงเพื่อให้เห็นรุ่นหรือสภาพเครื่อง ให้ถ่ายภาพภายนอก ตัวเครื่อง อุปกรณ์ และจุดตำหนิเป็นหลัก หากต้องเปิดหน้าการตั้งค่าเพื่อดูรุ่น ความจุ หรือสุขภาพแบตเตอรี่ ก็ควรตรวจดูว่าหน้าจอนั้นมีชื่อบัญชี อีเมล รูปโปรไฟล์ หรือข้อมูลอื่นที่สามารถระบุตัวตนได้หรือไม่ ถ้ามีควรครอปหรือปิดไว้ก่อน หลักคิดนี้ใช้ได้กับทั้ง iPhone, iPad, MacBook, โน๊ตบุ๊ค Windows, เครื่องเกม และอุปกรณ์อื่นทุกประเภท',
      'เมื่อถึงขั้นก่อนส่งมอบเครื่องจริง ลูกค้าควรดำเนินการสำรองและลบข้อมูลส่วนตัว รวมถึงออกจากบัญชีที่ผูกกับอุปกรณ์ให้เรียบร้อยตามประเภทของสินค้า เช่น ออกจาก iCloud หรือ Apple ID ในอุปกรณ์ Apple ออกจากบัญชี Google ในเครื่อง Android ตรวจระบบล็อกอย่าง FRP หรือ MDM สำหรับเครื่ององค์กร และเช็กไฟล์งานในคอมพิวเตอร์ให้เรียบร้อยก่อนรีเซ็ต หลายครั้งปัญหาความเป็นส่วนตัวไม่ได้เกิดจากผู้ให้บริการ แต่เกิดจากการเร่งขายโดยยังไม่ได้ทบทวนข้อมูลในเครื่องของตัวเอง หน้านโยบายที่ดีจึงควรช่วยให้ลูกค้าเตรียมตัวได้ปลอดภัยตั้งแต่ยังไม่เริ่มนัดจริง'
    ],
    orderedList: [
      'ตรวจว่ารูปหรือไฟล์ที่กำลังจะส่งมีข้อมูลส่วนตัวเกินจำเป็นหรือไม่',
      'ครอปหรือปิดข้อมูลส่วนตัวในภาพหน้าจอที่ใช้ยืนยันรุ่น ความจุ หรือแบต',
      'สำรองข้อมูลสำคัญไว้ก่อนเริ่มลบบัญชีหรือรีเซ็ตเครื่อง',
      'ออกจากบัญชีที่ผูกกับอุปกรณ์ทุกระบบที่เกี่ยวข้อง',
      'ทบทวนอีกครั้งก่อนส่งมอบจริงว่าข้อมูลส่วนตัวไม่ค้างอยู่ในเครื่องแล้ว'
    ]
  },
  {
    heading: 'การเก็บรักษา ใช้ และลบข้อมูลของลูกค้าควรถูกอธิบายแบบไหนจึงจะโปร่งใส',
    paragraphs: [
      'ความโปร่งใสที่แท้จริงไม่ได้อยู่ที่การบอกเพียงว่าเก็บข้อมูลอย่างปลอดภัย แต่อยู่ที่การบอกให้ชัดว่าข้อมูลถูกใช้เพื่ออะไร ใช้นานเท่าไร และเมื่อใดที่ควรถูกลบหรือทำให้ไม่สามารถระบุตัวบุคคลได้ สำหรับ BuyHub ข้อมูลที่ได้รับจากลูกค้าควรถูกใช้เพื่อการประเมินราคา การตอบคำถาม การวางแผนการนัดหมาย และการประสานงานตามคำร้องขอของลูกค้าเท่านั้น หากหมดความจำเป็นแล้ว ก็ควรมีแนวทางในการลบ จัดเก็บจำกัดเวลา หรือทำให้ข้อมูลไม่เชื่อมโยงกับตัวตนเดิม เพื่อไม่ให้ข้อมูลกระจายเกินขอบเขตของวัตถุประสงค์แรกที่ลูกค้าเข้าใจไว้',
      'ในเชิงปฏิบัติ การอธิบายเรื่องนี้อย่างตรงไปตรงมาช่วยลดความกังวลได้มาก เช่น ลูกค้าหลายคนต้องการรู้ว่ารูปสินค้าที่ส่งมาจะถูกนำไปใช้เป็นรีวิวหรือไม่ คำตอบที่ชัดควรเป็นว่า หากมีการใช้ภาพเพื่อแสดงตัวอย่างงานหรือรีวิว จะต้องปิดข้อมูลส่วนบุคคลก่อนและทำบนพื้นฐานที่เหมาะสม ไม่ใช่หยิบไปใช้โดยอัตโนมัติ การสื่อสารแนวนี้ช่วยให้ลูกค้าเห็นว่า BuyHub ไม่ได้มองข้อมูลที่ได้รับเป็นทรัพยากรอิสระ แต่เป็นข้อมูลที่อยู่ภายใต้ความไว้วางใจของเจ้าของข้อมูล และต้องมีขอบเขตการใช้ที่ตรวจสอบได้'
    ],
    note:
      'หากลูกค้าไม่สบายใจเรื่องข้อมูลบางรายการ ควรเลือกส่งเฉพาะข้อมูลที่จำเป็นต่อการประเมินเบื้องต้นก่อน แล้วค่อยยืนยันรายละเอียดเพิ่มเติมเมื่อจำเป็นจริง'
  },
  {
    heading: 'กรณีรีวิว ภาพแชท และหลักฐานประกอบ ควรจัดการข้อมูลส่วนบุคคลอย่างไร',
