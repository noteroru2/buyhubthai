---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineCtaButton from '../components/LineCtaButton.astro';
import PhoneCtaButton from '../components/PhoneCtaButton.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LongformSections from '../components/LongformSections.astro';
import { breadcrumbJsonLd, faqPageJsonLd, webPageJsonLd } from '../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER, SITE_NAME } from '../lib/constants';

const title = 'เกี่ยวกับ BuyHub ศูนย์รับซื้อสินค้าไอทีมือสอง';
const description =
  'รู้จัก BuyHub ศูนย์รับซื้อสินค้าไอทีมือสอง รับซื้อโน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad กล้อง และอุปกรณ์ IT ในภาคอีสาน ประเมินราคาฟรีผ่าน LINE @buyhub';

const faqs = [
  {
    q: 'BuyHub รับซื้ออะไรบ้าง',
    a: 'รับซื้อสินค้าไอทีมือสองหลายหมวด เช่น โน๊ตบุ๊ค/คอมพิวเตอร์ MacBook iPhone iPad แท็บเล็ต กล้อง จอคอม การ์ดจอ อุปกรณ์เกมมิ่ง และอุปกรณ์สำนักงาน IT โดยประเมินตามรุ่น สเปก สภาพ และราคาตลาด'
  },
  {
    q: 'ประเมินราคาฟรีไหม และต้องส่งข้อมูลอะไร',
    a: 'ประเมินฟรี แนะนำส่งรูปหลายมุม (รวมตำหนิ) + รุ่น/สเปกหรือความจุ + สุขภาพแบต (ถ้าดูได้) + อุปกรณ์ในชุด และจังหวัด/พื้นที่ เพื่อให้ประเมินได้ไวและใกล้เคียง'
  },
  {
    q: 'รับซื้อแบบงานองค์กร/คอมบริษัทจำนวนมากไหม',
    a: 'รับประเมินได้ แนะนำทำรายการ (รุ่น/สเปก/จำนวน/สภาพ) และส่งไฟล์/รูปตัวอย่างเพื่อให้ทีมงานประเมินและวางแผนคิวได้เหมาะสม'
  },
  {
    q: 'ราคาประเมินกับราคาจริงต่างกันไหม',
    a: 'ราคาประเมินเป็นแนวทางจากข้อมูลที่ส่ง ราคาสุดท้ายคอนเฟิร์มหลังตรวจสภาพจริง หากข้อมูลตรงกันราคามักใกล้เคียงเดิม และจะแจ้งเหตุผลให้ชัดเจนก่อนปรับราคาเสมอ'
  },
  {
    q: 'ต้องล้างข้อมูลก่อนส่งมอบไหม',
    a: 'แนะนำให้สำรองและลบข้อมูลส่วนตัว รวมถึงออกจากบัญชีที่ผูกไว้ก่อนส่งมอบทุกครั้ง เพื่อความปลอดภัยของข้อมูล ดูแนวทางได้ที่หน้า “คู่มือเตรียมสินค้าก่อนขาย”'
  }
];

const editorialSignals = {
  scope:
    'หน้าเกี่ยวกับเราอธิบายตัวตน หลักการทำงาน และแนวคิดด้านความโปร่งใสของ BuyHub เพื่อให้ผู้อ่านเข้าใจว่าเว็บนี้ช่วยอะไรได้มากกว่าแค่บอกราคา',
  about: ['เกี่ยวกับ BuyHub', 'หลักการประเมินราคาอย่างโปร่งใส', 'บริการรับซื้อสินค้า IT มือสอง'],
  notes: [
    'เน้นอธิบายวิธีคิดของบริการ ความเหมาะสมของกลุ่มลูกค้า และเหตุผลที่เว็บมีคู่มือ ขั้นตอน และ FAQ รองรับ',
    'ข้อมูลในหน้านี้เชื่อมต่อกับหน้าหลักฐานความน่าเชื่อถือ เช่น รีวิวลูกค้าและผลงานรับซื้อจริง',
    'หากต้องการดูขั้นตอนใช้งานจริงต่อจากการรู้จักแบรนด์ ควรไปหน้าขั้นตอนการขายหรือหน้าติดต่อโดยตรง'
  ],
  links: [
    { href: '/รีวิวลูกค้า', label: 'ดูรีวิวลูกค้า' },
    { href: '/ผลงานรับซื้อจริง', label: 'ดูผลงานรับซื้อจริง' },
    { href: '/ติดต่อเรา', label: 'ดูช่องทางติดต่อ' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: 'เกี่ยวกับเรา', href: '/เกี่ยวกับเรา' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/เกี่ยวกับเรา',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  faqPageJsonLd(faqs.map((f) => ({ question: f.q, answer: f.a })))
];

const aboutSections = [
  {
    heading: 'BuyHub คือใคร และหน้ารู้จักเราไม่ควรพูดแค่คำว่า “รับซื้อไอที”',
    paragraphs: [
      'หน้ารู้จักเราควรทำหน้าที่มากกว่าการบอกชื่อแบรนด์และลิสต์หมวดสินค้า เพราะสิ่งที่ผู้ใช้ต้องการรู้จริงคือ BuyHub ทำงานด้วยวิธีคิดแบบไหน โปร่งใสหรือไม่ และเข้าใจปัญหาของคนขายสินค้า IT มือสองแค่ไหน สำหรับบริการประเภทนี้ ความน่าเชื่อถือไม่ได้เกิดจากคำโฆษณาเพียงอย่างเดียว แต่เกิดจากการทำให้ผู้อ่านเห็นหลักการทำงานและสิ่งที่แบรนด์ให้ความสำคัญอย่างชัดเจน',
      'BuyHub จึงควรถูกอธิบายว่าเป็นผู้ช่วยให้คนขายรู้ข้อมูลก่อนตัดสินใจ ไม่ใช่เพียงผู้รับซื้อที่ตอบราคาอย่างเดียว เพราะสิ่งที่สร้างความแตกต่างจริงคือการทำให้คนขายเข้าใจขั้นตอน รู้ว่าต้องเตรียมอะไร และมีพื้นที่ในการตัดสินใจโดยไม่ถูกกดดัน'
    ]
  },
  {
    heading: 'หลักการทำงานแบบโปร่งใสของ BuyHub สำคัญอย่างไร',
    paragraphs: [
      'หลักการสำคัญของ BuyHub คือประเมินจากข้อมูลและสภาพจริง แจ้งเหตุผลของราคา และทำให้ผู้ขายเข้าใจเงื่อนไขก่อนตกลงขาย หลักการนี้อาจดูเรียบง่าย แต่เป็นสิ่งที่ผู้ใช้มองหามากที่สุดในตลาดรับซื้อสินค้า IT เพราะหลายคนเคยเจอประสบการณ์ที่ไม่ชัดเจน เช่น ได้ราคาแบบไม่มีเหตุผลรองรับ หรือถูกเร่งให้ตัดสินใจโดยยังไม่เข้าใจขั้นตอนทั้งหมด',
      'เมื่อแบรนด์อธิบายหลักการเหล่านี้ชัดในหน้ารู้จักเรา คนอ่านจะมองเห็นภาพว่า BuyHub ให้ค่ากับความตรงไปตรงมา การเคารพข้อมูลส่วนตัว และการประเมินที่อ้างอิงกับสภาพจริง ไม่ใช่การกดราคาแบบสุ่ม ซึ่งเป็นรากฐานสำคัญของความเชื่อถือระยะยาว'
    ]
  },
  {
    heading: 'ทำไม BuyHub จึงเน้นคอนเทนต์เรื่องคู่มือ ขั้นตอน และ FAQ',
    paragraphs: [
      'คนที่ขายสินค้า IT มือสองจำนวนมากไม่ได้พร้อมทักประเมินทันที แต่ต้องการคำตอบก่อน เช่น ต้องล้างข้อมูลไหม ออกจาก iCloud อย่างไร หรือขายจากต่างจังหวัดได้หรือเปล่า การมีหน้าคู่มือ ขั้นตอน และ FAQ จึงไม่ได้เป็นเพียงการเพิ่มเนื้อหาในเว็บ แต่เป็นการช่วยให้ผู้ใช้ขยับจากความไม่แน่ใจไปสู่การลงมือทำได้เร็วขึ้น',
      'ในมุมของแบรนด์ นี่คือการสร้างประสบการณ์ที่ลดแรงเสียดทานก่อนเริ่มแชท เมื่อลูกค้าอ่านข้อมูลพื้นฐานจนเข้าใจแล้ว การคุยรอบแรกจะมีคุณภาพขึ้นมาก เพราะผู้ขายมักส่งข้อมูลครบและถามคำถามที่เฉพาะเจาะจงกว่าเดิม'
    ],
    links: [
      { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'คู่มือเตรียมสินค้าก่อนขาย' },
      { href: '/ขั้นตอนการขาย', label: 'ขั้นตอนการขาย' },
      { href: '/คำถามที่พบบ่อย', label: 'คำถามที่พบบ่อย' },
      { href: '/บทความ', label: 'บทความและคู่มือทั้งหมด' }
    ]
  },
  {
    heading: 'BuyHub เหมาะกับใครบ้าง ตั้งแต่บุคคลทั่วไปจนถึงองค์กร',
    paragraphs: [
      'บริการของ BuyHub เหมาะทั้งกับคนขายเครื่องเดียวที่อยากรู้ราคาก่อนตัดสินใจ คนที่อัปเกรดอุปกรณ์พร้อมกันหลายชิ้น ร้านค้าที่ต้องการระบายสต็อกบางส่วน และองค์กรที่มีสินทรัพย์ไอทีหลายรายการต้องจัดการ จุดร่วมของผู้ใช้ทั้งหมดคืออยากได้กระบวนการที่ชัด ประเมินจากข้อมูลจริง และรู้ว่าต้องทำอะไรต่อในแต่ละขั้นตอน',
      'การบอกสิ่งนี้ในหน้ารู้จักเรา ช่วยให้ผู้ใช้รู้ว่าตัวเองอยู่ในกลุ่มที่แบรนด์รองรับจริง ไม่ต้องเดาเอาเองจากชื่อหน้าเพียงอย่างเดียว และยังช่วยขยายความครอบคลุมของเนื้อหาให้สัมพันธ์กับบริการหลักหลายรูปแบบ'
    ]
  },
  {
    heading: 'สรุป: หลังอ่านหน้ารู้จักเรา ควรเข้าใจอะไรเกี่ยวกับแบรนด์นี้',
    paragraphs: [
      'หากหน้ารู้จักเราทำงานได้ดี คนอ่านควรออกไปพร้อมความเข้าใจสามเรื่อง คือ BuyHub เน้นประเมินตามสภาพจริงและอธิบายเหตุผลของราคา มีคอนเทนต์ช่วยเตรียมตัวก่อนขายครบทั้งคู่มือ ขั้นตอน และ FAQ และรองรับการขายหลายหมวดทั้งในระดับบุคคลทั่วไปและองค์กร',
      'เมื่อได้ภาพรวมเหล่านี้แล้ว ขั้นต่อไปของผู้อ่านควรเป็นการไปยังหน้าหมวดที่ตรงกับสินค้าของตัวเอง หรือเตรียมข้อมูลแล้วเริ่มคุยผ่าน LINE เพื่อเปลี่ยนจากความสนใจไปสู่การประเมินจริงอย่างมีข้อมูล'
    ]
  }
];

aboutSections.push(
  {
    heading: 'บทบาทของ BuyHub ในตลาดรับซื้อสินค้าไอทีมือสองภาคอีสานควรถูกเล่าอย่างไร',
    paragraphs: [
      'หากจะอธิบาย BuyHub ให้ชัดในฐานะแบรนด์ หน้ารู้จักเราควรทำให้ผู้อ่านเห็นว่าเว็บไซต์นี้ไม่ได้เป็นเพียงหน้ารับประเมินราคาทั่วไป แต่เป็นศูนย์กลางข้อมูลและบริการที่ช่วยให้คนขายสินค้าไอทีมือสองในภาคอีสานตัดสินใจได้ง่ายขึ้น การขายสินค้าประเภทนี้มีความซับซ้อนกว่าสินค้าทั่วไป เพราะเกี่ยวข้องกับรุ่น สเปก สภาพ อุปกรณ์ ระบบล็อก บัญชีผู้ใช้ และประเด็นข้อมูลส่วนตัว หากไม่มีพื้นที่ที่อธิบายเรื่องเหล่านี้อย่างเป็นระบบ ผู้ขายจำนวนมากจะลังเลตั้งแต่ก่อนเริ่มคุยจริง',
      'บทบาทของ BuyHub จึงควรถูกเล่าว่าเป็นทั้งผู้รับประเมินและผู้ช่วยแปลภาษาทางเทคนิคให้คนขายเข้าใจได้ง่าย เช่น ทำไม MacBook ต้องเช็กแบต ทำไม iPhone ต้องออกจาก iCloud ทำไมงานบริษัทต้องจัดรายการก่อน หรือทำไมคนขายต่างจังหวัดควรแจ้งพื้นที่ตั้งแต่รอบแรก การเล่าตัวตนแบบนี้ช่วยให้ผู้อ่านเห็นว่า BuyHub เข้าใจบริบทของการขายจริง ไม่ใช่เพียงรวบรวมคีย์เวิร์ดหน้าบริการไว้จำนวนมากโดยไม่มีแกนความคิดรองรับ'
    ]
  },
  {
    heading: 'ความเชื่อมโยงระหว่างข้อมูล ความโปร่งใส และความไว้วางใจที่ BuyHub ควรสร้าง',
    paragraphs: [
      'แบรนด์ในกลุ่มรับซื้อสินค้าไอทีจะสร้างความไว้วางใจได้ยากหากอาศัยเพียงคำโฆษณาว่ารับซื้อให้ราคาดีหรือประเมินไว เพราะผู้ขายมักเคยเจอประสบการณ์ไม่ชัดเจนจากที่อื่นมาแล้ว สิ่งที่ทำให้แตกต่างจริงคือการมีโครงสร้างข้อมูลที่ช่วยให้ผู้อ่านเห็นว่า BuyHub อธิบายวิธีทำงานชัด มีหน้าเงื่อนไข มีนโยบายความเป็นส่วนตัว มีคู่มือ มีขั้นตอน และมีหน้ารวมรีวิวกับผลงานที่อธิบายได้ว่าใช้อย่างไร ความโปร่งใสในบริบทนี้ไม่ใช่แค่การพูดว่าซื้อขายตามจริง แต่คือการทำให้ลูกค้าเห็นว่าก่อนจะถามราคา เขาจะรู้ก่อนว่ามีอะไรต้องเตรียมและอะไรมีผลต่อการตัดสินใจบ้าง',
      'ในทางกลับกัน เมื่อโครงสร้างเว็บพาผู้ใช้ไปสู่ความเข้าใจทีละขั้น ความไว้วางใจก็จะเกิดจากประสบการณ์สะสม ไม่ใช่จากคำสัญญาลอย ๆ นี่คือเหตุผลที่หน้ารู้จักเราไม่ควรพูดเพียงเรื่องวิสัยทัศน์ของแบรนด์ แต่ควรเชื่อมให้เห็นว่าทำไม BuyHub ถึงให้ความสำคัญกับเนื้อหาคู่มือ รีวิว FAQ และหน้าจังหวัดในภาคอีสาน เพราะทั้งหมดนี้สะท้อนวิธีคิดเดียวกัน คือช่วยให้คนขายใช้ข้อมูลจริงประกอบการตัดสินใจอย่างมั่นใจ'
    ]
  },
  {
