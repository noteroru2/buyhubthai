---
import InfoPage from '../components/InfoPage.astro';
import { PARENT_ORG_NAME, PARENT_ORG_URL } from '../lib/constants';
---
<InfoPage path="/เกี่ยวกับเรา" title="เกี่ยวกับ BuyHub ช่องทางรับซื้อสินค้าไอทีมือสอง" heading="BuyHub ขายไอทีง่าย รู้ราคาก่อนตัดสินใจ" description="รู้จัก BuyHub แบรนด์บริการรับซื้อสินค้าไอทีในเครืออำพล เทรดดิ้ง พร้อมหลักการประเมิน ขั้นตอนขาย และข้อมูลผู้ดำเนินการ">
  <div class="bh-two-columns"><section><h2>อีกช่องทางสำหรับคนอยากขายไอที</h2><p>BuyHub เป็นแบรนด์บริการรับซื้อสินค้าไอทีในเครือ {PARENT_ORG_NAME} เรารวมข้อมูลสำหรับผู้ขายเครื่องส่วนตัว ร้านค้า และบริษัท ตั้งแต่เลือกหมวดสินค้า เตรียมรูปเช็กราคา จนถึงตกลงวิธีส่งมอบ</p><p>คุณเริ่มจากการส่งรูปได้ โดยยังไม่ต้องเดินทางหรือส่งสินค้ามาก่อน ทีมงานพิจารณารุ่น สเปก สภาพ และอุปกรณ์ที่มี แล้วแจ้งราคาเบื้องต้นให้คุณตัดสินใจ</p><a class="bh-text-link" href={PARENT_ORG_URL}>ข้อมูลอำพล เทรดดิ้ง ผู้ดำเนินการ ↗</a></section><section class="bh-checklist-card"><h2>หลักการทำรายการ</h2><ul class="bh-check-list"><li>ประเมินเบื้องต้นฟรีจากข้อมูลสินค้า</li><li>อธิบายรายละเอียดก่อนนัดหมาย</li><li>ตรวจสภาพจริงและยืนยันราคาก่อนตกลง</li><li>แจ้งวิธีชำระเงินและส่งมอบให้ตรงกัน</li><li>ลูกค้าสามารถสอบถามก่อนตัดสินใจขาย</li></ul></section></div>
  <section><h2>มีผู้ดำเนินการและสถานที่ติดต่อชัดเจน</h2><p>หน้าร้านหลักของอำพล เทรดดิ้งอยู่ที่ 740/8 ถนนชยางกูร ตำบลในเมือง อำเภอเมืองอุบลราชธานี อุบลราชธานี 34000 ส่วนบริการต่างจังหวัดต้องตรวจสอบพื้นที่และคิวงานก่อนนัดหมาย การมีหน้าข้อมูลจังหวัดไม่ได้หมายถึงมีสาขาในจังหวัดนั้น</p><div class="bh-link-list"><a href="/ติดต่อเรา">ช่องทางติดต่อและแผนที่ ↗</a><a href="/ขั้นตอนการขาย">ขั้นตอนขายสินค้า ↗</a><a href="/รับซื้อ">เลือกหมวดสินค้าที่รับซื้อ ↗</a><a href="/พื้นที่ให้บริการ">ตรวจสอบพื้นที่ให้บริการ ↗</a></div></section>
</InfoPage>
