    ],
    links: [
      { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'คู่มือเตรียมสินค้าก่อนขาย' },
      { href: '/บทความ/ขาย-iphone-ต้องออก-icloud-ไหม', label: 'ขาย iPhone ต้องออก iCloud ไหม' },
      { href: '/บทความ/ขาย-macbook-ต้องออก-apple-id-ไหม', label: 'ขาย MacBook ต้องออก Apple ID ไหม' },
      { href: '/บทความ/ขายโน๊ตบุ๊คต้องล้างข้อมูลไหม', label: 'ขายโน๊ตบุ๊คต้องล้างข้อมูลไหม' }
    ]
  },
  {
    heading: 'เครื่องมีตำหนิ เครื่องเสีย หรือไม่มีอุปกรณ์ ยังควรถามประเมินไหม',
    paragraphs: [
      'คำตอบสั้นคือควรถามได้ เพราะหลายเคสยังประเมินได้แม้เครื่องจะไม่สมบูรณ์ จุดสำคัญอยู่ที่การแจ้งข้อมูลตามจริง เช่น ถ้าจอมีรอย แบตเสื่อม พอร์ตมีปัญหา หรือเคยซ่อม ควรบอกพร้อมรูปประกอบ ไม่ควรรอให้ทีมงานถามเอง เพราะยิ่งข้อมูลชัดตั้งแต่ต้น การประเมินก็ยิ่งใกล้เคียงสภาพจริงมากขึ้น',
      'ในกรณีไม่มีอุปกรณ์ในชุดก็ยังสามารถประเมินได้ เพียงแต่ควรแจ้งให้ครบว่ามีหรือไม่มีอะไรบ้าง เช่น ไม่มีกล่อง ไม่มีสาย หรือไม่มีหัวชาร์จ การพูดตรงแบบนี้ไม่ได้ทำให้เสียโอกาสขาย แต่ช่วยให้คำตอบที่ได้ใช้งานได้จริงมากกว่า ซึ่งเป็นหัวใจของคอนเทนต์เชิง AEO และช่วยสร้างความไว้ใจระหว่างคนขายกับทีมงาน'
