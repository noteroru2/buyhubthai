    },
    {
      question: 'ขายได้ทั้งชิ้นเดียวและจำนวนมากไหม?',
      answer: 'ได้ ทั้งลูกค้าทั่วไปและงานบริษัท/สำนักงาน/หน่วยงาน สามารถส่งรูปหรือส่งรายการคร่าว ๆ เพื่อประเมินเป็นก้อนได้'
    }
  ],
  data: [
    {
      question: 'ก่อนขาย iPhone/iPad ต้องออก iCloud ไหม?',
      answer:
        'ควรออกจาก Apple ID / iCloud ก่อนส่งมอบทุกครั้ง เพื่อความปลอดภัยและให้เครื่องพร้อมใช้งานสำหรับผู้ซื้อรายถัดไป หากไม่แน่ใจสามารถทักทีมงานให้ช่วยเช็คขั้นตอนได้'
    },
    {
      question: 'ก่อนขาย MacBook ต้องทำอะไรเรื่องข้อมูลส่วนตัว?',
      answer:
        'แนะนำสำรองข้อมูล ออกจาก Apple ID และบริการที่ผูกไว้ แล้วล้างข้อมูล/รีเซ็ตระบบตามขั้นตอนที่เหมาะสม เพื่อป้องกันข้อมูลส่วนตัวหลุด'
    },
    {
      question: 'ขายมือถือ Android ต้องออกบัญชี Google ไหม?',
      answer:
        'ควรออกจากบัญชี Google และรีเซ็ตเครื่องตามขั้นตอน เพื่อหลีกเลี่ยงการติดล็อก FRP และช่วยให้การส่งมอบทำได้ราบรื่น'
    }
  ],
  damaged: [
    {
      question: 'รับซื้อเครื่องเสียไหม?',
      answer:
        'ส่วนใหญ่รับประเมินได้ ขึ้นกับอาการเสียและความคุ้มค่าในการรับซื้อ แนะนำแจ้งอาการตามจริงและส่งรูปตำหนิเพื่อได้แนวราคาที่ใกล้เคียง'
    },
    {
      question: 'ไม่มีประกันยังขายได้ไหม?',
      answer: 'ขายได้ ประกันคงเหลือเป็นเพียงหนึ่งในปัจจัยของราคา ทีมงานประเมินจากรุ่น สเปก สภาพ และราคาตลาดมือสองในช่วงนั้น'
