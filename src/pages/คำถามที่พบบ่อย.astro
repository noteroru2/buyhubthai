---
import InfoPage from '../components/InfoPage.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { faqPageJsonLd } from '../lib/schema';
const faqs = [
  { question: 'ประเมินราคาฟรีหรือไม่?', answer: 'ประเมินเบื้องต้นจากรูปและข้อมูลสินค้าฟรีผ่าน LINE @buyhub คุณยังไม่ต้องส่งสินค้ามาก่อนทราบแนวราคา' },
  { question: 'รับสินค้าเสียหรือมีตำหนิไหม?', answer: 'ส่งรูปและอาการให้พิจารณาได้ การรับซื้อขึ้นอยู่กับรุ่น สเปก อาการ และมูลค่าคงเหลือ โปรดแจ้งความเสียหายหรือประวัติซ่อมที่ทราบให้ครบ' },
  { question: 'ราคาเปลี่ยนหลังตรวจได้หรือไม่?', answer: 'ราคาจากรูปเป็นเบื้องต้น หากตรวจพบสภาพหรือรายละเอียดต่างจากที่แจ้ง อาจมีการปรับราคาโดยแจ้งให้คุณพิจารณาก่อนทำรายการ' },
  { question: 'ไม่มีที่ชาร์จหรือกล่องขายได้ไหม?', answer: 'แจ้งรายการอุปกรณ์ที่มีให้ทีมงานพิจารณาได้ ความครบของอุปกรณ์อาจมีผลต่อราคาและการทดสอบเครื่อง' },
  { question: 'รับถึงบ้านทุกจังหวัดหรือไม่?', answer: 'ต้องตรวจสอบพื้นที่ คิวงาน จำนวน และมูลค่าสินค้าก่อนนัดหมาย ไม่มีการยืนยันรับถึงที่จากชื่อจังหวัดบนเว็บไซต์เพียงอย่างเดียว' },
  { question: 'ขายหลายเครื่องต้องเตรียมอะไร?', answer: 'เตรียมรายการรุ่น สเปก จำนวน สภาพ อุปกรณ์ พื้นที่เก็บ และผู้ประสานงาน หากเป็นทรัพย์สินองค์กรต้องมีผู้มีอำนาจอนุญาตให้ขายและจัดการข้อมูลก่อนส่งมอบ' },
  { question: 'ต้องส่งรหัสผ่านให้ทีมงานไหม?', answer: 'ไม่ต้องส่งรหัสผ่านหรือ OTP เพื่อประเมินจากรูป ให้เจ้าของบัญชีจัดการออกจากบัญชีและปลดการผูกเครื่องด้วยตนเองก่อนส่งมอบ' }
];
---
<InfoPage path="/คำถามที่พบบ่อย" title="คำถามที่พบบ่อยก่อนขายไอทีให้ BuyHub" heading="คำถามก่อนเริ่มขาย" description="คำตอบเรื่องการประเมินราคา สินค้ามีตำหนิ อุปกรณ์ไม่ครบ การนัดรับ และการขายไอทีหลายเครื่อง" jsonLd={[faqPageJsonLd(faqs)]}>
<FaqAccordion items={faqs}/>
</InfoPage>
