const flatFaqs = Object.values(faqs).flat();

const editorialSignals = {
  scope:
    'หน้าคำถามที่พบบ่อยรวบรวมคำตอบสั้นที่คนขายถามซ้ำบ่อยที่สุด ครอบคลุมราคา ขั้นตอน การล้างข้อมูล สินค้ามีตำหนิ และการขายจากต่างจังหวัด',
  about: ['FAQ การขายสินค้า IT มือสอง', 'คำถามเรื่องราคาและขั้นตอน', 'คำตอบเรื่องล้างข้อมูลก่อนขาย'],
  notes: [
    'เหมาะสำหรับคนที่ยังไม่อยากอ่านคู่มือยาวทั้งหน้า แต่ต้องการคำตอบเร็วว่าเรื่องไหนควรทำก่อนหลัง',
    'คำตอบในหน้านี้เชื่อมต่อไปยังหน้าคู่มือ ขั้นตอนการขาย และหน้าติดต่อ เพื่อให้ขยับต่อจากคำตอบสั้นไปสู่การลงมือทำจริงได้',
    'หากคำถามของคุณผูกกับรุ่นหรืออาการเฉพาะเครื่อง ควรส่งรูปและข้อมูลจริงเพื่อให้ทีมงานตอบได้แม่นกว่าคำตอบภาพรวม'
  ],
  links: [
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขาย' },
    { href: '/คู่มือเตรียมสินค้าก่อนขาย', label: 'ดูคู่มือเตรียมสินค้าก่อนขาย' },
    { href: '/ติดต่อเรา', label: 'ดูช่องทางติดต่อ' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd(breadcrumbs),
  webPageJsonLd({
    name: title,
    description,
    url: '/คำถามที่พบบ่อย',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  faqPageJsonLd(flatFaqs)
];

