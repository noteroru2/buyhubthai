---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LongformSections from '../components/LongformSections.astro';
import { breadcrumbJsonLd, faqPageJsonLd, webPageJsonLd } from '../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER, LINE_AT } from '../lib/constants';

const title = 'คำถามที่พบบ่อยเกี่ยวกับการขายสินค้า IT มือสองกับ BuyHub';
const description =
  `รวมคำถามที่พบบ่อยเกี่ยวกับการขายสินค้าไอทีมือสองกับ BuyHub เช่น การประเมินราคา ขั้นตอนการขาย การล้างข้อมูล และพื้นที่ให้บริการภาคอีสาน ติดต่อ LINE ${LINE_AT} เพื่อประเมินราคาฟรี`;

const breadcrumbs = [
  { name: 'หน้าแรก', href: '/' },
  { name: 'คำถามที่พบบ่อย', href: '/คำถามที่พบบ่อย' }
];

const faqs = {
  pricing: [
    {
      question: 'ประเมินราคาฟรีไหม?',
      answer: 'ฟรี ทีมงานประเมินราคาเบื้องต้นจากรูปและข้อมูลที่คุณส่งมาใน LINE @buyhub โดยไม่มีค่าใช้จ่าย'
    },
    {
      question: 'ต้องส่งข้อมูลอะไรเพื่อประเมินราคาให้แม่นขึ้น?',
      answer:
        'แนะนำส่งรูปชัดหลายมุม + รุ่น/ความจุ/สเปก + ตำหนิ/สภาพการใช้งาน + สุขภาพแบต (ถ้าดูได้) + อุปกรณ์ที่มี (กล่อง/สาย/หัวชาร์จ) และจังหวัด'
    },
    {
      question: 'ราคาประเมินกับราคาจริงต่างกันไหม?',
      answer:
        'ราคาประเมินเป็นแนวทางจากรูปและข้อมูลที่ได้รับ ราคาจริงจะคอนเฟิร์มหลังตรวจสภาพจริง หากสภาพตรงตามที่แจ้ง ราคามักใกล้เคียงเดิม และทีมงานจะแจ้งเหตุผลหากต้องปรับราคา'
    }
  ],
  process: [
    {
      question: 'ขั้นตอนการขายกับ BuyHub มีอะไรบ้าง?',
      answer: 'โดยทั่วไปมี 4 ขั้นตอน: ส่งรูปสินค้า → ประเมินราคา → ตกลงราคา → ตรวจสอบสินค้าและรับเงิน'
    },
    {
      question: 'ตกลงราคาแล้ว ได้รับเงินเมื่อไหร่?',
