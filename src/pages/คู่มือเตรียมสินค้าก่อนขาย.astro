---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineCtaButton from '../components/LineCtaButton.astro';
import PhoneCtaButton from '../components/PhoneCtaButton.astro';
import CtaBand from '../components/CtaBand.astro';
import EditorialTrustPanel from '../components/EditorialTrustPanel.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LongformSections from '../components/LongformSections.astro';
import { breadcrumbJsonLd, faqPageJsonLd, webPageJsonLd } from '../lib/schema';
import { EDITORIAL_REVIEWED_AT, EDITORIAL_REVIEWER } from '../lib/constants';

const title = 'คู่มือเตรียมสินค้า IT ก่อนขายกับ BuyHub';
const description =
  'วิธีเตรียมโน๊ตบุ๊ค มือถือ MacBook iPhone iPad และสินค้า IT ก่อนขาย สำรองข้อมูล ล้างข้อมูล ออกจากบัญชี และส่งรูปเพื่อประเมินราคา';

const faqs = [
  {
    q: 'ยังไม่อยากล้างข้อมูล ส่งมาประเมินได้ไหม',
    a: 'ได้ ส่งรูปและข้อมูลเพื่อประเมินเบื้องต้นได้ก่อน แต่ก่อนส่งมอบควรสำรองและลบข้อมูลส่วนตัว รวมถึงออกจากบัญชีที่ผูกไว้ เพื่อความปลอดภัย'
  },
  {
    q: 'ต้องออก iCloud/Apple ID ทุกครั้งไหม',
    a: 'ควรออกทุกครั้งและปิด Find My ก่อนลบข้อมูล เพื่อหลีกเลี่ยง Activation Lock และทำให้ส่งมอบจบง่าย'
  },
  {
    q: 'โน๊ตบุ๊ค Windows ควรรีเซ็ตแบบไหน',
    a: 'ควรสำรองไฟล์ ออกจากบัญชีที่ล็อกอิน แล้วรีเซ็ต/ติดตั้งใหม่ให้ลบข้อมูลออก และตรวจว่าไม่มีโปรไฟล์ผู้ใช้เดิมค้างอยู่ก่อนส่งมอบ'
  },
  {
    q: 'ของที่ควรส่งรูปคืออะไรบ้าง',
    a: 'รูปหน้า/หลัง/ขอบ + รูปตำหนิ, รูปรุ่น/สเปก, รูปอุปกรณ์ในชุด (กล่อง/สาย/หัวชาร์จ) และแจ้งจังหวัด/พื้นที่'
  },
  {
    q: 'ถ้าเป็นสินค้าบริษัท/หน่วยงานควรทำยังไง',
    a: 'แนะนำทำรายการรุ่น/สเปก/จำนวน และทำ Data wipe ตามนโยบายองค์กรก่อนส่งมอบ เพื่อความปลอดภัยของข้อมูล'
  }
];

const editorialSignals = {
  scope:
    'หน้าคู่มือเตรียมสินค้าก่อนขายช่วยให้คนขายสำรองข้อมูล ออกจากบัญชี เช็กรายการอุปกรณ์ และส่งรูปประเมินได้ครบก่อนนัดขายจริง',
  about: ['เตรียมสินค้า IT ก่อนขาย', 'ล้างข้อมูลก่อนขาย', 'ออกจากบัญชีบนอุปกรณ์'],
  notes: [
    'เหมาะสำหรับคนที่กังวลเรื่องข้อมูลส่วนตัวหรือกลัวลืมขั้นตอนเล็ก ๆ ที่มีผลต่อการส่งมอบ',
    'แต่ละแพลตฟอร์มมีจุดต้องเช็กต่างกัน เช่น Apple, Android, Windows และอุปกรณ์ขององค์กร',
    'หากยังไม่แน่ใจว่าต้องเริ่มจากการล้างข้อมูลหรือส่งรูปก่อน ให้อ่านหน้านี้คู่กับขั้นตอนการขายเพื่อเห็นลำดับงานทั้งหมด'
  ],
  links: [
    { href: '/ขั้นตอนการขาย', label: 'ดูขั้นตอนการขาย' },
    { href: '/ติดต่อเรา', label: 'ดูช่องทางติดต่อ' },
    { href: '/คำถามที่พบบ่อย', label: 'ดูคำถามที่พบบ่อย' }
  ]
} as const;

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'หน้าแรก', href: '/' },
    { name: 'คู่มือเตรียมสินค้าก่อนขาย', href: '/คู่มือเตรียมสินค้าก่อนขาย' }
  ]),
  webPageJsonLd({
    name: title,
    description,
    url: '/คู่มือเตรียมสินค้าก่อนขาย',
    dateModified: EDITORIAL_REVIEWED_AT,
    about: [...editorialSignals.about],
    author: EDITORIAL_REVIEWER
  }),
  faqPageJsonLd(faqs.map((f) => ({ question: f.q, answer: f.a })))
];

const prepGuideSections = [
  {
    heading: 'ทำไมการเตรียมสินค้า IT ก่อนขายจึงสำคัญกว่าที่หลายคนคิด',
    paragraphs: [
      'การเตรียมเครื่องก่อนขายไม่ได้มีผลแค่เรื่องความเรียบร้อย แต่มีผลต่อทั้งความเร็วในการประเมิน ความปลอดภัยของข้อมูล และความแม่นของราคาที่ได้รับด้วย ถ้าคนขายส่งรูปโดยยังไม่รู้ว่าควรเตรียมอะไรบ้าง มักเกิดปัญหาตามมาหลายอย่าง เช่น ลืมเช็กอุปกรณ์ในชุด แจ้งรุ่นไม่ครบ หรือยังออกจากบัญชีไม่เรียบร้อย พอถึงเวลาส่งมอบจริงจึงต้องย้อนกลับไปทำขั้นตอนเดิมใหม่ ทำให้งานล่าช้าและกังวลมากกว่าที่ควร',
