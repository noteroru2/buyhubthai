{
  "name": "buyhubthai",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "images:og": "node scripts/generate-og-images.mjs",
    "check:wordcount": "node scripts/check-public-word-count.mjs",
    "check:blog-unique": "node scripts/check-blog-uniqueness.mjs",
    "check:page-unique": "node scripts/check-page-cluster-uniqueness.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:seo": "node scripts/check-seo-head.mjs",
    "qa": "npm run build && npm run check:wordcount && npm run check:blog-unique && npm run check:page-unique && npm run check:links && npm run check:seo",
    "qa:recovery": "npm run qa && node scripts/qa-recovery-v1.mjs && npm run check:rebuild",
    "preview": "astro preview",
    "astro": "astro",
    "check:rebuild": "node scripts/check-rebuild.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  }
}
